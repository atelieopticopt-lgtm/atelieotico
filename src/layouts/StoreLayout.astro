---
import AuthGate from '../components/AuthGate.astro';
import Icon from '../components/Icon.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import ChatButton from '../components/ChatButton.astro';
import CookieBanner from '../components/CookieBanner.astro';

const {
  title = 'Ateliê Ótico — Design de Autor & Precisão Ótica na Madeira',
  description = 'Curadoria independente de armações óticas e óculos de sol no Funchal, Madeira.',
  hideHeader = false,
  hideTopbar = false,
  hideFooter = false
} = Astro.props;
const isCustomerAccountPage = Astro.url.pathname.startsWith('/conta');
---
<!doctype html>
<html lang="pt-PT">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>{title}</title>
  <meta name="description" content={description}/>
  <link rel="icon" type="image/svg+xml" href="/SVG-Logo-Atelie.svg"/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/store.css"/>
  <link rel="stylesheet" href="/pages.css"/>
  <link rel="stylesheet" href="/premium.css?v=20260820-2000"/>
</head>
<body>
{!isCustomerAccountPage && <AuthGate />}
<a class="skip" href="#main">Saltar para o conteúdo</a>

{!hideTopbar && (
  <aside class="topbar">
    <div class="marquee-track">
      <span class="topbar-text">PORTES GRATUITOS A PARTIR DE 100 €</span>
      <span class="topbar-text">CONSULTAS &amp; EXAMES DE OPTOMETRIA NO ATELIÊ</span>
      <span class="topbar-text">PORTES GRATUITOS A PARTIR DE 100 €</span>
      <span class="topbar-text">CONSULTAS &amp; EXAMES DE OPTOMETRIA NO ATELIÊ</span>
    </div>
  </aside>
)}

{!hideHeader && (
  <header class="site-header">
    <a class="brand" href="/" aria-label="Ateliê Ótico Início">
      <img src="/SVG-Logo-Atelie.svg" alt="Ateliê Ótico" style="height: 40px; width: auto; object-fit: contain;" />
    </a>
    <button class="mobile-menu" aria-label="Abrir navegação" aria-expanded="false"><Icon name="menu"/></button>
    <nav id="main-nav" aria-label="Navegação Principal">
      
      {/* 1. CAMPANHAS MEGA MENU */}
      <div class="nav-drop">
        <a href="/catalogo" class="nav-campanhas-link">
          <span>CAMPANHAS</span>
          <svg class="nav-chevron" width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </a>
        <div class="mega-melin">
          <div class="mega-melin-inner">
            <div class="mega-melin-grid">
              <a href="/catalogo" class="mega-melin-item">
                <div class="mega-melin-img-wrap">
                  <img src="/campagna-hero.jpeg" alt="Campanha Hero 2026" />
                </div>
                <span class="mega-melin-label">CAMPANHA HERO 2026</span>
              </a>
              <a href="/catalogo" class="mega-melin-item">
                <div class="mega-melin-img-wrap">
                  <img src="/campagna-signature.jpeg" alt="Coleção Signature" />
                </div>
                <span class="mega-melin-label">COLEÇÃO SIGNATURE</span>
              </a>
              <a href="/marcas" class="mega-melin-item">
                <div class="mega-melin-img-wrap">
                  <img src="/story-butterfly.jpeg" alt="SNOB Milano" />
                </div>
                <span class="mega-melin-label">SNOB MILANO</span>
              </a>
              <a href="/catalogo" class="mega-melin-item">
                <div class="mega-melin-img-wrap">
                  <img src="/story-anteo.jpeg" alt="Linhas de Autor" />
                </div>
                <span class="mega-melin-label">LINHAS DE AUTOR</span>
              </a>
              <a href="/contactos" class="mega-melin-item">
                <div class="mega-melin-img-wrap">
                  <img src="/campagna-prefooter.jpeg" alt="Consulta Individual" />
                </div>
                <span class="mega-melin-label">CONSULTA INDIVIDUAL</span>
              </a>
            </div>
            <div class="mega-melin-footer">
              <a href="/catalogo" class="mega-melin-btn">EXPLORAR TODAS AS CAMPANHAS</a>
            </div>
          </div>
        </div>
      </div>

      {/* 2. ÓCULOS MEGA MENU */}
      <div class="nav-drop">
        <a href="/catalogo">
          <span>ÓCULOS</span>
          <svg class="nav-chevron" width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </a>
        <div class="mega-melin">
          <div class="mega-melin-inner">
            <div class="mega-melin-grid">
              <a href="/catalogo?categoria=Arma%C3%A7%C3%B5es+%C3%B3ticas" class="mega-melin-item">
                <div class="mega-melin-img-wrap">
                  <img src="/1-1.jpeg" alt="Armações Óticas" />
                </div>
                <span class="mega-melin-label">ARMAÇÕES ÓTICAS</span>
              </a>
              <a href="/catalogo?categoria=%C3%93culos+de+sol" class="mega-melin-item">
                <div class="mega-melin-img-wrap">
                  <img src="/3-1.jpeg" alt="Óculos de Sol" />
                </div>
                <span class="mega-melin-label">ÓCULOS DE SOL</span>
              </a>
              <a href="/catalogo" class="mega-melin-item">
                <div class="mega-melin-img-wrap">
                  <img src="/5-1.jpeg" alt="Mais Populares" />
                </div>
                <span class="mega-melin-label">MAIS POPULARES</span>
              </a>
              <a href="/catalogo?material=Acetato" class="mega-melin-item">
                <div class="mega-melin-img-wrap">
                  <img src="/7-1.jpeg" alt="Acetato Italiano" />
                </div>
                <span class="mega-melin-label">ACETATO ITALIANO</span>
              </a>
              <a href="/sobre" class="mega-melin-item">
                <div class="mega-melin-img-wrap">
                  <img src="/story-case.jpeg" alt="Estojos & Acessórios" />
                </div>
                <span class="mega-melin-label">ESTOJOS &amp; ACESSÓRIOS</span>
              </a>
            </div>
            <div class="mega-melin-footer">
              <a href="/catalogo" class="mega-melin-btn">VER TODO O CATÁLOGO DE ÓCULOS</a>
            </div>
          </div>
        </div>
      </div>

      {/* 3. NOVIDADES MEGA MENU */}
      <div class="nav-drop">
        <a href="/catalogo">
          <span>NOVIDADES</span>
          <svg class="nav-chevron" width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </a>
        <div class="mega-melin">
          <div class="mega-melin-inner">
            <div class="mega-melin-grid">
              <a href="/catalogo" class="mega-melin-item">
                <div class="mega-melin-img-wrap">
                  <img src="/2-1.jpeg" alt="Lançamentos 2026" />
                </div>
                <span class="mega-melin-label">LANÇAMENTOS 2026</span>
              </a>
              <a href="/catalogo" class="mega-melin-item">
                <div class="mega-melin-img-wrap">
                  <img src="/4-1.jpeg" alt="Série Limitada" />
                </div>
                <span class="mega-melin-label">SÉRIE LIMITADA</span>
              </a>
              <a href="/catalogo?material=Tit%C3%A2nio" class="mega-melin-item">
                <div class="mega-melin-img-wrap">
                  <img src="/6-1.jpeg" alt="Titânio Cirúrgico" />
                </div>
                <span class="mega-melin-label">TITÂNIO CIRÚRGICO</span>
              </a>
              <a href="/catalogo" class="mega-melin-item">
                <div class="mega-melin-img-wrap">
                  <img src="/8-1.jpeg" alt="Design Minimalista" />
                </div>
                <span class="mega-melin-label">DESIGN MINIMALISTA</span>
              </a>
              <a href="/catalogo" class="mega-melin-item">
                <div class="mega-melin-img-wrap">
                  <img src="/specs-packaging.jpeg" alt="Edições Especiais" />
                </div>
                <span class="mega-melin-label">EDIÇÕES ESPECIAIS</span>
              </a>
            </div>
            <div class="mega-melin-footer">
              <a href="/catalogo" class="mega-melin-btn">EXPLORAR NOVIDADES</a>
            </div>
          </div>
        </div>
      </div>

      {/* 4. MARCAS MEGA MENU */}
      <div class="nav-drop">
        <a href="/marcas">MARCAS</a>
        <div class="mega-melin">
          <div class="mega-melin-inner">
            <div class="mega-melin-grid brands-grid">
              <a href="/catalogo?marca=SNOB+Milano" class="mega-melin-item">
                <div class="mega-melin-img-wrap">
                  <img src="/partner-snob.jpeg" alt="SNOB Milano" style="mix-blend-mode: multiply; transform: scale(1.6);" />
                </div>
                <span class="mega-melin-label">SNOB MILANO</span>
              </a>
              <a href="/catalogo?marca=%C3%98rgreen+Optics" class="mega-melin-item">
                <div class="mega-melin-img-wrap">
                  <img src="/partner-orgreen.svg" alt="Ørgreen Optics" class="orgreen-wordmark" />
                </div>
                <span class="mega-melin-label">ØRGREEN OPTICS</span>
              </a>
              <a href="/catalogo?marca=Einstoffen" class="mega-melin-item">
                <div class="mega-melin-img-wrap">
                  <img src="/partner-einstoffen.png" alt="Einstoffen" style="mix-blend-mode: multiply; transform: scale(1.35);" />
                </div>
                <span class="mega-melin-label">EINSTOFFEN</span>
              </a>
              <a href="/catalogo?marca=Rodenstock" class="mega-melin-item">
                <div class="mega-melin-img-wrap">
                  <img src="/partner-rodenstock.png" alt="Rodenstock" style="mix-blend-mode: multiply; transform: scale(1.2);" />
                </div>
                <span class="mega-melin-label">RODENSTOCK</span>
              </a>
              <a href="/catalogo?marca=Eyepetizer" class="mega-melin-item">
                <div class="mega-melin-img-wrap">
                  <img src="/partners/eyepetizer.png" alt="Eyepetizer" style="filter: grayscale(1);" />
                </div>
                <span class="mega-melin-label">EYEPETIZER</span>
              </a>
              <a href="/catalogo?marca=Longchamp" class="mega-melin-item">
                <div class="mega-melin-img-wrap">
                  <img src="/partners/longchamp.svg" alt="Longchamp" style="filter: grayscale(1);" />
                </div>
                <span class="mega-melin-label">LONGCHAMP</span>
              </a>
              <a href="/catalogo?marca=Maison+Bensimon" class="mega-melin-item">
                <div class="mega-melin-img-wrap">
                  <img src="/partners/maison-bensimon.jpeg" alt="Maison Bensimon" style="filter: grayscale(1);" />
                </div>
                <span class="mega-melin-label">MAISON BENSIMON</span>
              </a>
            </div>
            <div class="mega-melin-footer">
              <a href="/marcas" class="mega-melin-btn" data-i18n-pt="CONHECER TODAS AS MARCAS" data-i18n-en="DISCOVER ALL BRANDS">CONHECER TODAS AS MARCAS</a>
            </div>
          </div>
        </div>
      </div>

      <a href="/sobre">O ATELIÊ</a>
      <a href="/contactos">CONTACTOS</a>
    </nav>
    <div class="header-actions" style="display: flex; align-items: center; gap: 12px;">
      <LanguageSwitcher />
      <a class="icon-action" href="/pesquisa" aria-label="Pesquisar"><Icon name="search"/></a>
      <a class="icon-action" href="/conta" aria-label="Conta"><Icon name="user"/></a>
      <button class="cart-trigger icon-action" aria-label="Abrir saco">
        <Icon name="bag"/>
        <span class="cart-badge" data-cart-count="0" style="display: none;">0</span>
      </button>
    </div>
  </header>
  <div class="nav-backdrop-overlay" aria-hidden="true"></div>
)}

<main id="main">
  <slot />
</main>

<aside class="cart-drawer" aria-hidden="true">
  <div class="drawer-head">
    <h2 data-i18n-pt="O SEU CARRINHO" data-i18n-en="YOUR SHOPPING CART">O SEU CARRINHO</h2>
    <button class="cart-close" aria-label="Fechar carrinho">&times;</button>
  </div>
  <div data-cart-items></div>
  <div class="drawer-foot">
    <div>
      <span data-i18n-pt="TOTAL ESTIMADO" data-i18n-en="ESTIMATED TOTAL">TOTAL ESTIMADO</span>
      <strong data-cart-total>0 €</strong>
    </div>
    <a class="rect black btn-cart-checkout" href="/checkout" data-i18n-pt="FINALIZAR COMPRA" data-i18n-en="CHECKOUT">FINALIZAR COMPRA</a>
    <button type="button" class="btn-continue-shopping" data-close-cart data-i18n-pt="Continuar a Comprar" data-i18n-en="Continue Shopping">Continuar a Comprar</button>
  </div>
</aside>
<div class="drawer-overlay"></div>

{!hideFooter && (
  <footer class="ll-monolith-footer">
    <div class="ll-container">
      
      {/* Brand Central Identity */}
      <div class="ll-footer-top-brand">
        <img
          class="ll-footer-brand-logo"
          src="/SVG-Logo-Atelie.svg"
          alt="Ateliê Ótico — Funchal, Madeira"
        />
        <p class="ll-footer-tagline">
          Ótica independente na Madeira — Curadoria de autor e precisão ótica
        </p>
      </div>

      {/* Primary Navigation Row */}
      <nav class="ll-footer-nav-bar" aria-label="Navegação do Rodapé">
        <a href="/catalogo" class="ll-footer-link">Coleções</a>
        <a href="/catalogo?categoria=Arma%C3%A7%C3%B5es+%C3%B3ticas" class="ll-footer-link">Armações Óticas</a>
        <a href="/catalogo?categoria=%C3%93culos+de+sol" class="ll-footer-link">Óculos de Sol</a>
        <a href="/marcas" class="ll-footer-link">Manufaturas</a>
        <a href="/sobre" class="ll-footer-link">O Ateliê</a>
        <a href="/contactos" class="ll-footer-link">Contactos</a>
      </nav>

      {/* Google My Business, Address & Schedule Information */}
      <div class="ll-footer-gmb-section">
        <div class="ll-footer-gmb-grid">
          
          {/* Physical Address */}
          <div class="ll-footer-gmb-col">
            <h4>ESPAÇO &amp; LOCALIZAÇÃO</h4>
            <p><strong>Ateliê Ótico</strong></p>
            <p>Rua da Conceição, Praça do Carmo 29B<br/>9050-026 Funchal, Madeira</p>
            <a
              href="https://maps.google.com/?q=Rua+da+Concei%C3%A7%C3%A3o+Pra%C3%A7a+do+Carmo+29B+Funchal"
              target="_blank"
              rel="noopener noreferrer"
            >
              Abrir no Google Maps &rarr;
            </a>
          </div>

          {/* Direct Contact */}
          <div class="ll-footer-gmb-col">
            <h4>CONTACTO DIRETO</h4>
            <p>Atendimento e marcações personalizadas:</p>
            <p style="font-size: 15px; font-weight: 700; color: #0a0a0a;">964 993 767</p>
            <a href="https://wa.me/351964993767" target="_blank" rel="noopener noreferrer">
              Conversar no WhatsApp &rarr;
            </a>
          </div>

          {/* Operating Hours */}
          <div class="ll-footer-gmb-col">
            <h4>HORÁRIO DE FUNCIONAMENTO</h4>
            <div class="ll-hours-list">
              <div class="ll-hours-row">
                <span>Segunda a Sexta</span>
                <strong>09:00 – 19:00</strong>
              </div>
              <div class="ll-hours-row">
                <span>Sábado</span>
                <strong>09:00 – 13:00</strong>
              </div>
              <div class="ll-hours-row">
                <span>Domingo</span>
                <strong>Encerrado</strong>
              </div>
            </div>
          </div>

        </div>
      </div>

      {/* Centered Legal Links, Payment Methods and Copyright Row */}
      <div class="ll-footer-centered-legal">
        <div class="ll-payment-logos" aria-label="Métodos de pagamento seguros">
          <div class="payment-badge" title="MB WAY"><img src="/payment-methods/MBWay.svg" alt="MB WAY" /></div>
          <div class="payment-badge" title="Visa"><img src="/payment-methods/Visa.svg" alt="Visa" /></div>
          <div class="payment-badge" title="Mastercard"><img src="/payment-methods/MasterCard.svg" alt="Mastercard" /></div>
          <div class="payment-badge" title="PayPal"><img src="/payment-methods/PayPal.svg" alt="PayPal" /></div>
          <div class="payment-badge" title="Revolut"><img src="/payment-methods/Revolut.svg" alt="Revolut" /></div>
          <div class="payment-badge" title="Klarna"><img src="/payment-methods/klarna.svg" alt="Klarna" /></div>
        </div>

        <nav class="ll-legal-links-row" aria-label="Informações legais">
          <a href="/carreiras" data-i18n-pt="Carreiras" data-i18n-en="Careers">Carreiras</a>
          <span class="legal-dot">•</span>
          <a href="/condicoes-gerais-venda" data-i18n-pt="Condições Gerais de Venda" data-i18n-en="General Conditions of Sale">Condições Gerais de Venda</a>
          <span class="legal-dot">•</span>
          <a href="/termos">Termos e Condições</a>
          <span class="legal-dot">•</span>
          <a href="/privacidade">Privacidade</a>
          <span class="legal-dot">•</span>
          <button type="button" id="btn-open-cookie-settings" class="ll-footer-cookie-btn" data-i18n-pt="Definições de Cookies" data-i18n-en="Cookie Settings">Definições de Cookies</button>
          <span class="legal-dot">•</span>
          <a href="https://www.livroreclamacoes.pt" target="_blank" rel="noopener noreferrer">Livro de Reclamações</a>
        </nav>
        
        <p class="ll-copyright-centered">
          &copy; 2026 Ateliê Ótico — Todos os direitos reservados &bull; Madeira
        </p>
      </div>

    </div>
  </footer>
)}

<ChatButton />
<CookieBanner />

<script is:inline src="/store.js?v=20260821-v2"></script>
<script is:inline src="/atelie-cms.js?v=20260821-v2"></script>
<script is:inline src="/cookie-consent.js?v=20260821-v2"></script>
</body>
</html>
