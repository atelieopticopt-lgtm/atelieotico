---
import Icon from '../components/Icon.astro';
import AuthGate from '../components/AuthGate.astro';
import ChatButton from '../components/ChatButton.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';

const {
  title = 'Ateliê Ótico — Design de Autor & Precisão Ótica na Madeira',
  description = 'Ótica de autor independente no Funchal, Madeira. Curadoria internacional de armações de autor, lentes oftálmicas de alta precisão e atendimento personalizado.',
  hideFooter = false,
  hideHeader = false,
  hideTopbar = false
} = Astro.props;
---
<!doctype html>
<html lang="pt-PT">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <meta name="description" content={description}/>
  <title>{title}</title>
  
  <!-- SEO & Multi-language alternates -->
  <link rel="alternate" hreflang="pt-PT" href="https://atelieotico.com/" />
  <link rel="alternate" hreflang="en-US" href="https://atelieotico.com/?lang=en" />
  <link rel="alternate" hreflang="x-default" href="https://atelieotico.com/" />

  <!-- SSR Image Preloads for Instant Render -->
  <link rel="preload" as="image" href="/campagna-hero.jpeg" fetchpriority="high" />
  <link rel="preload" as="image" href="/SVG-Logo-Atelie.svg" />

  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/store.css"/>
  <link rel="stylesheet" href="/pages.css"/>
  <link rel="stylesheet" href="/premium.css"/>
</head>
<body>
<AuthGate />
<a class="skip" href="#main">Saltar para o conteúdo</a>

{!hideTopbar && (
  <div class="topbar">PORTES GRATUITOS A PARTIR DE 100 &euro;</div>
)}

{!hideHeader && (
  <header class="site-header">
    <button class="mobile-menu" aria-expanded="false" aria-controls="main-nav">MENU</button>
    <a class="brand" href="/" style="display: flex; align-items: center; text-decoration: none;">
      <img
        src="/SVG-Logo-Atelie.svg"
        alt="Ateliê Ótico"
        style="height: 48px; max-height: 52px; width: auto; object-fit: contain; display: block;"
      />
    </a>
    
    <nav id="main-nav">
      <div class="nav-drop">
        <a href="/catalogo">ÓCULOS</a>
      </div>
      <div class="nav-drop">
        <a href="/catalogo">NOVIDADES</a>
      </div>
      <a href="/marcas">MARCAS</a>
      <a href="/sobre">O ATELIÊ</a>
      <a href="/contactos">CONTACTOS</a>
    </nav>

    <div class="header-actions" style="display: flex; align-items: center; gap: 12px;">
      <LanguageSwitcher />
      <a class="icon-action" href="/pesquisa" aria-label="Pesquisar"><Icon name="search"/></a>
      <a class="icon-action" href="/sobre" aria-label="Conta"><Icon name="user"/></a>
      <button class="cart-trigger icon-action" aria-label="Abrir saco">
        <Icon name="bag"/>
        <span class="cart-badge" data-cart-count>0</span>
      </button>
    </div>
  </header>
)}

<main id="main">
  <slot/>
</main>

{!hideFooter && (
  <footer class="ll-monolith-footer">
    <div class="ll-container">
      
      {/* Brand Logo */}
      <div class="ll-footer-top-brand">
        <img
          src="/SVG-Logo-Atelie.svg"
          alt="Ateliê Ótico"
          style="height: 52px; max-height: 56px; width: auto; object-fit: contain; margin: 0 auto 12px; display: block;"
        />
        <p class="ll-footer-tagline">
          Ótica independente na Madeira — Curadoria de autor e precisão ótica
        </p>
      </div>

      {/* Navigation Links */}
      <nav class="ll-footer-nav-bar" aria-label="Navegação do rodapé">
        <a href="/catalogo" class="ll-footer-link">Coleções</a>
        <a href="/catalogo?categoria=Arma%C3%A7%C3%B5es%20%C3%B3ticas" class="ll-footer-link">Armações Óticas</a>
        <a href="/catalogo?categoria=%C3%93culos%20de%20sol" class="ll-footer-link">Óculos de Sol</a>
        <a href="/marcas" class="ll-footer-link">Manufaturas</a>
        <a href="/sobre" class="ll-footer-link">O Ateliê</a>
        <a href="/contactos" class="ll-footer-link">Contactos</a>
      </nav>

      {/* Google My Business Structured Info */}
      <div class="ll-footer-gmb-section">
        <div class="ll-footer-gmb-grid">
          
          <div class="ll-footer-gmb-col">
            <h4>Espaço &amp; Localização</h4>
            <p><strong>Ateliê Ótico</strong></p>
            <p>Rua da Conceição, Praça do Carmo 29B<br/>9050-026 Funchal, Madeira</p>
            <p style="margin-top: 8px;">
              <a
                href="https://www.google.com/maps/place//data=!4m2!3m1!1s0xc606182e736d2af:0xb3c8b9f9e8a35640"
                target="_blank"
                rel="noopener noreferrer"
              >
                Abrir no Google Maps &rarr;
              </a>
            </p>
          </div>

          <div class="ll-footer-gmb-col">
            <h4>Contacto Direto</h4>
            <p>Atendimento e marcações personalizadas:</p>
            <p style="font-size: 16px; font-weight: 700; color: #000000;">
              <a href="tel:+351964993767" style="text-decoration: none; color: inherit;">
                964 993 767
              </a>
            </p>
            <p style="margin-top: 8px;">
              <a href="https://wa.me/351964993767?text=Ol%C3%A1%2C%20gostaria%20de%20informa%C3%A7%C3%B5es%20sobre%20o%20Ateli%C3%AA%20%C3%93tico." target="_blank" rel="noopener noreferrer">
                Conversar no WhatsApp &rarr;
              </a>
            </p>
          </div>

          <div class="ll-footer-gmb-col">
            <h4>Horário de Funcionamento</h4>
            <div class="ll-hours-list">
              <div class="ll-hours-row">
                <span>Segunda a Sexta</span>
                <strong>09:00 – 19:00</strong>
              </div>
              <div class="ll-hours-row">
                <span>Sábado</span>
                <strong>09:00 – 13:00</strong>
              </div>
              <div class="ll-hours-row">
                <span>Domingo</span>
                <strong style="color: #999999;">Encerrado</strong>
              </div>
            </div>
          </div>

        </div>
      </div>

      {/* Centered Legal Links and Copyright Row */}
      <div class="ll-footer-centered-legal">
        <nav class="ll-legal-links-row" aria-label="Informações legais">
          <a href="/termos">Termos e Condições</a>
          <span class="legal-dot">•</span>
          <a href="/privacidade">Privacidade</a>
          <span class="legal-dot">•</span>
          <a href="/cookies">Cookies</a>
          <span class="legal-dot">•</span>
          <a href="/envios">Envios</a>
          <span class="legal-dot">•</span>
          <a href="/contactos">Apoio ao Cliente</a>
        </nav>

        <p class="ll-copyright-centered">
          &copy; {new Date().getFullYear()} Ateliê Ótico — Todos os direitos reservados &bull; Madeira
        </p>
      </div>

    </div>
  </footer>
)}

<aside class="cart-drawer" aria-hidden="true">
  <div class="drawer-head">
    <h2>O seu saco</h2>
    <button class="cart-close" aria-label="Fechar saco">✕</button>
  </div>
  <div data-cart-items></div>
  <div class="drawer-foot">
    <div>
      <span>Subtotal</span>
      <strong data-cart-total>0 &euro;</strong>
    </div>
    <a href="/saco" class="rect black">VER SACO</a>
  </div>
</aside>
<div class="drawer-overlay"></div>

<!-- Luxury Floating WhatsApp Button with Exact SVG -->
<ChatButton />

<script is:inline src="/store.js"></script>
</body>
</html>
