    ['Cat-eye', 'Cat-eye'],
    ['Oval', 'Oval'],
    ['“A forma segue o olhar. Cada detalhe é desenhado com propósito e precisão.”', '“Form follows the gaze. Every detail is designed with purpose and precision.”'],
    ['“Óculos de autor com matérias nobres e fabrico independente.”', '“Signature eyewear crafted independently from noble materials.”'],
    ['HISTÓRIAS & ARQUIVO / DIÁRIO VISUAL', 'STORIES & ARCHIVE / VISUAL JOURNAL'],
    ['Estojos em Couro Vegetal', 'Vegetable-Tanned Leather Cases'],
    ['Acessórios de proteção manufaturados com acabamento artesanal.', 'Protective accessories made with an artisanal finish.'],
    ['A Geometria do Rosto', 'The Geometry of the Face'],
    ['Como encontrar as proporções ideais para a sua estrutura facial.', 'How to find the ideal proportions for your facial structure.'],
    ['Embalagens de Colecionador', 'Collector Packaging'],
    ['Cada armação inclui certificado de autenticidade e garantia.', 'Every frame includes a certificate of authenticity and warranty.'],
    ['ATENDIMENTO EXCLUSIVO', 'EXCLUSIVE SERVICE'],
    ['Marque a sua Consulta', 'Book Your Appointment'],
    ['Sessões individuais de aconselhamento ótico e estético no nosso espaço na Madeira. Experimente toda a coleção com acompanhamento técnico dedicado.', 'Individual optical and styling consultations at our space in Madeira. Discover the full collection with dedicated technical guidance.'],
    ['Agendar Sessão Individual →', 'Book an Individual Session →'],
    ['Coleções', 'Collections'],
    ['Armações Óticas', 'Optical Frames'],
    ['Óculos de Sol', 'Sunglasses'],
    ['Manufaturas', 'Brands'],
    ['O Ateliê', 'The Ateliê'],
    ['Contactos', 'Contact'],
    ['Espaço & Localização', 'Store & Location'],
    ['Abrir no Google Maps →', 'Open in Google Maps →'],
    ['Contacto Direto', 'Direct Contact'],
    ['Atendimento e marcações personalizadas:', 'Personalised service and appointments:'],
    ['Conversar no WhatsApp →', 'Chat on WhatsApp →'],
    ['Horário de Funcionamento', 'Opening Hours'],
    ['Segunda a Sexta', 'Monday to Friday'],
    ['Sábado', 'Saturday'],
    ['Domingo', 'Sunday'],
    ['Encerrado', 'Closed'],
    ['Termos e Condições', 'Terms & Conditions'],
    ['Privacidade', 'Privacy'],
    ['Envios', 'Shipping'],
    ['Apoio ao Cliente', 'Customer Care'],
    ['Todos os direitos reservados', 'All rights reserved'],
    ['O seu saco', 'Your bag'],
    ['O seu saco está vazio.', 'Your bag is empty.'],
    ['VER SACO', 'VIEW BAG'],
    ['Fechar saco', 'Close bag'],
    ['Produto anterior', 'Previous product'],
    ['Próximo produto', 'Next product'],
    ['Favorito', 'Favourite'],
    ['alternativa', 'alternate view'],
    ['Atendimento Personalizado Ateliê Ótico', 'Personalised Service at Ateliê Ótico'],
    ['SNOB Milano Campanha', 'SNOB Milano Campaign'],
    ['SNOB Milano Coleção', 'SNOB Milano Collection'],
    ['Acessórios e Embalagem SNOB Milano', 'SNOB Milano Accessories and Packaging']
  ];

  function translateContent(root: ParentNode, lang: string) {
    const from = lang === 'en' ? 0 : 1;
    const to = lang === 'en' ? 1 : 0;
    const lookup = new Map(contentPairs.map(pair => [pair[from], pair[to]]));
    const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
      acceptNode(node) {
        const parent = node.parentElement;
        if (!parent || ['SCRIPT', 'STYLE', 'NOSCRIPT'].includes(parent.tagName)) return NodeFilter.FILTER_REJECT;
        return node.nodeValue?.trim() ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT;
      }
    });
    const nodes: Text[] = [];
    while (walker.nextNode()) nodes.push(walker.currentNode as Text);
    nodes.forEach(node => {
      const value = node.nodeValue || '';
      const trimmed = value.trim().replace(/\s+/g, ' ');
      const translated = lookup.get(trimmed);
      if (translated) node.nodeValue = value.replace(value.trim(), translated);
      else if (/©\s*2026\s+Ateliê Ótico/.test(trimmed)) {
        node.nodeValue = lang === 'en'
          ? '© 2026 Ateliê Ótico — All rights reserved • Madeira'
          : '© 2026 Ateliê Ótico — Todos os direitos reservados • Madeira';
      }
    });
    root.querySelectorAll?.('[alt], [title], [aria-label], [placeholder]').forEach(el => {
      ['alt', 'title', 'aria-label', 'placeholder'].forEach(attr => {
        const value = el.getAttribute(attr);
        const translated = value ? lookup.get(value.trim()) : null;
        if (translated) el.setAttribute(attr, translated);
      });
    });
  }

  function applyLanguage(lang) {
    const currentLang = translations[lang] ? lang : 'pt';
    const dict = translations[currentLang];
    document.documentElement.lang = currentLang === 'pt' ? 'pt-PT' : 'en-US';

    // Update switcher buttons active state
    document.querySelectorAll('.lang-btn').forEach(btn => {
      if (btn.getAttribute('data-lang') === currentLang) {
        btn.classList.add('active');
      } else {
        btn.classList.remove('active');
      }
    });

    // Topbar
    const topbar = document.querySelector('.topbar');
    if (topbar) topbar.textContent = dict.topbar;

    // Navigation items
    const navLinks = document.querySelectorAll('#main-nav > a, #main-nav > .nav-drop > a');
    navLinks.forEach(link => {
      const text = link.textContent.trim().toUpperCase();
      if (text.includes('CAMPANHAS') || text.includes('CAMPAIGNS')) link.textContent = dict.nav_campanhas;
      if (text.includes('ÓCULOS') || text.includes('EYEWEAR')) link.textContent = dict.nav_oculos;
      if (text.includes('NOVIDADES') || text.includes('NEW ARRIVALS')) link.textContent = dict.nav_novidades;
      if (text.includes('MARCAS') || text.includes('BRANDS')) link.textContent = dict.nav_marcas;
      if (text.includes('O ATELIÊ') || text.includes('THE ATELIÊ') || text.includes('ABOUT')) link.textContent = dict.nav_sobre;
      if (text.includes('CONTACTOS') || text.includes('CONTACT')) link.textContent = dict.nav_contactos;
    });

    // Footer tagline
    const footerTagline = document.querySelector('.ll-footer-tagline');
    if (footerTagline) footerTagline.textContent = dict.footer_tagline;

    // Chat label
    const chatLabel = document.querySelector('.chat-label');
    if (chatLabel) chatLabel.textContent = dict.chat_label;

    document.querySelectorAll('[data-i18n-pt][data-i18n-en]').forEach(el => {
      const translated = el.getAttribute(`data-i18n-${currentLang}`);
      if (translated) el.textContent = translated;
    });

    translateContent(document.body, currentLang);

    const productTranslations = currentLang === 'en' ? {
      'FORMA': 'SHAPE', 'MATERIAL': 'MATERIAL', 'COR': 'COLOUR', 'AJUSTE': 'FIT',
      'Personalizado': 'Custom fit', 'DETALHES DO PRODUTO': 'PRODUCT DETAILS',
      'ENVIO E DEVOLUÇÕES': 'SHIPPING & RETURNS', 'AJUSTE NO ATELIÊ': 'IN-STORE FITTING',
      'OUTROS MODELOS': 'OTHER STYLES', 'Também poderá gostar': 'You may also like'
    } : null;
    if (productTranslations) document.querySelectorAll('.product-info span, .product-info strong, .details summary, .related > p, .related > h2').forEach(el => {
      const key = el.textContent?.trim();
      if (key && productTranslations[key]) el.textContent = productTranslations[key];
    });

    localStorage.setItem('atelie_lang', currentLang);
  }

  document.addEventListener('DOMContentLoaded', () => {
    const savedLang = localStorage.getItem('atelie_lang') || 'pt';
    applyLanguage(savedLang);

    document.querySelectorAll('.lang-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const lang = (e.currentTarget as HTMLElement).getAttribute('data-lang');
        if (lang) applyLanguage(lang);
      });
    });

    const observer = new MutationObserver(mutations => {
      const currentLang = localStorage.getItem('atelie_lang') || 'pt';
      mutations.forEach(mutation => mutation.addedNodes.forEach(node => {
        if (node.nodeType === Node.ELEMENT_NODE) translateContent(node as ParentNode, currentLang);
        if (node.nodeType === Node.TEXT_NODE && node.parentElement) translateContent(node.parentElement, currentLang);
      }));
    });
    observer.observe(document.body, { childList: true, subtree: true });
  });
</script>
