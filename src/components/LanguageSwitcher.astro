  const contentPairs: Array<[string, string]> = [
    ['Saltar para o conteúdo', 'Skip to content'],
    ['COLEÇÃO 2026', '2026 COLLECTION'],
    ['Design de Autor & Precisão Ótica', 'Signature Eyewear & Optical Precision'],
    ['Curadoria independente de armações óticas e óculos de sol desenhados para carácter e conforto diário.', 'Independent eyewear curation designed for distinctive character and everyday comfort.'],
    ['EXPLORAR CATÁLOGO', 'EXPLORE CATALOGUE'],
    ['Marcas no nosso catálogo', 'Brands in our catalogue'],
    ['NOVIDADES', 'NEW ARRIVALS'],
    ['Armações óticas com linhas intemporais e lentes de alta precisão.', 'Optical frames with timeless lines and high-precision lenses.'],
    ['Linhas Arquiteturais e Conforto Absoluto', 'Architectural Lines and Absolute Comfort'],
    ['Desenho de Autor', 'Signature Design'],
    ['Rigor Estrutural', 'Structural Rigour'],
    ['Acabamento Manual', 'Hand Finishing'],
    ['COLEÇÃO SIGNATURE 2026', 'SIGNATURE COLLECTION 2026'],
    ['Cada peça resulta de um desenho rigoroso e de uma seleção criteriosa de acetatos italianos de celulose e titânio ultraleve. Criadas para resistir ao tempo e afirmar a sua identidade visual.', 'Each piece is shaped by rigorous design and a careful selection of Italian cellulose acetate and ultralight titanium. Created to stand the test of time and express your visual identity.'],
    ['Explorar a Coleção Signature →', 'Explore the Signature Collection →'],
    ['RIGOR & MATÉRIA / ESPECIFICAÇÕES TÉCNICAS', 'RIGOUR & MATERIAL / TECHNICAL SPECIFICATIONS'],
    ['ÓTICA', 'OPTICS'],
    ['Acuidade Visual & Lentes Zeiss', 'Visual Acuity & Zeiss Lenses'],
    ['Equipamos todas as armações com lentes de alta definição ótica alemã, garantindo proteção ultravioleta absoluta e tratamentos antirreflexo multicamada.', 'We fit every frame with high-definition German optical lenses, ensuring full ultraviolet protection and multilayer anti-reflective treatments.'],
    ['MATÉRIA', 'MATERIAL'],
    ['Acetato Italiano Mazzucchelli', 'Italian Mazzucchelli Acetate'],
    ['Polímeros naturais biocompatíveis derivados do algodão, esculpidos e polidos à mão para um brilho profundo e toque suave sobre a pele.', 'Natural biocompatible cotton-derived polymers, sculpted and polished by hand for a deep lustre and a soft feel against the skin.'],
    ['ESTRUTURA', 'STRUCTURE'],
    ['Titânio Cirúrgico Ultraleve', 'Ultralight Surgical Titanium'],
    ['Componentes de união e charneiras de alta precisão que oferecem resistência mecânica excepcional com um peso impercetível.', 'High-precision joints and hinges offering exceptional mechanical strength with barely perceptible weight.'],
    ['CONSULTORIA', 'CONSULTATION'],
