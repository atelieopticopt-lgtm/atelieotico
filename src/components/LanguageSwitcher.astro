    ['Análise morfológica cuidada para adequar a geometria, ponte nasal e comprimento de hastes à anatomia individual do seu rosto.', 'Careful facial analysis to adapt the geometry, bridge and temple length to your individual anatomy.'],
    ['CATÁLOGO / SELEÇÃO PERMANENTE', 'CATALOGUE / PERMANENT SELECTION'],
    ['Explore a nossa coleção completa de', 'Explore our complete collection of'],
    ['armações óticas e óculos de sol.', 'optical frames and sunglasses.'],
    ['Explore a nossa coleção completa de armações óticas e óculos de sol.', 'Explore our complete collection of optical frames and sunglasses.'],
    ['Ver Todo o Catálogo →', 'View the Full Catalogue →'],
    ['Ver catálogo completo', 'View full catalogue'],
    ['Armações óticas', 'Optical frames'],
    ['Óculos de sol', 'Sunglasses'],
    ['Retangular', 'Rectangular'],
    ['Redonda', 'Round'],
    ['Quadrada', 'Square'],
