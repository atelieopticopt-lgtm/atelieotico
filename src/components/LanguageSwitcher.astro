---
// LanguageSwitcher.astro - Luxury Real-Time Language Selector (PT / EN)
---

<div class="lang-switcher-wrap" id="lang-switcher">
  <button type="button" class="lang-btn active" data-lang="pt" aria-label="Português">PT</button>
  <span class="lang-divider">/</span>
  <button type="button" class="lang-btn" data-lang="en" aria-label="English">EN</button>
</div>

<style>
  .lang-switcher-wrap {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
    padding: 4px 8px;
    background: transparent;
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 4px;
  }

  .lang-btn {
    background: none;
    border: none;
    padding: 2px 4px;
    font-size: 11.5px;
    font-weight: 600;
    color: #888888;
    cursor: pointer;
    transition: color 0.2s ease;
    outline: none;
  }

  .lang-btn:hover {
    color: #111111;
  }

  .lang-btn.active {
    color: #0a0a0a;
    font-weight: 800;
  }

  .lang-divider {
    color: #cccccc;
    font-size: 11px;
    user-select: none;
  }
</style>

<script>
  const translations = {
