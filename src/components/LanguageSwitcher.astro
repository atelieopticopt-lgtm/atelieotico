    en: {
      topbar: "FREE SHIPPING ON ORDERS OVER 100 €",
      nav_campanhas: "CAMPAIGNS",
      nav_oculos: "EYEWEAR",
      nav_novidades: "NEW ARRIVALS",
      nav_marcas: "BRANDS",
      nav_sobre: "THE ATELIÊ",
      nav_contactos: "CONTACT",
      hero_tag: "2026 COLLECTION",
      hero_title: "Signature Eyewear & Optical Precision",
      hero_subtitle: "Independent eyewear curation crafted for distinct character and daily comfort.",
      hero_btn: "EXPLORE CATALOG",
      cart_title: "Your bag",
      cart_empty: "Your bag is empty",
      cart_checkout: "CHECKOUT",
      cart_subtotal: "Subtotal",
      cart_view: "VIEW BAG",
      footer_tagline: "Independent optical boutique in Madeira — Signature curation & optical precision",
      footer_newsletter_title: "Receive limited drops and private event invitations",
      footer_subscribe: "Subscribe",
      footer_placeholder: "Your e-mail...",
      chat_label: "Optical Advice",
      cookie_notice: "We use cookies to enhance your shopping experience and ensure store security.",
      btn_accept: "Accept",
      btn_enter: "SIGN IN"
