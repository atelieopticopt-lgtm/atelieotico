---
// AuthGate.astro - Luxury Private Access Gate for Ateliê Ótico
---

<div id="atelie-auth-overlay" class="atelie-auth-overlay">
  <div class="auth-card">
    <div class="auth-logo-wrapper">
      <img
        src="/SVG-Logo-Atelie.svg"
        alt="Ateliê Ótico"
        class="auth-logo-img"
      />
    </div>

    <form id="atelie-auth-form" class="auth-form" autocomplete="off">
      <div class="form-group">
        <label for="auth-username" class="sr-only">Utilizador</label>
        <input
          type="text"
          id="auth-username"
          name="username"
          placeholder="Utilizador"
          required
          autocomplete="username"
          class="auth-input"
        />
      </div>

      <div class="form-group password-group">
        <label for="auth-password" class="sr-only">Palavra-passe</label>
        <input
          type="password"
          id="auth-password"
          name="password"
          placeholder="Palavra-passe"
          required
          autocomplete="current-password"
          class="auth-input"
        />
        <button
          type="button"
          id="toggle-password"
          class="toggle-password"
          aria-label="Mostrar palavra-passe"
        >
          <svg id="eye-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
            <circle cx="12" cy="12" r="3"></circle>
          </svg>
        </button>
      </div>

      <p id="auth-error-msg" class="auth-error" style="display: none;"></p>

      <button type="submit" id="auth-submit-btn" class="auth-btn">
        <span id="btn-text">Entrar</span>
        <span id="btn-spinner" class="spinner" style="display: none;"></span>
      </button>
    </form>
  </div>
</div>

<style>
  .atelie-auth-overlay {
    position: fixed;
    inset: 0;
    z-index: 999999;
    background: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    opacity: 1;
    visibility: visible;
    transition: opacity 0.35s ease, visibility 0.35s ease;
    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  .atelie-auth-overlay.unlocked {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .auth-card {
    width: 100%;
    max-width: 380px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    background: transparent;
  }

  .auth-logo-wrapper {
    margin-bottom: 36px;
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
  }

  .auth-logo-img {
    height: 52px;
    width: auto;
    max-width: 220px;
    object-fit: contain;
    background: transparent !important;
    display: block;
  }

  .auth-form {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .form-group {
    position: relative;
    width: 100%;
  }

  .auth-input {
    width: 100%;
    height: 48px;
    padding: 0 16px;
    background: #ffffff;
    border: 1px solid #111111;
    border-radius: 0;
    font-size: 13.5px;
    color: #111111;
    font-family: inherit;
    box-sizing: border-box;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .auth-input:focus {
    border-color: #000000;
    box-shadow: 0 0 0 1px #000000;
  }

  .auth-input::placeholder {
    color: #888888;
    font-size: 13px;
  }

  .password-group {
    display: flex;
    align-items: center;
  }

  .toggle-password {
    position: absolute;
    right: 12px;
    background: none;
    border: none;
    padding: 4px;
    cursor: pointer;
    color: #666666;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .toggle-password:hover {
    color: #000000;
  }

  .auth-error {
    color: #dc2626;
    font-size: 12.5px;
    margin: -4px 0 4px;
    text-align: left;
    font-weight: 500;
  }

  .auth-btn {
    width: 100%;
    height: 48px;
    background: #000000;
    color: #ffffff;
    border: 1px solid #000000;
    border-radius: 0;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition: background-color 0.2s ease, opacity 0.2s ease;
    margin-top: 4px;
  }

  .auth-btn:hover {
    background: #222222;
  }

  .auth-btn:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }

  .spinner {
    width: 16px;
    height: 16px;
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-top-color: #ffffff;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<script>
  import { supabase } from '../lib/supabase';

  const overlay = document.getElementById('atelie-auth-overlay');
  const form = document.getElementById('atelie-auth-form') as HTMLFormElement;
  const usernameInput = document.getElementById('auth-username') as HTMLInputElement;
  const passwordInput = document.getElementById('auth-password') as HTMLInputElement;
  const errorMsg = document.getElementById('auth-error-msg');
  const submitBtn = document.getElementById('auth-submit-btn') as HTMLButtonElement;
  const btnText = document.getElementById('btn-text');
  const btnSpinner = document.getElementById('btn-spinner');
  const toggleBtn = document.getElementById('toggle-password');

  const MASTER_PASSWORDS = [
    'atelie2026',
    'atelieotico',
    'WwmMWtRdjLLK',
    'AtelieOtico2026!'
  ];

  function unlockSite() {
    if (overlay) {
      overlay.classList.add('unlocked');
      setTimeout(() => {
        overlay.style.display = 'none';
      }, 380);
    }
  }

  const existingSession = localStorage.getItem('atelie_auth_session');
  if (existingSession === 'active' || window.location.pathname.startsWith('/admin')) {
    unlockSite();
  }

  if (toggleBtn && passwordInput) {
    toggleBtn.addEventListener('click', () => {
      const isPass = passwordInput.type === 'password';
      passwordInput.type = isPass ? 'text' : 'password';
    });
  }

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const username = usernameInput.value.trim().toLowerCase();
      const password = passwordInput.value.trim();

      if (errorMsg) errorMsg.style.display = 'none';
      if (btnText) btnText.style.display = 'none';
      if (btnSpinner) btnSpinner.style.display = 'inline-block';
      if (submitBtn) submitBtn.disabled = true;

      try {
        if (MASTER_PASSWORDS.includes(password) || (username === 'admin' && MASTER_PASSWORDS.includes(password))) {
          localStorage.setItem('atelie_auth_session', 'active');
          unlockSite();
          return;
        }

        const email = username.includes('@') ? username : `${username}@atelieotico.com`;
        const { data, error } = await supabase.auth.signInWithPassword({
          email,
          password
        });

        if (error) {
          throw error;
        }

        if (data?.session) {
          localStorage.setItem('atelie_auth_session', 'active');
          unlockSite();
        }
      } catch (err: any) {
        if (errorMsg) {
          errorMsg.textContent = 'Credenciais incorretas. Verifique o utilizador e a palavra-passe.';
          errorMsg.style.display = 'block';
        }
      } finally {
        if (btnText) btnText.style.display = 'inline-block';
        if (btnSpinner) btnSpinner.style.display = 'none';
        if (submitBtn) submitBtn.disabled = false;
      }
    });
  }
</script>
