---
// GoogleReviews.astro - Editorial Luxury Google Reviews Section
const reviews = [
  {
    name: "Joana Lira",
    rating: 5,
    date: "há 3 meses",
    quote: "A equipa é muito acolhedora e profissional! Atendem e acompanham o cliente com a maior simpatia, aliando o bom gosto à competência. Recomendo! ;)",
    url: "https://maps.app.goo.gl/Ateliê"
  },
  {
    name: "Inês Cunha",
    rating: 5,
    date: "há um ano",
    quote: "Levei o meu filho de 11 anos ao Ateliê Ótico e fiquei impressionada com a qualidade do atendimento. A equipa foi extremamente paciente, cuidadosa e soube lidar com muita dedicação.",
    url: "https://maps.app.goo.gl/Ateliê"
  },
  {
    name: "Christine Homem de Gouveia",
    rating: 5,
    date: "há 2 anos",
    quote: "Quero agradecer à forma simpática e agradável que fui atendida nesta loja, aos funcionários sempre muito atenciosos e simpáticos até à Sra. Dra. Vanessa pelo acolhimento exemplar.",
    url: "https://maps.app.goo.gl/Ateliê"
  },
  {
    name: "Eliana Bastos",
    rating: 5,
    date: "há 3 anos",
    quote: "Dra. Vanessa com uma competência ímpar fala com muita propriedade do que Precisãos entender, o preço não é o melhor mas vale cada euro que paguei pelos meus óculos!",
    url: "https://maps.app.goo.gl/Ateliê"
  },
  {
    name: "Pedro Rodrigues",
    rating: 5,
    date: "há 3 anos",
    quote: "Excelente atendimento e aconselhamento ótico personalizado. Muita variedade de armações de autor, com acabamentos de grande qualidade!",
    url: "https://maps.app.goo.gl/Ateliê"
  },
  {
    name: "Fabiana Baeta",
    rating: 5,
    date: "há 3 anos",
    quote: "Queria agradecer pelo atendimento de excelência que tive no Funchal. Continuem assim com esta dedicação! Muito agradecida. Adorei!",
    url: "https://maps.app.goo.gl/Ateliê"
  }
];
---

<section class="ll-reviews-section" id="avaliacoes">
  <div class="ll-container">
    
    <div class="ll-reviews-header-wrap">
      <div class="ll-google-rating-badge">
        <svg class="ll-google-icon" viewBox="0 0 24 24">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
        </svg>
        <span class="ll-stars-gold">★★★★★</span>
        <span class="ll-rating-text">5.0 / 5.0 • Google Reviews</span>
      </div>

      <span class="ll-section-tag" style="display: block; margin-bottom: 8px;">experiências Reais</span>
      <h2 class="ll-statement-title" style="margin: 0 auto 12px;">
        A confiança de quem escolhe ver com outro olhar.
      </h2>
      <p style="font-size: 14px; color: var(--ll-gray-500); margin: 0;">
        Avaliações autênticas de clientes que visitaram o nosso espaço no Funchal, Região Autónoma da Madeira.
      </p>
    </div>

    <!-- Reviews Grid -->
    <div class="ll-reviews-grid">
      {reviews.map((r) => (
        <div class="ll-review-card">
          <div class="ll-review-top">
            <span class="ll-review-stars">★★★★★</span>
            <span class="ll-review-date">{r.date}</span>
          </div>

          <p class="ll-review-quote">
            "{r.quote}"
          </p>

          <div class="ll-review-author-row">
            <div>
              <p class="ll-review-author-name">{r.name}</p>
            </div>
            <span class="ll-review-verified">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
              </svg>
              Google
            </span>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
