---
// ChatButton.astro - Perfectly aligned vertical action buttons without scale/transform animations
---

<div id="atelie-floating-stack" class="atelie-floating-stack">
  
  {/* Schedule Floating Popover */}
  <div id="hours-popover" class="hours-popover" aria-hidden="true">
    <div class="hours-popover-header">
      <strong data-i18n-pt="Horário de Funcionamento" data-i18n-en="Opening Hours">Horário de Funcionamento</strong>
      <button type="button" class="hours-close-btn" id="hours-close-btn" aria-label="Fechar">&times;</button>
    </div>
    <div class="hours-popover-body">
      <div class="hours-line">
        <span data-i18n-pt="Segunda a Sexta" data-i18n-en="Monday to Friday">Segunda a Sexta</span>
        <strong>09:00 – 19:00</strong>
      </div>
      <div class="hours-line">
        <span data-i18n-pt="Sábado" data-i18n-en="Saturday">Sábado</span>
        <strong>09:00 – 13:00</strong>
      </div>
      <div class="hours-line">
        <span data-i18n-pt="Domingo" data-i18n-en="Sunday">Domingo</span>
        <strong data-i18n-pt="Encerrado" data-i18n-en="Closed">Encerrado</strong>
      </div>
    </div>
    <div class="hours-popover-footer">
      <p>Praça do Carmo 29B, Funchal</p>
      <a href="tel:+351964993767">+351 964 993 767</a>
    </div>
  </div>

  {/* Row 1: WhatsApp Button */}
  <a
    href="https://wa.me/351964993767?text=Ol%C3%A1%2C%20gostaria%20de%20informa%C3%A7%C3%B5es%20e%20aconselhamento%20sobre%20as%20arma%C3%A7%C3%B5es%20do%20Ateli%C3%AA%20%C3%93tico."
    target="_blank"
    rel="noopener noreferrer"
    class="floating-circle-btn whatsapp-pure-btn"
    aria-label="WhatsApp Ateliê Ótico"
    title="Fale connosco no WhatsApp"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 360 360" width="46" height="46" xml:space="preserve">
      <circle cx="180" cy="180" r="144" fill="#25D366"/>
      <path fill="#FFFFFF" d="M180,95.54c46.57,0,84.46,37.89,84.46,84.46c0,46.57-37.89,84.46-84.46,84.46c-16.85,0-33.1-4.94-47-14.28 l-6.89-4.63l-7.88,4.3l-17.31,8.56l8.64-17.45l4.29-7.8l-4.51-6.87c-9.03-13.75-13.8-29.76-13.8-46.3 C95.54,133.43,133.43,95.54,180,95.54 M180,78.58c-56.01,0-101.42,45.41-101.42,101.42c0,20.53,6.1,39.64,16.59,55.61l-14.23,42.72 l42.61-14.06c16.14,10.84,35.56,17.16,56.46,17.16c56.01,0,101.42-45.41,101.42-101.42C281.42,123.99,236.01,78.58,180,78.58 L180,78.58z"/>
      <path fill="#FFFFFF" d="M152.22,132.09l-5.14-0.38c-4.01-0.29-7.91,1.38-10.46,4.48l-1.22,1.63c-8.98,12.58-8.57,22.56-2.17,36.77l0,0 c0.61,1.36,1.3,2.68,2.09,3.94c10.83,17.35,24.37,32,42.74,41.05l15.08,6.38c7.8,3.3,16.39,3.05,23.74-0.23 c6.56-2.92,11.38-8.73,13.44-15.61l0.93-3.11c0.68-2.28-0.4-4.72-2.56-5.74l-20.11-9.8c-2.46-1.2-5.42-0.5-7.08,1.68l-6.97,9.79 c-1.09,1.53-3.12,2.07-4.83,1.28l-3.39-1.58c-13.06-6.08-23.92-16.05-31.1-28.54l-0.06-0.11c-0.76-1.32-0.59-2.98,0.43-4.11 l6.97-7.3c1.82-1.91,2.32-4.72,1.26-7.13l-9.21-21.1C154.16,133.29,153.29,132.48,152.22,132.09L152.22,132.09z"/>
    </svg>
  </a>

  {/* Row 2: Scroll to top */}
  <button
    type="button"
    id="btn-scroll-top"
    class="floating-circle-btn action-circle-btn"
    aria-label="Voltar ao topo"
    title="Voltar ao topo"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="18 15 12 9 6 15"></polyline>
    </svg>
  </button>

  {/* Row 3: Opening Hours Clock */}
  <button
    type="button"
    id="btn-toggle-hours"
    class="floating-circle-btn action-circle-btn"
    aria-label="Horário de funcionamento"
    title="Ver horários do Ateliê"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="10"></circle>
      <polyline points="12 6 12 12 16 14"></polyline>
    </svg>
  </button>

</div>

<style>
  .atelie-floating-stack {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 99999;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 46px;
  }

  /* Circular Buttons - Uniform Sizing & Centered Column */
  .floating-circle-btn {
    width: 46px;
    height: 46px;
    border-radius: 50% !important;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    border: none;
    padding: 0;
    margin: 0;
    text-decoration: none;
    box-sizing: border-box;
    transform: none !important;
    transition: background-color 0.2s ease, color 0.2s ease, opacity 0.2s ease;
  }

  .whatsapp-pure-btn {
    background: transparent !important;
    filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.15));
  }

  .whatsapp-pure-btn:hover {
    opacity: 0.88;
    transform: none !important;
  }

  .whatsapp-pure-btn svg {
    display: block;
    width: 46px;
    height: 46px;
    border-radius: 50%;
  }

  /* Secondary Circular Action Buttons */
  .action-circle-btn {
    background: #ffffff;
    color: #111111;
    border: 1px solid rgba(0, 0, 0, 0.14) !important;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }

  .action-circle-btn:hover {
    background: #000000;
    color: #ffffff;
    border-color: #000000 !important;
    transform: none !important;
  }

  /* Hours Popover */
  .hours-popover {
    position: absolute;
    bottom: 0;
    right: 56px;
    width: 270px;
    background: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.15);
    border-radius: 4px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.14);
    padding: 16px 18px;
    display: none;
    box-sizing: border-box;
  }

  .hours-popover.open {
    display: block;
  }

  .hours-popover-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #eee;
    padding-bottom: 8px;
    margin-bottom: 12px;
  }

  .hours-popover-header strong {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #000;
  }

  .hours-close-btn {
    background: none;
    border: none;
    font-size: 18px;
    cursor: pointer;
    line-height: 1;
    color: #888;
  }

  .hours-close-btn:hover {
    color: #000;
  }

  .hours-popover-body {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 12px;
  }

  .hours-line {
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    color: #444;
  }

  .hours-line strong {
    color: #000;
  }

  .hours-popover-footer {
    border-top: 1px dashed #ddd;
    padding-top: 8px;
    font-size: 11px;
    color: #666;
  }

  .hours-popover-footer p {
    margin: 0 0 4px;
  }

  .hours-popover-footer a {
    color: #000;
    font-weight: 700;
    text-decoration: none;
  }

  @media (max-width: 768px) {
    .atelie-floating-stack {
      bottom: 18px;
      right: 18px;
    }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // Scroll to Top
    const btnScrollTop = document.getElementById('btn-scroll-top');
    if (btnScrollTop) {
      btnScrollTop.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }

    // Toggle Hours Popover
    const btnHours = document.getElementById('btn-toggle-hours');
    const popover = document.getElementById('hours-popover');
    const closeHours = document.getElementById('hours-close-btn');

    if (btnHours && popover) {
      btnHours.addEventListener('click', (e) => {
        e.stopPropagation();
        popover.classList.toggle('open');
      });

      closeHours?.addEventListener('click', (e) => {
        e.stopPropagation();
        popover.classList.remove('open');
      });

      document.addEventListener('click', (e) => {
        if (!popover.contains(e.target) && e.target !== btnHours) {
          popover.classList.remove('open');
        }
      });
    }
  });
</script>
