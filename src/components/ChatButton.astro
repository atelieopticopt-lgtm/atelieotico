---
// ChatButton.astro - Perfectly aligned 46px circular action stack
---

<div id="atelie-floating-stack" class="atelie-floating-stack">
  
  {/* Schedule Floating Popover */}
  <div id="hours-popover" class="hours-popover" aria-hidden="true">
    <div class="hours-popover-header">
      <strong data-i18n-pt="Horário de Funcionamento" data-i18n-en="Opening Hours">Horário de Funcionamento</strong>
      <button type="button" class="hours-close-btn" id="hours-close-btn" aria-label="Fechar">&times;</button>
    </div>
    <div class="hours-popover-body">
      <div class="hours-line">
        <span data-i18n-pt="Segunda a Sexta" data-i18n-en="Monday to Friday">Segunda a Sexta</span>
        <strong>09:00 – 19:00</strong>
      </div>
      <div class="hours-line">
        <span data-i18n-pt="Sábado" data-i18n-en="Saturday">Sábado</span>
        <strong>09:00 – 13:00</strong>
      </div>
      <div class="hours-line">
        <span data-i18n-pt="Domingo" data-i18n-en="Sunday">Domingo</span>
        <strong data-i18n-pt="Encerrado" data-i18n-en="Closed">Encerrado</strong>
      </div>
    </div>
    <div class="hours-popover-footer">
      <p>Praça do Carmo 29B, Funchal</p>
      <a href="tel:+351964993767">+351 964 993 767</a>
    </div>
  </div>

  {/* Button 1: WhatsApp (Solid Green Circle with exact 46px size) */}
  <a
    href="https://wa.me/351964993767?text=Ol%C3%A1%2C%20gostaria%20de%20informa%C3%A7%C3%B5es%20e%20aconselhamento%20sobre%20as%20arma%C3%A7%C3%B5es%20do%20Ateli%C3%AA%20%C3%93tico."
    target="_blank"
    rel="noopener noreferrer"
    class="floating-circle-btn whatsapp-circle-btn"
    aria-label="WhatsApp Ateliê Ótico"
    title="Fale connosco no WhatsApp"
  >
    <svg width="24" height="24" viewBox="0 0 24 24" fill="#ffffff">
      <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
    </svg>
  </a>

  {/* Button 2: Scroll to top (Solid White Circle with exact 46px size) */}
  <button
    type="button"
    id="btn-scroll-top"
    class="floating-circle-btn action-circle-btn"
    aria-label="Voltar ao topo"
    title="Voltar ao topo"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="18 15 12 9 6 15"></polyline>
    </svg>
  </button>

  {/* Button 3: Opening Hours Clock (Solid White Circle with exact 46px size) */}
  <button
    type="button"
    id="btn-toggle-hours"
    class="floating-circle-btn action-circle-btn"
    aria-label="Horário de funcionamento"
    title="Ver horários do Ateliê"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="10"></circle>
      <polyline points="12 6 12 12 16 14"></polyline>
    </svg>
  </button>

</div>

<style>
  .atelie-floating-stack {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 99999;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 46px;
  }

  /* All Circular Buttons have IDENTICAL dimensions and box model */
  .floating-circle-btn {
    width: 46px !important;
    height: 46px !important;
    min-width: 46px !important;
    min-height: 46px !important;
    max-width: 46px !important;
    max-height: 46px !important;
    border-radius: 50% !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    cursor: pointer;
    border: none;
    padding: 0 !important;
    margin: 0 !important;
    text-decoration: none;
    box-sizing: border-box !important;
    transform: none !important;
    transition: background-color 0.2s ease, color 0.2s ease, opacity 0.2s ease;
  }

  /* Solid Green WhatsApp Button */
  .whatsapp-circle-btn {
    background-color: #25D366 !important;
    color: #ffffff !important;
    border: 1px solid #25D366 !important;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
  }

  .whatsapp-circle-btn:hover {
    background-color: #20bd5a !important;
    border-color: #20bd5a !important;
    transform: none !important;
  }

  .whatsapp-circle-btn svg {
    display: block;
    width: 24px;
    height: 24px;
  }

  /* Solid White Action Buttons */
  .action-circle-btn {
    background-color: #ffffff !important;
    color: #111111 !important;
    border: 1px solid rgba(0, 0, 0, 0.15) !important;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }

  .action-circle-btn:hover {
    background-color: #000000 !important;
    color: #ffffff !important;
    border-color: #000000 !important;
    transform: none !important;
  }

  /* Hours Popover */
  .hours-popover {
    position: absolute;
    bottom: 0;
    right: 56px;
    width: 270px;
    background: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.15);
    border-radius: 4px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.14);
    padding: 16px 18px;
    display: none;
    box-sizing: border-box;
  }

  .hours-popover.open {
    display: block;
  }

  .hours-popover-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #eee;
    padding-bottom: 8px;
    margin-bottom: 12px;
  }

  .hours-popover-header strong {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #000;
  }

  .hours-close-btn {
    background: none;
    border: none;
    font-size: 18px;
    cursor: pointer;
    line-height: 1;
    color: #888;
  }

  .hours-close-btn:hover {
    color: #000;
  }

  .hours-popover-body {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 12px;
  }

  .hours-line {
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    color: #444;
  }

  .hours-line strong {
    color: #000;
  }

  .hours-popover-footer {
    border-top: 1px dashed #ddd;
    padding-top: 8px;
    font-size: 11px;
    color: #666;
  }

  .hours-popover-footer p {
    margin: 0 0 4px;
  }

  .hours-popover-footer a {
    color: #000;
    font-weight: 700;
    text-decoration: none;
  }

  @media (max-width: 768px) {
    .atelie-floating-stack {
      bottom: 18px;
      right: 18px;
    }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // Scroll to Top
    const btnScrollTop = document.getElementById('btn-scroll-top');
    if (btnScrollTop) {
      btnScrollTop.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }

    // Toggle Hours Popover
    const btnHours = document.getElementById('btn-toggle-hours');
    const popover = document.getElementById('hours-popover');
    const closeHours = document.getElementById('hours-close-btn');

    if (btnHours && popover) {
      btnHours.addEventListener('click', (e) => {
        e.stopPropagation();
        popover.classList.toggle('open');
      });

      closeHours?.addEventListener('click', (e) => {
        e.stopPropagation();
        popover.classList.remove('open');
      });

      document.addEventListener('click', (e) => {
        if (!popover.contains(e.target) && e.target !== btnHours) {
          popover.classList.remove('open');
        }
      });
    }
  });
</script>
