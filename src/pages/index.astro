---
import StoreLayout from '../layouts/StoreLayout.astro';
import { products } from '../data/products';

const novidades = products.slice(0, 8);
const selecaoPermanente = products.slice(0, 4);
---

<StoreLayout
  title="Ateliê Ótico — Design de Autor & Precisão Ótica na Madeira"
  description="Ótica de autor independente no Funchal, Madeira. Curadoria internacional de armações de autor, lentes oftálmicas de alta precisão e atendimento personalizado."
>

  {/* =========================================================================
      1. HERO SECTION (EXACT USER DIMENSIONS: 660px, min-height: calc(305px + var(--menu-height)))
      ========================================================================= */}
  <section class="ll-melin-hero">
    <img
      class="ll-melin-hero-img"
      src="/campagna-hero.jpeg"
      alt="Design de Autor & Precisão Ótica — Ateliê Ótico"
      loading="eager"
      style="object-position: center 8%;"
    />
    <div class="ll-melin-hero-overlay"></div>

    <div class="ll-melin-hero-content">
      <span class="ll-melin-hero-tag">COLEÇÃO 2026</span>
      <h1 class="ll-melin-hero-title">
        Design de Autor &amp; Precisão Ótica
      </h1>
      <p class="ll-melin-hero-desc">
        Curadoria independente de armações óticas e óculos de sol desenhados para carácter e conforto diário.
      </p>

      <a href="/catalogo" class="ll-melin-btn">
        EXPLORAR CATÁLOGO
      </a>
    </div>
  </section>


  {/* =========================================================================
      2. BRANDS BAR DIRECTLY UNDER HERO (BABOCUSH STYLE "AS SEEN ON")
      ========================================================================= */}
  <section class="ll-brands-strip-section">
    <div class="ll-container">
      <div class="ll-brands-strip-header">
        <h2 class="ll-statement-title ll-brands-title" data-i18n-pt="Marcas no nosso catálogo" data-i18n-en="Brands in our catalogue">
          Marcas no nosso catálogo
        </h2>
      </div>

      <div class="ll-partners-grid">
        <a href="/marcas" class="ll-partner-item" title="SNOB Milano">
          <img class="ll-partner-logo snob" src="/partner-snob.jpeg" alt="SNOB Milano" />
        </a>
        <a href="/marcas" class="ll-partner-item" title="Ørgreen Optics">
          <img class="ll-partner-logo orgreen" src="/partner-orgreen.png" alt="Ørgreen Optics" />
        </a>
        <a href="/marcas" class="ll-partner-item" title="Einstoffen">
          <img class="ll-partner-logo einstoffen" src="/partner-einstoffen.png" alt="Einstoffen" />
        </a>
        <a href="/marcas" class="ll-partner-item" title="Rodenstock">
          <img class="ll-partner-logo rodenstock" src="/partner-rodenstock.png" alt="Rodenstock" />
        </a>
        <a href="/marcas" class="ll-partner-item" title="Eyepetizer">
          <img class="ll-partner-logo partner-folder-logo" src="/partners/eyepetizer.png" alt="Eyepetizer" />
        </a>
        <a href="/marcas" class="ll-partner-item" title="Longchamp">
          <img class="ll-partner-logo partner-folder-logo" src="/partners/longchamp.svg" alt="Longchamp" />
        </a>
        <a href="/marcas" class="ll-partner-item" title="Maison Bensimon">
          <img class="ll-partner-logo partner-folder-logo" src="/partners/maison-bensimon.jpeg" alt="Maison Bensimon" />
        </a>
      </div>
    </div>
  </section>


  {/* =========================================================================
      3. SECTION 3: NOVIDADES CAROUSEL (ARROWS & HEARTS)
      ========================================================================= */}
  <section class="ll-section">
    <div class="ll-container">
      
      <div class="ll-carousel-header">
        <div>
          <span class="ll-section-tag">NOVIDADES</span>
          <h2 class="ll-statement-title">
            Armações óticas com linhas intemporais e lentes de alta precisão.
          </h2>
        </div>

        <div class="ll-carousel-controls">
          <button class="ll-carousel-btn" data-carousel-prev aria-label="Produto anterior">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="19" y1="12" x2="5" y2="12"></line>
              <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
          </button>
          <button class="ll-carousel-btn" data-carousel-next aria-label="Próximo produto">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </button>
        </div>
      </div>

      <div class="ll-carousel-track-wrapper">
        <div class="ll-carousel-track" data-carousel-track>
          {novidades.map((p) => (
            <article class="ll-product-card" key={`nov-${p.id}`}>
              <button class="ll-card-fav" aria-label="Favorito">♡</button>
              <a href={`/produtos/${p.slug}`} class="ll-card-image-box">
                <img class="ll-card-img-main" src={p.image} alt={p.name} loading="lazy" />
                <img class="ll-card-img-hover" src={p.hover} alt={`${p.name} alternativa`} loading="lazy" />
              </a>
              <div class="ll-card-meta">
                <div class="ll-card-title-row">
                  <h3 class="ll-card-title"><a href={`/produtos/${p.slug}`}>{p.name}</a></h3>
                  <strong class="ll-card-price">{p.price} &euro;</strong>
                </div>
                <p class="ll-card-sub">{p.category} &bull; {p.shape}</p>
              </div>
            </article>
          ))}
        </div>
      </div>

    </div>
  </section>


  {/* =========================================================================
      4. SECTION 4: CINEMATIC EDITORIAL BANNER
      ========================================================================= */}
  <section class="ll-cinematic-editorial">
    <img
      class="ll-cinematic-img"
      src="/campagna-signature.jpeg"
      alt="Linhas Arquiteturais e Conforto Absoluto"
      loading="lazy"
    />

    <div class="ll-cinematic-index-list">
      <span>Desenho de Autor</span>
      <span>Rigor Estrutural</span>
      <span>Acabamento Manual</span>
    </div>

    <div class="ll-floating-white-card">
      <span class="ll-floating-tag">COLEÇÃO SIGNATURE 2026</span>
      <h2 class="ll-floating-title">
        Linhas Arquiteturais e Conforto Absoluto
      </h2>
      <p class="ll-floating-desc">
        Cada peça resulta de um desenho rigoroso e de uma seleção criteriosa de acetatos italianos de celulose e titânio ultraleve. Criadas para resistir ao tempo e afirmar a sua identidade visual.
      </p>
      <a href="/catalogo" class="ll-floating-link">
        Explorar a Coleção Signature &rarr;
      </a>
    </div>
  </section>


  {/* =========================================================================
      5. SECTION 5: RIGOR & MATÉRIA / SPECS
      ========================================================================= */}
  <section class="ll-section">
    <div class="ll-container">
      
      <div style="margin-bottom: 32px;">
        <span class="ll-section-tag">RIGOR &amp; MATÉRIA / ESPECIFICAÇÕES TÉCNICAS</span>
      </div>

      <div class="ll-craft-split-grid">
        {/* Left Side: 2 Images */}
        <div class="ll-craft-images-box">
          <div class="ll-craft-img-tile">
            <img
              src="/specs-anteo.jpeg"
              alt="SNOB Milano - Acuidade Visual & Lentes Zeiss"
              loading="lazy"
            />
          </div>
          <div class="ll-craft-img-tile">
            <img
              src="/specs-packaging.jpeg"
              alt="Acessórios e Embalagem SNOB Milano"
              loading="lazy"
            />
          </div>
        </div>

        {/* Right Side: 4 Technical Specs */}
        <div class="ll-craft-specs-list">
          <div class="ll-spec-item">
            <span class="ll-spec-num">ÓTICA</span>
            <h3 class="ll-spec-heading">Acuidade Visual &amp; Lentes Zeiss</h3>
            <p class="ll-spec-text">
              Equipamos todas as armações com lentes de alta definição ótica alemã, garantindo proteção ultravioleta absoluta e tratamentos antirreflexo multicamada.
            </p>
          </div>

          <div class="ll-spec-item">
            <span class="ll-spec-num">MATÉRIA</span>
            <h3 class="ll-spec-heading">Acetato Italiano Mazzucchelli</h3>
            <p class="ll-spec-text">
              Polímeros naturais biocompatíveis derivados do algodão, esculpidos e polidos à mão para um brilho profundo e toque suave sobre a pele.
            </p>
          </div>

          <div class="ll-spec-item">
            <span class="ll-spec-num">ESTRUTURA</span>
            <h3 class="ll-spec-heading">Titânio Cirúrgico Ultraleve</h3>
            <p class="ll-spec-text">
              Componentes de união e charneiras de alta precisão que oferecem resistência mecânica excepcional com um peso impercetível.
            </p>
          </div>

          <div class="ll-spec-item">
            <span class="ll-spec-num">CONSULTORIA</span>
            <h3 class="ll-spec-heading">Ajuste Facial Personalizado</h3>
            <p class="ll-spec-text">
              Análise morfológica cuidada para adequar a geometria, ponte nasal e comprimento de hastes à anatomia individual do seu rosto.
            </p>
          </div>
        </div>
      </div>

    </div>
  </section>


  {/* =========================================================================
      6. SECTION 6: CATÁLOGO / SELEÇÃO PERMANENTE
      ========================================================================= */}
  <section class="ll-section">
    <div class="ll-container">
      
      <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 32px;">
        <div>
          <span class="ll-section-tag">CATÁLOGO / SELEÇÃO PERMANENTE</span>
          <h2 class="ll-statement-title">
            Explore a nossa coleção completa de<br/>armações óticas e óculos de sol.
          </h2>
        </div>
        
        <a href="/catalogo" class="ll-floating-link" style="font-size: 13px;">
          Ver Todo o Catálogo &rarr;
        </a>
      </div>

      <div class="ll-catalog-mosaic-grid">
        {selecaoPermanente.map((p) => (
          <article class="ll-product-card" key={`perm-${p.id}`}>
            <a href={`/produtos/${p.slug}`} class="ll-card-image-box">
              <img class="ll-card-img-main" src={p.image} alt={p.name} loading="lazy" />
              <img class="ll-card-img-hover" src={p.hover} alt={`${p.name} alternativa`} loading="lazy" />
            </a>
            <div class="ll-card-meta">
              <div class="ll-card-title-row">
                <h3 class="ll-card-title"><a href={`/produtos/${p.slug}`}>{p.name}</a></h3>
                <strong class="ll-card-price">{p.price} &euro;</strong>
              </div>
              <p class="ll-card-sub">{p.category} &bull; {p.shape}</p>
            </div>
          </article>
        ))}
      </div>

    </div>
  </section>


  {/* =========================================================================
      7. SECTION 7: CURATED MOSAIC WITH QUOTE CARDS
      ========================================================================= */}
  <section class="ll-section" style="padding-top: 0;">
    <div class="ll-container">

      <div class="ll-catalog-mosaic-grid">
        
        {/* Row 1 */}
        <article class="ll-product-card">
          <a href={`/produtos/${products[4].slug}`} class="ll-card-image-box">
            <img class="ll-card-img-main" src={products[4].image} alt={products[4].name} loading="lazy" />
            <img class="ll-card-img-hover" src={products[4].hover} alt={products[4].name} loading="lazy" />
          </a>
          <div class="ll-card-meta">
            <div class="ll-card-title-row">
              <h3 class="ll-card-title"><a href={`/produtos/${products[4].slug}`}>{products[4].name}</a></h3>
              <strong class="ll-card-price">{products[4].price} &euro;</strong>
            </div>
            <p class="ll-card-sub">{products[4].category} &bull; {products[4].shape}</p>
          </div>
        </article>

        <div class="ll-catalog-quote-card">
          <p>
            &ldquo;A forma segue o olhar. Cada detalhe é desenhado com propósito e precisão.&rdquo;
          </p>
        </div>

        <article class="ll-product-card">
          <a href={`/produtos/${products[5].slug}`} class="ll-card-image-box">
            <img class="ll-card-img-main" src={products[5].image} alt={products[5].name} loading="lazy" />
            <img class="ll-card-img-hover" src={products[5].hover} alt={products[5].name} loading="lazy" />
          </a>
          <div class="ll-card-meta">
            <div class="ll-card-title-row">
              <h3 class="ll-card-title"><a href={`/produtos/${products[5].slug}`}>{products[5].name}</a></h3>
              <strong class="ll-card-price">{products[5].price} &euro;</strong>
            </div>
            <p class="ll-card-sub">{products[5].category} &bull; {products[5].shape}</p>
          </div>
        </article>

        <article class="ll-product-card">
          <a href={`/produtos/${products[9].slug}`} class="ll-card-image-box">
            <img class="ll-card-img-main" src={products[9].image} alt={products[9].name} loading="lazy" />
            <img class="ll-card-img-hover" src={products[9].hover} alt={products[9].name} loading="lazy" />
          </a>
          <div class="ll-card-meta">
            <div class="ll-card-title-row">
              <h3 class="ll-card-title"><a href={`/produtos/${products[9].slug}`}>{products[9].name}</a></h3>
              <strong class="ll-card-price">{products[9].price} &euro;</strong>
            </div>
            <p class="ll-card-sub">{products[9].category} &bull; {products[9].shape}</p>
          </div>
        </article>

        {/* Row 2 */}
        <article class="ll-product-card">
          <a href={`/produtos/${products[6].slug}`} class="ll-card-image-box">
            <img class="ll-card-img-main" src={products[6].image} alt={products[6].name} loading="lazy" />
            <img class="ll-card-img-hover" src={products[6].hover} alt={products[6].name} loading="lazy" />
          </a>
          <div class="ll-card-meta">
            <div class="ll-card-title-row">
              <h3 class="ll-card-title"><a href={`/produtos/${products[6].slug}`}>{products[6].name}</a></h3>
              <strong class="ll-card-price">{products[6].price} &euro;</strong>
            </div>
            <p class="ll-card-sub">{products[6].category} &bull; {products[6].shape}</p>
          </div>
        </article>

        <article class="ll-product-card">
          <a href={`/produtos/${products[7].slug}`} class="ll-card-image-box">
            <img class="ll-card-img-main" src={products[7].image} alt={products[7].name} loading="lazy" />
            <img class="ll-card-img-hover" src={products[7].hover} alt={products[7].name} loading="lazy" />
          </a>
          <div class="ll-card-meta">
            <div class="ll-card-title-row">
              <h3 class="ll-card-title"><a href={`/produtos/${products[7].slug}`}>{products[7].name}</a></h3>
              <strong class="ll-card-price">{products[7].price} &euro;</strong>
            </div>
            <p class="ll-card-sub">{products[7].category} &bull; {products[7].shape}</p>
          </div>
        </article>

        <article class="ll-product-card">
          <a href={`/produtos/${products[8].slug}`} class="ll-card-image-box">
            <img class="ll-card-img-main" src={products[8].image} alt={products[8].name} loading="lazy" />
            <img class="ll-card-img-hover" src={products[8].hover} alt={products[8].name} loading="lazy" />
          </a>
          <div class="ll-card-meta">
            <div class="ll-card-title-row">
              <h3 class="ll-card-title"><a href={`/produtos/${products[8].slug}`}>{products[8].name}</a></h3>
              <strong class="ll-card-price">{products[8].price} &euro;</strong>
            </div>
            <p class="ll-card-sub">{products[8].category} &bull; {products[8].shape}</p>
          </div>
        </article>

        <div class="ll-catalog-quote-card">
          <p>
            &ldquo;Óculos de autor com matérias nobres e fabrico independente.&rdquo;
          </p>
        </div>

      </div>

      <div class="ll-catalog-cta">
        <a href="/catalogo" class="ll-melin-btn">Ver catálogo completo</a>
      </div>

    </div>
  </section>


  {/* =========================================================================
      8. SECTION 8: HISTÓRIAS & ARQUIVO / DIÁRIO VISUAL
      ========================================================================= */}
  <section class="ll-section">
    <div class="ll-container">
      
      <div style="margin-bottom: 28px;">
        <span class="ll-section-tag">HISTÓRIAS &amp; ARQUIVO / DIÁRIO VISUAL</span>
      </div>

      <div class="ll-stories-mosaic">
        
        {/* Left Column: SNOB Hero Model */}
        <div class="ll-story-col-left">
          <img
            src="/story-butterfly.jpeg"
            alt="SNOB Milano Campanha"
            loading="lazy"
          />
        </div>

        {/* Middle Column: 3 Horizontal Feature Cards */}
        <div class="ll-story-col-mid">
          <a href="/sobre" class="ll-story-tile-compact">
            <img
              src="/story-case.jpeg"
              alt="Estojos em Couro Vegetal"
              loading="lazy"
            />
            <div class="ll-story-tile-info">
              <h4>Estojos em Couro Vegetal</h4>
              <p>Acessórios de proteção manufaturados com acabamento artesanal.</p>
            </div>
          </a>

          <a href="/catalogo" class="ll-story-tile-compact">
            <img
              src="/story-geometry.jpeg"
              alt="A Geometria do Rosto"
              loading="lazy"
            />
            <div class="ll-story-tile-info">
              <h4>A Geometria do Rosto</h4>
              <p>Como encontrar as proporções ideais para a sua estrutura facial.</p>
            </div>
          </a>

          <a href="/sobre" class="ll-story-tile-compact">
            <img
              src="/story-packaging.jpeg"
              alt="Embalagens de Colecionador"
              loading="lazy"
            />
            <div class="ll-story-tile-info">
              <h4>Embalagens de Colecionador</h4>
              <p>Cada armação inclui certificado de autenticidade e garantia.</p>
            </div>
          </a>
        </div>

        {/* Right Column: SNOB Model 2 */}
        <div class="ll-story-col-right">
          <img
            src="/story-anteo.jpeg"
            alt="SNOB Milano Coleção"
            loading="lazy"
          />
        </div>

      </div>

    </div>
  </section>


  {/* =========================================================================
      9. SECTION 9: PRE-FOOTER APPOINTMENT BANNER
      ========================================================================= */}
  <section class="ll-prefooter-banner">
    <img
      class="ll-prefooter-img"
      src="/campagna-prefooter.jpeg"
      alt="Atendimento Personalizado Ateliê Ótico"
      loading="lazy"
    />

    <div class="ll-prefooter-floating-card">
      <span class="ll-prefooter-tag">ATENDIMENTO EXCLUSIVO</span>
      <h2 class="ll-prefooter-title">Marque a sua Consulta</h2>
      <p class="ll-prefooter-desc">
        Sessões individuais de aconselhamento ótico e estético no nosso espaço na Madeira. Experimente toda a coleção com acompanhamento técnico dedicado.
      </p>
      <a href="/contactos" class="ll-prefooter-link">
        Agendar Sessão Individual &rarr;
      </a>
    </div>
  </section>

  <script is:inline src="/carousel.js"></script>
</StoreLayout>
