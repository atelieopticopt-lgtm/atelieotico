---
import StoreLayout from '../layouts/StoreLayout.astro';
import { products } from '../data/products';

// Diverse brand curation for homepage
const novidadesSlugs = [
  'snob-milano-chicca-snv126-c013z',
  'stock-1201043200178', // Persol
  'stock-1209643200516', // Salvatore Ferragamo
  'stock-1209643200525', // Longchamp
  'stock-1209643200514', // Karl Lagerfeld
  'stock-1209648801126', // Lacoste
  'stock-1201043200103', // Ray-Ban
  'stock-1209648801022'  // Zeiss
];

const selecaoSlugs = [
  'snob-milano-chicca-snv126-c008z', // SNOB Milano
  'stock-1201043200179', // Persol
  'stock-1209648800893', // Liu Jo
  'stock-1209648801140'  // Calvin Klein
];

const mosaicoSlugs = [
  'stock-1209648801147', // Salvatore Ferragamo
  'stock-1209643200526', // Longchamp
  'stock-1201043200108', // Ray-Ban
  'stock-1209643200515', // Karl Lagerfeld
  'stock-1209648801128', // Lacoste
  'snob-milano-chicca-snv126-c010z'  // SNOB Milano
];

const novidades = novidadesSlugs.map(s => products.find(p => p.slug === s)).filter(Boolean) as typeof products;
const selecaoPermanente = selecaoSlugs.map(s => products.find(p => p.slug === s)).filter(Boolean) as typeof products;
const mosaico = mosaicoSlugs.map(s => products.find(p => p.slug === s)).filter(Boolean) as typeof products;
---

<StoreLayout
  title="Ateliê Ótico — Design de Autor & Precisão Ótica na Madeira"
  description="Ótica de autor independente no Funchal, Madeira. Curadoria internacional de armações de autor, lentes oftálmicas de alta precisão e atendimento personalizado."
>

  {/* =========================================================================
      1. HERO SECTION
      ========================================================================= */}
  <section class="ll-melin-hero">
    <img
      class="ll-melin-hero-img"
      src="/campagna-hero.jpeg"
      alt="Design de Autor & Precisão Ótica — Ateliê Ótico"
      loading="eager"
      style="object-position: center 8%;"
    />
    <div class="ll-melin-hero-overlay"></div>

    <div class="ll-melin-hero-content">
      <span class="ll-melin-hero-tag">COLEÇÃO 2026</span>
      <h1 class="ll-melin-hero-title">
        Design de Autor &amp; Precisão Ótica
      </h1>
      <p class="ll-melin-hero-desc">
        Curadoria independente de armações óticas e óculos de sol desenhados para carácter e conforto diário.
      </p>

      <a href="/catalogo" class="ll-melin-btn">
        EXPLORAR CATÁLOGO
      </a>
    </div>
  </section>


  {/* =========================================================================
      2. BRANDS BAR DIRECTLY UNDER HERO (FULL 7 AUTHOR BRANDS + HEADER TAG)
      ========================================================================= */}
  <section class="ll-brands-strip-section">
    <div class="ll-container">
      
      <div class="ll-brands-strip-header">
        <h2 class="ll-statement-title" style="text-align: center; margin: 0 auto; text-transform: none;" data-i18n-pt="Marcas no nosso catálogo" data-i18n-en="Brands in our catalogue">
          Marcas no nosso catálogo
        </h2>
      </div>

      <div class="ll-partners-grid">
        <a href="/catalogo?marca=SNOB+Milano" class="ll-partner-item" title="SNOB Milano">
          <img class="ll-partner-logo snob" src="/partner-snob.jpeg" alt="SNOB Milano" />
        </a>
        <a href="/catalogo?marca=%C3%98rgreen+Optics" class="ll-partner-item" title="Ørgreen Optics">
          <img class="ll-partner-logo orgreen" src="/partner-orgreen.svg" alt="Ørgreen Optics" />
        </a>
        <a href="/catalogo?marca=Einstoffen" class="ll-partner-item" title="Einstoffen">
          <img class="ll-partner-logo einstoffen" src="/partner-einstoffen.png" alt="Einstoffen" />
        </a>
        <a href="/catalogo?marca=Rodenstock" class="ll-partner-item" title="Rodenstock">
          <img class="ll-partner-logo rodenstock" src="/partner-rodenstock.png" alt="Rodenstock" />
        </a>
        <a href="/catalogo?marca=Eyepetizer" class="ll-partner-item" title="Eyepetizer">
          <img class="ll-partner-logo partner-folder-logo" src="/partners/eyepetizer.png" alt="Eyepetizer" />
        </a>
        <a href="/catalogo?marca=Longchamp" class="ll-partner-item" title="Longchamp">
          <img class="ll-partner-logo partner-folder-logo" src="/partners/longchamp.svg" alt="Longchamp" />
        </a>
        <a href="/catalogo?marca=Maison+Bensimon" class="ll-partner-item" title="Maison Bensimon">
          <img class="ll-partner-logo partner-folder-logo" src="/partners/maison-bensimon.jpeg" alt="Maison Bensimon" />
        </a>
      </div>

    </div>
  </section>


  {/* =========================================================================
      3. SECTION 3: NOVIDADES CAROUSEL
      ========================================================================= */}
  <section class="ll-section">
    <div class="ll-container">
      
      <div class="ll-carousel-header">
        <div>
          <span class="ll-section-tag">SELEÇÃO / NOVIDADES</span>
          <h2 class="ll-statement-title">
            Armações óticas com linhas intemporais e lentes de alta precisão.
          </h2>
        </div>

        <div class="ll-carousel-controls">
          <button class="ll-carousel-btn" data-carousel-prev aria-label="Produto anterior">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="19" y1="12" x2="5" y2="12"></line>
              <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
          </button>
          <button class="ll-carousel-btn" data-carousel-next aria-label="Próximo produto">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </button>
        </div>
      </div>

      <div class="ll-carousel-track-wrapper">
        <div class="ll-carousel-track" data-carousel-track>
          {novidades.map((p) => (
            <article class="ll-product-card" key={`nov-${p.id}`}>
              <button
                class="favorite ll-card-fav"
                type="button"
                data-favorite={p.slug}
                aria-label={`Guardar ${p.name} nos favoritos`}
                title="Favorito"
              >
                <svg class="star-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                </svg>
              </button>
              <a href={`/produtos/${p.slug}`} class="ll-card-image-box">
                <img class="ll-card-img-main" src={p.image} alt={p.name} loading="lazy" />
                {p.hover && p.hover !== p.image && (
                  <img class="ll-card-img-hover" src={p.hover} alt={`${p.name} alternativa`} loading="lazy" />
                )}
              </a>
              <div class="ll-card-meta">
                <div class="ll-card-title-row">
                  <h3 class="ll-card-title"><a href={`/produtos/${p.slug}`}>{p.name}</a></h3>
                  <strong class="ll-card-price">{p.price} &euro;</strong>
                </div>
                <p class="ll-card-sub">{p.brand} &bull; {p.shape}</p>
              </div>
            </article>
          ))}
        </div>
      </div>

    </div>
  </section>


  {/* =========================================================================
      4. SECTION 4: CINEMATIC EDITORIAL BANNER
      ========================================================================= */}
  <section class="ll-cinematic-editorial">
    <img
      class="ll-cinematic-img"
      src="/campagna-signature.jpeg"
      alt="Linhas Arquiteturais e Conforto Absoluto"
      loading="lazy"
    />

    <div class="ll-cinematic-index-list">
      <span>Desenho de Autor</span>
      <span>Rigor Estrutural</span>
      <span>Acabamento Manual</span>
    </div>

    <div class="ll-floating-white-card">
      <span class="ll-floating-tag">COLEÇÃO SIGNATURE 2026</span>
      <h2 class="ll-floating-title">
        Linhas Arquiteturais e Conforto Absoluto
      </h2>
      <p class="ll-floating-desc">
        Cada peça resulta de um desenho rigoroso e de uma seleção criteriosa de acetatos italianos de celulose e titânio ultraleve. Criadas para resistir ao tempo e afirmar a sua identidade visual.
      </p>
      <a href="/catalogo" class="ll-floating-link">
        Explorar a Coleção Signature &rarr;
      </a>
    </div>
  </section>


  {/* =========================================================================
      5. SECTION 5: RIGOR & MATÉRIA / SPECS
      ========================================================================= */}
  <section class="ll-section">
    <div class="ll-container">
      
      <div style="margin-bottom: 32px;">
        <span class="ll-section-tag">RIGOR &amp; MATÉRIA / ESPECIFICAÇÕES TÉCNICAS</span>
      </div>

      <div class="ll-craft-split-grid">
        <div class="ll-craft-images-box">
          <div class="ll-craft-img-tile">
            <img
              src="/specs-anteo.jpeg"
              alt="SNOB Milano - Acuidade Visual & Lentes Zeiss"
              loading="lazy"
            />
          </div>
          <div class="ll-craft-img-tile">
            <img
              src="/specs-packaging.jpeg"
              alt="Acessórios e Embalagem SNOB Milano"
              loading="lazy"
            />
          </div>
        </div>

        <div class="ll-craft-specs-list">
          <div class="ll-spec-item">
            <span class="ll-spec-num">ÓTICA</span>
            <h3 class="ll-spec-heading">Acuidade Visual &amp; Lentes Zeiss</h3>
            <p class="ll-spec-text">
              Equipamos todas as armações com lentes de alta definição ótica alemã, garantindo proteção ultravioleta absoluta e tratamentos antirreflexo multicamada.
            </p>
          </div>

          <div class="ll-spec-item">
            <span class="ll-spec-num">MATÉRIA</span>
            <h3 class="ll-spec-heading">Acetato Italiano Mazzucchelli</h3>
            <p class="ll-spec-text">
              Polímeros naturais biocompatíveis derivados do algodão, esculpidos e polidos à mão para um brilho profundo e toque suave sobre a pele.
            </p>
          </div>

          <div class="ll-spec-item">
            <span class="ll-spec-num">ESTRUTURA</span>
            <h3 class="ll-spec-heading">Titânio Cirúrgico Ultraleve</h3>
            <p class="ll-spec-text">
              Componentes de união e charneiras de alta precisão que oferecem resistência mecânica excepcional com um peso impercetível.
            </p>
          </div>

          <div class="ll-spec-item">
            <span class="ll-spec-num">CONSULTORIA</span>
            <h3 class="ll-spec-heading">Ajuste Facial Personalizado</h3>
            <p class="ll-spec-text">
              Análise morfológica cuidada para adequar a geometria, ponte nasal e comprimento de hastes à anatomia individual do seu rosto.
            </p>
          </div>
        </div>
      </div>

    </div>
  </section>


  {/* =========================================================================
      6. SECTION 6: CATÁLOGO / SELEÇÃO PERMANENTE
      ========================================================================= */}
  <section class="ll-section">
    <div class="ll-container">
      
      <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 32px;">
        <div>
          <span class="ll-section-tag">CATÁLOGO / SELEÇÃO PERMANENTE</span>
          <h2 class="ll-statement-title">
            Explore a nossa coleção completa de<br/>armações óticas e óculos de sol.
          </h2>
        </div>
        
        <a href="/catalogo" class="ll-floating-link" style="font-size: 13px;">
          Ver Todo o Catálogo &rarr;
        </a>
      </div>

      <div class="ll-catalog-mosaic-grid">
        {selecaoPermanente.map((p) => (
          <article class="ll-product-card" key={`perm-${p.id}`}>
            <a href={`/produtos/${p.slug}`} class="ll-card-image-box">
              <img class="ll-card-img-main" src={p.image} alt={p.name} loading="lazy" />
              {p.hover && p.hover !== p.image && (
                <img class="ll-card-img-hover" src={p.hover} alt={`${p.name} alternativa`} loading="lazy" />
              )}
            </a>
            <div class="ll-card-meta">
              <div class="ll-card-title-row">
                <h3 class="ll-card-title"><a href={`/produtos/${p.slug}`}>{p.name}</a></h3>
                <strong class="ll-card-price">{p.price} &euro;</strong>
              </div>
              <p class="ll-card-sub">{p.brand} &bull; {p.shape}</p>
            </div>
          </article>
        ))}
      </div>

    </div>
  </section>


  {/* =========================================================================
      7. SECTION 7: CURATED MOSAIC WITH QUOTE CARDS
      ========================================================================= */}
  <section class="ll-section" style="padding-top: 0;">
    <div class="ll-container">

      <div class="ll-catalog-mosaic-grid">
        
        {/* Row 1 */}
        <article class="ll-product-card">
          <button class="favorite ll-card-fav" type="button" data-favorite={mosaico[0].slug} aria-label={`Guardar ${mosaico[0].name} nos favoritos`} title="Favorito">
            <svg class="star-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
            </svg>
          </button>
          <a href={`/produtos/${mosaico[0].slug}`} class="ll-card-image-box">
            <img class="ll-card-img-main" src={mosaico[0].image} alt={mosaico[0].name} loading="lazy" />
            {mosaico[0].hover && mosaico[0].hover !== mosaico[0].image && (
              <img class="ll-card-img-hover" src={mosaico[0].hover} alt={mosaico[0].name} loading="lazy" />
            )}
          </a>
          <div class="ll-card-meta">
            <div class="ll-card-title-row">
              <h3 class="ll-card-title"><a href={`/produtos/${mosaico[0].slug}`}>{mosaico[0].name}</a></h3>
              <strong class="ll-card-price">{mosaico[0].price} &euro;</strong>
            </div>
            <p class="ll-card-sub">{mosaico[0].brand} &bull; {mosaico[0].shape}</p>
          </div>
        </article>

        <div class="ll-catalog-quote-card">
          <p>
            &ldquo;A forma segue o olhar. Cada detalhe é desenhado com propósito e precisão.&rdquo;
          </p>
        </div>

        <article class="ll-product-card">
          <button class="favorite ll-card-fav" type="button" data-favorite={mosaico[1].slug} aria-label={`Guardar ${mosaico[1].name} nos favoritos`} title="Favorito">
            <svg class="star-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
            </svg>
          </button>
          <a href={`/produtos/${mosaico[1].slug}`} class="ll-card-image-box">
            <img class="ll-card-img-main" src={mosaico[1].image} alt={mosaico[1].name} loading="lazy" />
            {mosaico[1].hover && mosaico[1].hover !== mosaico[1].image && (
              <img class="ll-card-img-hover" src={mosaico[1].hover} alt={mosaico[1].name} loading="lazy" />
            )}
          </a>
          <div class="ll-card-meta">
            <div class="ll-card-title-row">
              <h3 class="ll-card-title"><a href={`/produtos/${mosaico[1].slug}`}>{mosaico[1].name}</a></h3>
              <strong class="ll-card-price">{mosaico[1].price} &euro;</strong>
            </div>
            <p class="ll-card-sub">{mosaico[1].brand} &bull; {mosaico[1].shape}</p>
          </div>
        </article>

        <article class="ll-product-card">
          <button class="favorite ll-card-fav" type="button" data-favorite={mosaico[2].slug} aria-label={`Guardar ${mosaico[2].name} nos favoritos`} title="Favorito">
            <svg class="star-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
            </svg>
          </button>
          <a href={`/produtos/${mosaico[2].slug}`} class="ll-card-image-box">
            <img class="ll-card-img-main" src={mosaico[2].image} alt={mosaico[2].name} loading="lazy" />
            {mosaico[2].hover && mosaico[2].hover !== mosaico[2].image && (
              <img class="ll-card-img-hover" src={mosaico[2].hover} alt={mosaico[2].name} loading="lazy" />
            )}
          </a>
          <div class="ll-card-meta">
            <div class="ll-card-title-row">
              <h3 class="ll-card-title"><a href={`/produtos/${mosaico[2].slug}`}>{mosaico[2].name}</a></h3>
              <strong class="ll-card-price">{mosaico[2].price} &euro;</strong>
            </div>
            <p class="ll-card-sub">{mosaico[2].brand} &bull; {mosaico[2].shape}</p>
          </div>
        </article>

        {/* Row 2 */}
        <article class="ll-product-card">
          <button class="favorite ll-card-fav" type="button" data-favorite={mosaico[3].slug} aria-label={`Guardar ${mosaico[3].name} nos favoritos`} title="Favorito">
            <svg class="star-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
            </svg>
          </button>
          <a href={`/produtos/${mosaico[3].slug}`} class="ll-card-image-box">
            <img class="ll-card-img-main" src={mosaico[3].image} alt={mosaico[3].name} loading="lazy" />
            {mosaico[3].hover && mosaico[3].hover !== mosaico[3].image && (
              <img class="ll-card-img-hover" src={mosaico[3].hover} alt={mosaico[3].name} loading="lazy" />
            )}
          </a>
          <div class="ll-card-meta">
            <div class="ll-card-title-row">
              <h3 class="ll-card-title"><a href={`/produtos/${mosaico[3].slug}`}>{mosaico[3].name}</a></h3>
              <strong class="ll-card-price">{mosaico[3].price} &euro;</strong>
            </div>
            <p class="ll-card-sub">{mosaico[3].brand} &bull; {mosaico[3].shape}</p>
          </div>
        </article>

        <article class="ll-product-card">
          <button class="favorite ll-card-fav" type="button" data-favorite={mosaico[4].slug} aria-label={`Guardar ${mosaico[4].name} nos favoritos`} title="Favorito">
            <svg class="star-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
            </svg>
          </button>
          <a href={`/produtos/${mosaico[4].slug}`} class="ll-card-image-box">
            <img class="ll-card-img-main" src={mosaico[4].image} alt={mosaico[4].name} loading="lazy" />
            {mosaico[4].hover && mosaico[4].hover !== mosaico[4].image && (
              <img class="ll-card-img-hover" src={mosaico[4].hover} alt={mosaico[4].name} loading="lazy" />
            )}
          </a>
          <div class="ll-card-meta">
            <div class="ll-card-title-row">
              <h3 class="ll-card-title"><a href={`/produtos/${mosaico[4].slug}`}>{mosaico[4].name}</a></h3>
              <strong class="ll-card-price">{mosaico[4].price} &euro;</strong>
            </div>
            <p class="ll-card-sub">{mosaico[4].brand} &bull; {mosaico[4].shape}</p>
          </div>
        </article>

        <article class="ll-product-card">
          <button class="favorite ll-card-fav" type="button" data-favorite={mosaico[5].slug} aria-label={`Guardar ${mosaico[5].name} nos favoritos`} title="Favorito">
            <svg class="star-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
            </svg>
          </button>
          <a href={`/produtos/${mosaico[5].slug}`} class="ll-card-image-box">
            <img class="ll-card-img-main" src={mosaico[5].image} alt={mosaico[5].name} loading="lazy" />
            {mosaico[5].hover && mosaico[5].hover !== mosaico[5].image && (
              <img class="ll-card-img-hover" src={mosaico[5].hover} alt={mosaico[5].name} loading="lazy" />
            )}
          </a>
          <div class="ll-card-meta">
            <div class="ll-card-title-row">
              <h3 class="ll-card-title"><a href={`/produtos/${mosaico[5].slug}`}>{mosaico[5].name}</a></h3>
              <strong class="ll-card-price">{mosaico[5].price} &euro;</strong>
            </div>
            <p class="ll-card-sub">{mosaico[5].brand} &bull; {mosaico[5].shape}</p>
          </div>
        </article>

        <div class="ll-catalog-quote-card">
          <p>
            &ldquo;Óculos de autor com matérias nobres e fabrico independente.&rdquo;
          </p>
        </div>

      </div>

      {/* Button: VER CATÁLOGO COMPLETO */}
      <div style="text-align: center; margin-top: 48px; margin-bottom: 24px;">
        <a
          href="/catalogo"
          class="rect black"
          style="min-width: 260px; height: 50px; display: inline-flex; justify-content: center; align-items: center; text-decoration: none; font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase;"
          data-i18n-pt="VER CATÁLOGO COMPLETO"
          data-i18n-en="VIEW FULL CATALOG"
        >
          VER CATÁLOGO COMPLETO
        </a>
      </div>

    </div>
  </section>


