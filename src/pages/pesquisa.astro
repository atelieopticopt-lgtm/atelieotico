---
import StoreLayout from '../layouts/StoreLayout.astro';import ProductCard from '../components/ProductCard.astro';import {products} from '../data/products';
---
<StoreLayout title="Pesquisa | Ateliê Ótico"><div class="content-page"><p>PESQUISA</p><h1>O que procura?</h1><div class="search-box"><input type="search" data-search placeholder="Pesquisar modelos, formas ou materiais" autofocus/><button>PESQUISAR</button></div><div class="product-grid" data-search-results>{products.map(p=><ProductCard product={p}/>)}</div><p class="empty-results">Sem resultados para esta pesquisa.</p></div><script is:inline>const input=document.querySelector('[data-search]'),cards=[...document.querySelectorAll('[data-search-results] .store-card')];input?.addEventListener('input',()=>{const q=input.value.toLowerCase().trim();let n=0;cards.forEach(c=>{const show=!q||c.textContent.toLowerCase().includes(q);c.hidden=!show;if(show)n++});document.querySelector('.empty-results').style.display=n?'none':'block'})</script></StoreLayout>
