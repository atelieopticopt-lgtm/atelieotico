---
import StoreLayout from '../layouts/StoreLayout.astro';
---

<StoreLayout 
  title="Contactos & Marcações | Ateliê Ótico — Funchal, Madeira"
  description="Contacte o Ateliê Ótico no Funchal ou marque a sua consulta e experimentação de armações de autor."
>
  <div class="contact-page-wrapper">
    <article class="editorial-page">
      
      <header class="editorial-page-header">
        <span class="ll-section-tag" data-i18n-pt="ATENDIMENTO PERSONALIZADO" data-i18n-en="PERSONAL CONSULTATION">ATENDIMENTO PERSONALIZADO</span>
        <h1 class="editorial-page-title" data-i18n-pt="Vamos conversar." data-i18n-en="Let's talk.">Vamos conversar.</h1>
        <p class="editorial-page-subtitle" data-i18n-pt="Visite o nosso espaço no Funchal ou envie-nos uma mensagem para aconselhamento ótico à sua medida." data-i18n-en="Visit our boutique in Funchal or send us a message for tailored optical advice.">
          Visite o nosso espaço no Funchal ou envie-nos uma mensagem para aconselhamento ótico à sua medida.
        </p>
      </header>

      <div class="editorial-contact-grid">
        
        {/* Left Column: Boutique Information & Hours */}
        <div class="editorial-contact-info">
          
          <div class="contact-info-block">
            <h2 data-i18n-pt="Boutique & Localização" data-i18n-en="Boutique & Location">Boutique &amp; Localização</h2>
            <p class="contact-address">
              <strong>Ateliê Ótico</strong><br/>
              Rua da Conceição, Praça do Carmo 29B<br/>
              9050-026 Funchal, Região Autónoma da Madeira
            </p>
            <a 
              href="https://maps.google.com/?q=Rua+da+Concei%C3%A7%C3%A3o+Pra%C3%A7a+do+Carmo+29B+Funchal" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="contact-map-link"
              data-i18n-pt="Abrir no Google Maps →"
              data-i18n-en="Open in Google Maps →"
            >
              Abrir no Google Maps &rarr;
            </a>
          </div>

          <div class="contact-info-block">
            <h2 data-i18n-pt="Contacto Direto" data-i18n-en="Direct Contact">Contacto Direto</h2>
            <p>
              <span>Telefone / WhatsApp:</span> 
              <a href="tel:+351964993767" class="contact-direct-link"><strong>964 993 767</strong></a>
            </p>
            <p>
              <span>E-mail:</span> 
              <a href="mailto:apoio@atelieotico.com" class="contact-direct-link"><strong>apoio@atelieotico.com</strong></a>
            </p>
          </div>

          <div class="contact-info-block">
            <h2 data-i18n-pt="Horário de Atendimento" data-i18n-en="Opening Hours">Horário de Atendimento</h2>
            <div class="ll-hours-list">
              <div class="ll-hours-row">
                <span data-i18n-pt="Segunda a Sexta" data-i18n-en="Monday to Friday">Segunda a Sexta</span>
                <strong>09:00 – 19:00</strong>
              </div>
              <div class="ll-hours-row">
                <span data-i18n-pt="Sábado" data-i18n-en="Saturday">Sábado</span>
                <strong>09:00 – 13:00</strong>
              </div>
              <div class="ll-hours-row">
                <span data-i18n-pt="Domingo" data-i18n-en="Sunday">Domingo</span>
                <strong data-i18n-pt="Encerrado" data-i18n-en="Closed">Encerrado</strong>
              </div>
            </div>
          </div>

          <div class="contact-boutique-img-wrap">
            <img src="/campagna-prefooter.jpeg" alt="Boutique Ateliê Ótico Funchal" class="contact-boutique-img" />
          </div>

        </div>

        {/* Right Column: Contact & Appointment Form */}
        <div class="editorial-contact-form-wrap">
          <h2 class="form-card-title" data-i18n-pt="Envie-nos uma Mensagem" data-i18n-en="Send us a Message">Envie-nos uma Mensagem</h2>
          <p class="form-card-sub" data-i18n-pt="Preencha o formulário abaixo e entraremos em contacto consigo com a maior brevidade." data-i18n-en="Fill in the form below and we will get in touch with you shortly.">
            Preencha o formulário abaixo e entraremos em contacto consigo com a maior brevidade.
          </p>

          <form class="editorial-form contact-form">
            <div class="form-group">
              <label for="nome" data-i18n-pt="Nome Completo *" data-i18n-en="Full Name *">Nome Completo *</label>
              <input id="nome" required name="nome" type="text" placeholder="Ex: Maria Santos" />
            </div>

            <div class="form-grid-2">
              <div class="form-group">
                <label for="email" data-i18n-pt="Endereço de E-mail *" data-i18n-en="Email Address *">Endereço de E-mail *</label>
                <input id="email" required type="email" name="email" placeholder="email@exemplo.pt" />
              </div>
              <div class="form-group">
                <label for="telefone" data-i18n-pt="Telefone / WhatsApp" data-i18n-en="Phone / WhatsApp">Telefone / WhatsApp</label>
                <input id="telefone" type="tel" name="telefone" placeholder="+351 9xx xxx xxx" />
              </div>
            </div>

            <div class="form-group">
              <label for="assunto" data-i18n-pt="Motivo do Contacto" data-i18n-en="Reason for Contact">Motivo do Contacto</label>
              <select id="assunto" name="assunto">
                <option value="consulta" data-i18n-pt="Marcação de Consulta de Optometria" data-i18n-en="Optometry Appointment">Marcação de Consulta de Optometria</option>
                <option value="duvida" data-i18n-pt="Dúvida sobre Modelo / Armação" data-i18n-en="Question about a Frame / Model">Dúvida sobre Modelo / Armação</option>
                <option value="encomenda" data-i18n-pt="Estado de Encomenda" data-i18n-en="Order Status">Estado de Encomenda</option>
                <option value="outro" data-i18n-pt="Outro Assunto" data-i18n-en="Other Inquiry">Outro Assunto</option>
              </select>
            </div>

            <div class="form-group">
              <label for="mensagem" data-i18n-pt="Mensagem *" data-i18n-en="Message *">Mensagem *</label>
              <textarea id="mensagem" required name="mensagem" rows="4" placeholder="Como podemos ajudar? Partilhe os seus detalhes ou horário de preferência..."></textarea>
            </div>

            <button class="ll-melin-btn rect black" type="submit" data-i18n-pt="ENVIAR MENSAGEM" data-i18n-en="SEND MESSAGE">
              ENVIAR MENSAGEM
            </button>

            <div id="contact-form-status" class="form-status-msg" style="display: none;"></div>
          </form>
        </div>

      </div>

    </article>
  </div>

  <script is:inline>
    document.querySelector('.contact-form')?.addEventListener('submit', (e) => {
      e.preventDefault();
      const statusEl = document.getElementById('contact-form-status');
      if (statusEl) {
        statusEl.style.display = 'block';
        statusEl.textContent = '✓ Obrigado. A sua mensagem foi enviada com sucesso. Entraremos em contacto consigo brevemente.';
      }
      e.currentTarget.reset();
    });
  </script>
</StoreLayout>
