---
import StoreLayout from '../layouts/StoreLayout.astro';
---

<StoreLayout 
  title="Contactos & Marcações | Ateliê Ótico — Funchal, Madeira"
  description="Contacte o Ateliê Ótico no Funchal ou marque a sua consulta e experimentação de armações de autor."
>
  <article class="content-page">
    <p class="content-tag" data-i18n-pt="ATENDIMENTO PERSONALIZADO" data-i18n-en="PERSONAL CONSULTATION">ATENDIMENTO PERSONALIZADO</p>
    <h1 data-i18n-pt="Contactos & Marcações" data-i18n-en="Contact & Appointments">Contactos &amp; Marcações</h1>

    <p data-i18n-pt="Visite o nosso espaço no Funchal ou envie-nos uma mensagem para aconselhamento ótico à sua medida." data-i18n-en="Visit our boutique in Funchal or send us a message for tailored optical advice.">
      Visite o nosso espaço no Funchal ou envie-nos uma mensagem para aconselhamento ótico à sua medida.
    </p>

    <h2 data-i18n-pt="Espaço & Localização" data-i18n-en="Boutique & Location">Espaço &amp; Localização</h2>
    <p>
      <strong>Ateliê Ótico</strong><br/>
      Rua da Conceição, Praça do Carmo 29B<br/>
      9050-026 Funchal, Região Autónoma da Madeira
    </p>
    <p>
      <a href="https://maps.google.com/?q=Rua+da+Concei%C3%A7%C3%A3o+Pra%C3%A7a+do+Carmo+29B+Funchal" target="_blank" rel="noopener noreferrer" style="color: #000; font-weight: 700; text-decoration: underline;" data-i18n-pt="Abrir no Google Maps →" data-i18n-en="Open in Google Maps →">
        Abrir no Google Maps &rarr;
      </a>
    </p>

    <h2 data-i18n-pt="Contacto Direto" data-i18n-en="Direct Contact">Contacto Direto</h2>
    <p>Telefone / WhatsApp: <a href="tel:+351964993767" style="color: #000; text-decoration: none;"><strong>964 993 767</strong></a></p>
    <p>E-mail: <a href="mailto:apoio@atelieotico.com" style="color: #000; text-decoration: none;"><strong>apoio@atelieotico.com</strong></a></p>

    <h2 data-i18n-pt="Horário" data-i18n-en="Opening Hours">Horário</h2>
    <p>
      <strong>Segunda a Sexta:</strong> 09:00 – 19:00<br/>
      <strong>Sábado:</strong> 09:00 – 13:00<br/>
      <strong>Domingo:</strong> Encerrado
    </p>

    <h2 data-i18n-pt="Envie-nos uma Mensagem" data-i18n-en="Send us a Message">Envie-nos uma Mensagem</h2>
    <form class="contact-form" style="display: flex; flex-direction: column; gap: 14px; margin-top: 16px;">
      <div style="display: flex; flex-direction: column; gap: 6px;">
        <label for="nome" style="font-size: 11.5px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;" data-i18n-pt="Nome Completo *" data-i18n-en="Full Name *">Nome Completo *</label>
        <input 
          id="nome" 
          required 
          name="nome" 
          type="text" 
          placeholder="O seu nome" 
          data-i18n-placeholder-pt="O seu nome" 
          data-i18n-placeholder-en="Your name" 
          style="height: 46px; padding: 0 14px; border: 1.5px solid #000; background: #fff; font-size: 14px; font-family: inherit; outline: none; border-radius: 0;" 
        />
      </div>

      <div style="display: flex; flex-direction: column; gap: 6px;">
        <label for="email" style="font-size: 11.5px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;" data-i18n-pt="Endereço de E-mail *" data-i18n-en="Email Address *">Endereço de E-mail *</label>
        <input 
          id="email" 
          required 
          type="email" 
          name="email" 
          placeholder="email@exemplo.pt" 
          data-i18n-placeholder-pt="email@exemplo.pt" 
          data-i18n-placeholder-en="email@example.com" 
          style="height: 46px; padding: 0 14px; border: 1.5px solid #000; background: #fff; font-size: 14px; font-family: inherit; outline: none; border-radius: 0;" 
        />
      </div>

      <div style="display: flex; flex-direction: column; gap: 6px;">
        <label for="telefone" style="font-size: 11.5px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;" data-i18n-pt="Telefone / WhatsApp" data-i18n-en="Phone / WhatsApp">Telefone / WhatsApp</label>
        <input 
          id="telefone" 
          type="tel" 
          name="telefone" 
          placeholder="+351 9xx xxx xxx" 
          data-i18n-placeholder-pt="+351 9xx xxx xxx" 
          data-i18n-placeholder-en="+351 9xx xxx xxx" 
          style="height: 46px; padding: 0 14px; border: 1.5px solid #000; background: #fff; font-size: 14px; font-family: inherit; outline: none; border-radius: 0;" 
        />
      </div>

      <div style="display: flex; flex-direction: column; gap: 6px;">
        <label for="mensagem" style="font-size: 11.5px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;" data-i18n-pt="Mensagem *" data-i18n-en="Message *">Mensagem *</label>
        <textarea 
          id="mensagem" 
          required 
          name="mensagem" 
          rows="4" 
          placeholder="Como podemos ajudar?" 
          data-i18n-placeholder-pt="Como podemos ajudar?" 
          data-i18n-placeholder-en="How can we help you?" 
          style="padding: 12px 14px; border: 1.5px solid #000; background: #fff; font-size: 14px; font-family: inherit; outline: none; resize: vertical; border-radius: 0;"
        ></textarea>
      </div>

      <button class="rect black" type="submit" style="height: 48px; width: 100%; justify-content: center; margin-top: 8px;" data-i18n-pt="ENVIAR MENSAGEM" data-i18n-en="SEND MESSAGE">ENVIAR MENSAGEM</button>
      <div id="contact-form-status" style="display: none; padding: 12px; background: #f0fdf4; border: 1px solid #86efac; color: #15803d; font-size: 13.5px; font-weight: 700;"></div>
    </form>
  </article>

  <script is:inline>
    document.querySelector('.contact-form')?.addEventListener('submit', (e) => {
      e.preventDefault();
      const statusEl = document.getElementById('contact-form-status');
      if (statusEl) {
        statusEl.style.display = 'block';
        statusEl.textContent = '✓ Mensagem enviada com sucesso. Entraremos em contacto brevemente.';
      }
      e.currentTarget.reset();
    });
  </script>
</StoreLayout>
