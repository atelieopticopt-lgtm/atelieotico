        <button type="button" id="btn-close-modal" class="admin-modal-close" title="Fechar (ESC)">&times;</button>
      </div>
      <form id="product-modal-form" class="admin-modal-body">
        <input type="hidden" id="modal-product-id" />
        
        <div class="form-grid-2">
          <div class="admin-form-group">
            <label>Nome do Produto *</label>
            <input type="text" id="modal-name" required placeholder="Ex: SNOB Milano Chicca" />
          </div>
          <div class="admin-form-group">
            <label>Marca *</label>
            <select id="modal-brand" required>
              {brands.map(b => <option value={b}>{b}</option>)}
            </select>
          </div>
        </div>

        <div class="form-grid-2">
          <div class="admin-form-group">
            <label>Código / SKU *</label>
            <input type="text" id="modal-sku" required placeholder="Ex: SNV126C013Z" />
          </div>
          <div class="admin-form-group">
            <label>Preço de Venda / PVP (€) *</label>
            <input type="number" id="modal-price" required min="0" placeholder="240" />
          </div>
        </div>

        <div class="form-grid-2">
          <div class="admin-form-group">
            <label>Quantidade em Stock (unidades) *</label>
            <input type="number" id="modal-stock" required min="0" placeholder="10" />
          </div>
          <div class="admin-form-group">
            <label>Estado de Disponibilidade na Loja *</label>
            <select id="modal-available">
              <option value="true">🟢 Disponível para Venda</option>
              <option value="false">⚪ Indisponível / Pausado</option>
            </select>
          </div>
        </div>

        <div class="form-grid-2">
          <div class="admin-form-group">
            <label>Categoria *</label>
            <select id="modal-category">
              <option value="Armações óticas">Armações óticas</option>
              <option value="Óculos de sol">Óculos de sol</option>
            </select>
          </div>
          <div class="admin-form-group">
            <label>Formato *</label>
            <select id="modal-shape">
              <option value="Redonda">Redonda</option>
              <option value="Retangular">Retangular</option>
              <option value="Quadrada">Quadrada</option>
              <option value="Cat-eye">Cat-eye</option>
              <option value="Aviador">Aviador</option>
              <option value="Oval">Oval</option>
            </select>
          </div>
        </div>

        <div class="form-grid-2">
          <div class="admin-form-group">
            <label>Material</label>
            <select id="modal-material">
              <option value="Acetato">Acetato</option>
              <option value="Titânio">Titânio</option>
              <option value="Metal">Metal</option>
            </select>
          </div>
          <div class="admin-form-group">
            <label>Cor</label>
            <input type="text" id="modal-color" placeholder="Ex: Bordeaux / Translúcido" />
          </div>
        </div>

        {/* Visual Photos Manager with Upload & Drag / Reordering */}
        <div class="admin-form-group" style="margin-top: 10px;">
          <div class="photos-section-header">
            <label>Galeria de Fotografias (Arraste ou use as setas para ordenar &bull; A 1ª é a Principal, a 2ª é Hover)</label>
            <button type="button" id="btn-modal-add-photo" class="btn-add-photo-text">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
              <span>Carregar Foto</span>
            </button>
            <input type="file" id="modal-photo-file-input" accept="image/*" multiple style="display: none;" />
          </div>

          <div class="modal-photos-gallery" id="modal-photos-gallery-list">
            {/* Populated by JS */}
          </div>
        </div>

        <div class="admin-form-group">
          <label>Descrição do Produto</label>
          <textarea id="modal-desc" rows="2" placeholder="Detalhes técnicos, acabamento manual..."></textarea>
        </div>

        <div class="admin-modal-foot">
          <button type="button" id="btn-cancel-modal" class="btn-action-edit">Cancelar (ESC)</button>
          <button type="submit" class="btn-save-modal">Guardar Alterações</button>
        </div>
      </form>
    </div>
  </div>

  {/* MODAL: CREATE / EDIT DISCOUNT CODE */}
  <div id="modal-discount" class="admin-modal-overlay" style="display: none;">
    <div class="admin-modal-card">
      <div class="admin-modal-head">
        <h3 id="modal-discount-title">Criar Novo Código de Desconto</h3>
        <button type="button" class="admin-modal-close" id="btn-close-discount-modal">&times;</button>
      </div>
      <form id="form-discount-modal" class="admin-modal-body">
        <input type="hidden" id="discount-modal-id" value="" />
        
        <div class="admin-form-group">
          <label for="discount-code-input">Código do Cupão * (Ex: VERAO2026)</label>
          <input type="text" id="discount-code-input" required placeholder="ATELIE10" style="text-transform: uppercase; font-family: monospace; font-weight: 700; letter-spacing: 1px;" />
        </div>

        <div class="form-grid-2">
          <div class="admin-form-group">
            <label for="discount-type-select">Tipo de Desconto *</label>
            <select id="discount-type-select">
              <option value="percent">Percentagem (%)</option>
              <option value="fixed">Valor Fixo (€)</option>
            </select>
          </div>

          <div class="admin-form-group">
            <label for="discount-val-input" id="discount-val-label">Valor do Desconto (%) *</label>
            <input type="number" id="discount-val-input" required min="1" step="0.5" placeholder="10" />
          </div>
        </div>

        <div class="form-grid-2">
          <div class="admin-form-group">
            <label for="discount-min-order">Valor Mínimo de Compra (€)</label>
            <input type="number" id="discount-min-order" min="0" step="1" value="0" placeholder="0 (Sem mínimo)" />
          </div>

          <div class="admin-form-group">
            <label for="discount-max-uses">Limite de Utilizações</label>
            <input type="number" id="discount-max-uses" min="1" step="1" placeholder="Deixe em branco para ilimitado" />
          </div>
        </div>

        <div class="form-grid-2">
          <div class="admin-form-group">
            <label for="discount-start-date">Data de Início</label>
            <input type="date" id="discount-start-date" />
          </div>

          <div class="admin-form-group">
            <label for="discount-expiry-date">Data de Expiração</label>
            <input type="date" id="discount-expiry-date" />
          </div>
        </div>

        <div class="admin-form-group" style="margin-top: 10px;">
          <label class="checkbox-label-toggle">
            <input type="checkbox" id="discount-active-checkbox" checked />
            <span>Cupão Ativo para utilização imediata no Checkout</span>
          </label>
        </div>

        <div class="admin-modal-foot" style="margin-top: 20px;">
          <button type="button" class="btn-action-edit" id="btn-cancel-discount-modal">Cancelar</button>
          <button type="submit" class="btn-save-modal" id="btn-save-discount">Guardar Cupão</button>
        </div>
      </form>
    </div>
  </div>

  <script is:inline src="/admin.js"></script>
</body>
</html>
