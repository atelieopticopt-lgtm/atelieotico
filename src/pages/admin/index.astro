---
import { products } from '../../data/products';

const brands = [...new Set(products.map(p => p.brand).filter(Boolean))].sort();
const categories = [...new Set(products.map(p => p.category).filter(Boolean))].sort();
---
<!doctype html>
<html lang="pt-PT">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin CMS &bull; Ateliê Ótico</title>
  <meta name="robots" content="noindex, nofollow, noarchive, nosnippet" />
  <link rel="icon" type="image/svg+xml" href="/SVG-Logo-Atelie.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/admin.css" />
</head>
<body class="admin-body">

  {/* =========================================================================
      ADMIN AUTH GATE (ORIGINAL USERNAME & PASSWORD LOGIN SCREEN)
      ========================================================================= */}
  <div id="admin-auth-overlay" class="auth-gate-overlay">
    <div class="auth-gate-card">
      <img src="/SVG-Logo-Atelie.svg" alt="Ateliê Ótico" class="auth-gate-logo" />
      <span class="admin-badge" style="margin-bottom: 16px;">PAINEL DE CONTROLO &bull; ADMIN CMS</span>
      
      <h2>Iniciar Sessão</h2>
      <p>Introduza as suas credenciais de administrador para aceder ao sistema.</p>
      
      <form id="admin-auth-form" class="auth-gate-form">
        <div class="auth-input-wrap">
          <label for="auth-username">Utilizador ou E-mail</label>
          <input type="text" id="auth-username" placeholder="admin ou geral@atelieotico.com" required autofocus autocomplete="username" />
        </div>
        <div class="auth-input-wrap">
          <label for="auth-passcode">Palavra-passe</label>
          <input type="password" id="auth-passcode" placeholder="••••••••" required autocomplete="current-password" />
        </div>
        
        <div class="auth-remember-row">
          <label class="remember-label">
            <input type="checkbox" id="auth-remember" checked />
            <span>Manter sessão iniciada</span>
          </label>
        </div>

        <button type="submit" class="auth-submit-btn">INICIAR SESSÃO</button>
        <p id="auth-error-msg" class="auth-error-text" style="display: none;">Credenciais incorretas. Tente novamente.</p>
      </form>
    </div>
  </div>

  <div class="admin-layout" id="admin-dashboard-layout" style="display: none;">
    
    {/* Left Sidebar with Centered Pure White Logo */}
    <aside class="admin-nav-sidebar">
      
      {/* Brand Logo in Pure White Centered in Sidebar */}
      <div class="admin-sidebar-header">
        <a href="/admin" class="admin-brand-link" title="Painel de Administração">
          <img src="/SVG-Logo-Atelie.svg" alt="Ateliê Ótico" class="admin-logo-img-white" />
        </a>
        <span class="admin-badge">ADMIN CMS</span>
      </div>

      <div class="nav-section-title">PAINEL DE CONTROLO</div>

      <button type="button" class="nav-item active" data-tab="products">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
        <span>Produtos &amp; Preços</span>
        <span class="nav-badge" id="nav-product-count">{products.length}</span>
      </button>

      <button type="button" class="nav-item" data-tab="brands-add">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
          <line x1="7" y1="7" x2="7.01" y2="7"></line>
        </svg>
        <span>Marcas &amp; Novos Modelos</span>
      </button>

      <button type="button" class="nav-item" data-tab="banners">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
          <circle cx="8.5" cy="8.5" r="1.5"></circle>
          <polyline points="21 15 16 10 5 21"></polyline>
        </svg>
        <span>Banners &amp; Destaques</span>
      </button>

      <button type="button" class="nav-item" data-tab="texts">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
          <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4 9.5-9.5z"></path>
        </svg>
        <span>Textos &amp; Conteúdos</span>
      </button>

      <button type="button" class="nav-item" data-tab="backup">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        <span>Backup &amp; Sincronização</span>
      </button>

      {/* Sidebar Footer: Store Link & Logout */}
      <div class="sidebar-bottom-actions">
        <a href="/catalogo" target="_blank" class="sidebar-btn-outline">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line x1="10" y1="14" x2="21" y2="3"></line>
          </svg>
          <span>Ver Loja em Direto</span>
        </a>

        <button type="button" id="btn-admin-logout" class="sidebar-btn-logout">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
            <polyline points="16 17 21 12 16 7"></polyline>
            <line x1="21" y1="12" x2="9" y2="12"></line>
          </svg>
          <span>Terminar Sessão</span>
        </button>
      </div>

    </aside>

    {/* Main Content Area */}
    <main class="admin-main">
      
      {/* TAB 1: PRODUCTS & PRICES */}
      <section id="tab-products" class="tab-panel active">
        
        <div class="panel-header-row">
          <div>
            <h1>Gestão de Produtos &amp; Catálogo</h1>
            <p>Edite preços em tempo real, altere fotografias, adicione novos modelos e faça a gestão visual do catálogo.</p>
          </div>
          <button type="button" id="btn-add-product" class="btn-success-admin">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            <span>Adicionar Novo Produto</span>
          </button>
        </div>

        {/* Filter Toolbar */}
        <div class="admin-filter-bar">
          <div class="search-input-wrap">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="search-icon-svg">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input type="text" id="admin-product-search" placeholder="Pesquisar por nome, SKU, marca..." style="padding-left: 36px;" />
          </div>

          <div class="select-wrap">
            <select id="admin-brand-filter">
              <option value="">Todas as Marcas ({brands.length})</option>
              {brands.map(b => <option value={b}>{b}</option>)}
            </select>
          </div>

          <div class="select-wrap">
            <select id="admin-category-filter">
              <option value="">Todas as Categorias</option>
              {categories.map(c => <option value={c}>{c}</option>)}
            </select>
          </div>

          <div class="admin-count-indicator">
            A mostrar <strong id="admin-visible-count">{products.length}</strong> de {products.length} modelos
          </div>
        </div>

        {/* Visual Product Grid */}
        <div class="admin-products-grid" id="admin-products-grid">
          {products.map(p => (
            <article
              class="admin-product-card"
              data-id={p.id}
              data-name={p.name.toLowerCase()}
              data-brand={(p.brand || '').toLowerCase()}
              data-category={(p.category || '').toLowerCase()}
              data-sku={(p.sku || p.slug).toLowerCase()}
            >
              <div class="admin-card-thumb-wrap">
                <img src={p.image} alt={p.name} class="admin-card-thumb" loading="lazy" />
                <span class="admin-card-brand-tag">{p.brand || 'Ateliê Ótico'}</span>
              </div>
              <div class="admin-card-body">
                <h3 class="admin-card-title">{p.name}</h3>
                <div class="admin-card-sku">SKU: {p.sku || p.slug}</div>
                <div class="admin-card-meta">{p.category} &bull; {p.shape}</div>

                <div class="admin-card-price-box">
                  <label>Preço:</label>
                  <div class="price-input-wrapper">
                    <input
                      type="number"
                      class="admin-inline-price-input"
                      value={p.price}
                      data-id={p.id}
                      min="0"
                    />
                    <span>€</span>
                  </div>
                </div>

                <div class="admin-card-actions">
                  <button type="button" class="btn-card-edit" data-edit-id={p.id}>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 20h9"></path>
                      <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                    </svg>
                    <span>Editar Tudo</span>
                  </button>
                  <button type="button" class="btn-card-delete" data-del-id={p.id}>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="3 6 5 6 21 6"></polyline>
                      <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                    </svg>
                    <span>Eliminar</span>
                  </button>
                </div>
              </div>
            </article>
          ))}
        </div>

      </section>

      {/* TAB 2: BRANDS MANAGEMENT & BATCH PRODUCT ADDITION */}
      <section id="tab-brands-add" class="tab-panel">
        
        <div class="panel-header-row">
          <div>
            <h1>Marcas &amp; Criação de Produtos</h1>
            <p>Adicione novas marcas parceiras e crie novos modelos com carregamento múltiplo de fotografias.</p>
          </div>
        </div>

        {/* Create Brand Card */}
        <div class="admin-card-section">
          <h3>Adicionar Nova Marca ao Catálogo</h3>
          <p class="section-sub">Registe uma nova marca para aparecer imediatamente no seletor de filtros e catálogo.</p>
          
          <form id="form-add-brand" class="form-grid-brand">
            <div class="admin-form-group">
              <label>Nome da Marca *</label>
              <input type="text" id="new-brand-name" required placeholder="Ex: Moscot, Oliver Peoples, Celine..." />
            </div>
            <div class="admin-form-group">
              <label>País / Origem (Opcional)</label>
              <input type="text" id="new-brand-country" placeholder="Ex: Itália, Dinamarca, Japão..." />
            </div>
            <button type="submit" class="btn-success-admin" style="align-self: flex-end; height: 42px; margin-bottom: 16px;">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
              <span>Registar Marca</span>
            </button>
          </form>

          <div class="brands-chip-list" id="admin-brands-chip-list">
            {brands.map(b => (
              <span class="brand-chip">
                <strong>{b}</strong>
              </span>
            ))}
          </div>
        </div>

        {/* Quick Add Product Card */}
        <div class="admin-card-section">
          <h3>Criar Novo Produto com Múltiplas Fotografias</h3>
          <p class="section-sub">Faça o upload das imagens do produto, configure o preço e as especificações técnicas.</p>

          <form id="form-quick-add-product" class="admin-create-form">
            <div class="form-grid-2">
              <div class="admin-form-group">
                <label>Marca do Produto *</label>
                <select id="quick-add-brand" required>
                  <option value="">Selecione a Marca...</option>
                  {brands.map(b => <option value={b}>{b}</option>)}
                </select>
              </div>
              <div class="admin-form-group">
                <label>Nome / Modelo *</label>
                <input type="text" id="quick-add-name" required placeholder="Ex: Chicca SNV126" />
              </div>
            </div>

            <div class="form-grid-2">
              <div class="admin-form-group">
                <label>Código SKU *</label>
                <input type="text" id="quick-add-sku" required placeholder="Ex: SNV126C015Z" />
              </div>
              <div class="admin-form-group">
                <label>Preço de Venda (€) *</label>
                <input type="number" id="quick-add-price" required min="0" placeholder="240" />
              </div>
            </div>

            <div class="form-grid-2">
              <div class="admin-form-group">
                <label>Categoria</label>
                <select id="quick-add-category">
                  <option value="Armações óticas">Armações óticas</option>
                  <option value="Óculos de sol">Óculos de sol</option>
                </select>
              </div>
              <div class="admin-form-group">
                <label>Formato da Armação</label>
                <select id="quick-add-shape">
                  <option value="Redonda">Redonda</option>
                  <option value="Retangular">Retangular</option>
                  <option value="Quadrada">Quadrada</option>
                  <option value="Cat-eye">Cat-eye</option>
                  <option value="Aviador">Aviador</option>
                  <option value="Oval">Oval</option>
                </select>
              </div>
            </div>

            {/* Visual Photo Upload Zone */}
            <div class="admin-form-group">
              <label>Fotografias do Produto (Carregue ficheiros ou cole URLs)</label>
              
              <div class="upload-dropzone" id="quick-upload-dropzone">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="17 8 12 3 7 8"></polyline>
                  <line x1="12" y1="3" x2="12" y2="15"></line>
                </svg>
                <p><strong>Clique para carregar fotos</strong> ou arraste ficheiros para aqui</p>
                <span class="upload-sub">Suporta JPG, PNG, WEBP &bull; Pré-visualização e ordenação imediata</span>
                <input type="file" id="quick-file-input" accept="image/*" multiple style="display: none;" />
              </div>

              {/* Photo previews list with reordering */}
              <div class="photos-reorder-grid" id="quick-photos-preview-list">
                {/* Dynamically populated */}
              </div>
            </div>

            <div class="admin-form-group">
              <label>Descrição do Produto</label>
              <textarea id="quick-add-desc" rows="2" placeholder="Detalhes de artesanato, materiais nobres e acabamentos..."></textarea>
            </div>

            <button type="submit" class="btn-success-admin" style="height: 46px; font-size: 13.5px; width: 100%; justify-content: center;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
              <span>Publicar Modelo no Catálogo</span>
            </button>
          </form>
        </div>

      </section>

      {/* TAB 3: BANNERS & HIGHLIGHTS (INTERACTIVE VISUAL STUDIO) */}
      <section id="tab-banners" class="tab-panel">
        
        <div class="panel-header-row">
          <div>
            <h1>Banners &amp; Estúdio Visual</h1>
            <p>Faça a gestão visual de cada banner da loja, veja a sua localização exata, dimensões reais e ajuste o enquadramento em tempo real.</p>
          </div>
        </div>

        {/* 1. HERO BANNER */}
        <div class="admin-card-section banner-studio-card">
          <div class="banner-location-badge">
            <span class="badge-dot"></span>
            <strong>LOCALIZAÇÃO: Topo da Homepage (Primeira dobra / Hero Principal)</strong>
          </div>

          <div class="banner-dim-info">
            <span>📐 Proporção Recomendada: <strong>1920 &times; 1080 px (16:9)</strong></span>
            <span class="sep">&bull;</span>
            <span>Dimensões detetadas: <strong id="hero-detected-dims">1920 &times; 1080 px</strong></span>
          </div>

          {/* Interactive Live Banner Preview */}
          <div class="banner-live-preview-box hero-preview-box">
            <img id="hero-live-preview-img" src="/campagna-hero.jpeg" alt="Hero Preview" class="banner-preview-img" style="object-position: center 8%;" />
            <div class="banner-preview-overlay"></div>
            <div class="banner-preview-text-content">
              <span class="preview-tag" id="hero-preview-tag">COLEÇÃO 2026</span>
              <h2 class="preview-title" id="hero-preview-title">Design de Autor &amp; Precisão Ótica</h2>
              <p class="preview-desc" id="hero-preview-desc">Curadoria independente de armações óticas e óculos de sol desenhados para carácter e conforto diário.</p>
              <button type="button" class="preview-btn" id="hero-preview-btn">EXPLORAR CATÁLOGO</button>
            </div>
          </div>

          {/* Image Controls: Position Slider & Upload */}
          <div class="banner-position-control-box">
            <div class="pos-slider-header">
              <label for="hero-pos-slider">Ajustar Enquadramento / Posição Vertical na Foto:</label>
              <strong id="hero-pos-val">8% (Foco no Rosto/Lentes)</strong>
            </div>
            <input type="range" id="hero-pos-slider" min="0" max="100" value="8" class="banner-slider-control" />
            <div class="slider-ticks">
              <span>0% (Topo)</span>
              <span>50% (Centro)</span>
              <span>100% (Fundo)</span>
            </div>
          </div>

          <div class="banner-inputs-grid">
            <div class="admin-form-group">
              <label>Carregar Nova Imagem do PC</label>
              <button type="button" class="btn-upload-banner" id="btn-upload-hero">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="17 8 12 3 7 8"></polyline>
                  <line x1="12" y1="3" x2="12" y2="15"></line>
                </svg>
                <span>Escolher Ficheiro de Imagem</span>
              </button>
              <input type="file" id="hero-file-input" accept="image/*" style="display: none;" />
            </div>

            <div class="admin-form-group">
              <label>Ou Caminho / URL da Imagem</label>
              <input type="text" id="hero-img" value="/campagna-hero.jpeg" class="auto-save-input" />
            </div>
          </div>

          <div class="form-grid-2">
            <div class="admin-form-group">
              <label>Tag Superior</label>
              <input type="text" id="hero-tag" value="COLEÇÃO 2026" class="auto-save-input" />
            </div>
            <div class="admin-form-group">
              <label>Título Principal do Hero</label>
              <input type="text" id="hero-title" value="Design de Autor &amp; Precisão Ótica" class="auto-save-input" />
            </div>
          </div>

          <div class="admin-form-group">
            <label>Subtítulo / Descrição</label>
            <textarea id="hero-desc" rows="2" class="auto-save-input">Curadoria independente de armações óticas e óculos de sol desenhados para carácter e conforto diário.</textarea>
          </div>

          <div class="form-grid-2">
            <div class="admin-form-group">
              <label>Texto do Botão</label>
              <input type="text" id="hero-btn-text" value="EXPLORAR CATÁLOGO" class="auto-save-input" />
            </div>
            <div class="admin-form-group">
              <label>Link do Botão</label>
              <input type="text" id="hero-btn-link" value="/catalogo" class="auto-save-input" />
            </div>
          </div>
        </div>

        {/* 2. CINEMATIC EDITORIAL BANNER */}
        <div class="admin-card-section banner-studio-card">
          <div class="banner-location-badge">
            <span class="badge-dot"></span>
            <strong>LOCALIZAÇÃO: Meio da Homepage (Entre Novidades e Seleção Permanente)</strong>
          </div>

          <div class="banner-dim-info">
            <span>📐 Proporção Recomendada: <strong>1920 &times; 900 px (21:9 Widescreen)</strong></span>
            <span class="sep">&bull;</span>
            <span>Dimensões detetadas: <strong id="cinematic-detected-dims">1920 &times; 850 px</strong></span>
          </div>

          {/* Interactive Live Preview */}
          <div class="banner-live-preview-box cinematic-preview-box">
            <img id="cinematic-live-preview-img" src="/campagna-signature.jpeg" alt="Cinematic Preview" class="banner-preview-img" style="object-position: center 50%;" />
            <div class="banner-preview-overlay"></div>
            <div class="banner-preview-text-content">
              <h2 class="preview-title" id="cinematic-preview-title">Linhas Arquiteturais e Conforto Absoluto</h2>
              <p class="preview-desc" id="cinematic-preview-desc">Cada peça resulta de um desenho rigoroso e de uma seleção criteriosa de acetatos italianos de celulose e titânio ultraleve.</p>
            </div>
          </div>

          {/* Position Slider */}
          <div class="banner-position-control-box">
            <div class="pos-slider-header">
              <label for="cinematic-pos-slider">Ajustar Enquadramento / Posição Vertical:</label>
              <strong id="cinematic-pos-val">50% (Centro)</strong>
            </div>
            <input type="range" id="cinematic-pos-slider" min="0" max="100" value="50" class="banner-slider-control" />
            <div class="slider-ticks">
              <span>0% (Topo)</span>
              <span>50% (Centro)</span>
              <span>100% (Fundo)</span>
            </div>
          </div>

          <div class="banner-inputs-grid">
            <div class="admin-form-group">
              <label>Carregar Nova Imagem do PC</label>
              <button type="button" class="btn-upload-banner" id="btn-upload-cinematic">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="17 8 12 3 7 8"></polyline>
                  <line x1="12" y1="3" x2="12" y2="15"></line>
                </svg>
                <span>Escolher Ficheiro de Imagem</span>
              </button>
              <input type="file" id="cinematic-file-input" accept="image/*" style="display: none;" />
            </div>

            <div class="admin-form-group">
              <label>Ou Caminho / URL da Imagem</label>
              <input type="text" id="cinematic-img" value="/campagna-signature.jpeg" class="auto-save-input" />
            </div>
          </div>

          <div class="admin-form-group">
            <label>Título Editorial</label>
            <input type="text" id="cinematic-title" value="Linhas Arquiteturais e Conforto Absoluto" class="auto-save-input" />
          </div>

          <div class="admin-form-group">
            <label>Descrição</label>
            <textarea id="cinematic-desc" rows="2" class="auto-save-input">Cada peça resulta de um desenho rigoroso e de uma seleção criteriosa de acetatos italianos de celulose e titânio ultraleve.</textarea>
          </div>
        </div>

        {/* 3. PRE-FOOTER APPOINTMENT BANNER */}
        <div class="admin-card-section banner-studio-card">
          <div class="banner-location-badge">
            <span class="badge-dot"></span>
            <strong>LOCALIZAÇÃO: Fundo da Homepage (Secção de Agendamento na Praça do Carmo)</strong>
          </div>

          <div class="banner-dim-info">
            <span>📐 Proporção Recomendada: <strong>1400 &times; 700 px (2:1)</strong></span>
            <span class="sep">&bull;</span>
            <span>Dimensões detetadas: <strong id="prefooter-detected-dims">1400 &times; 700 px</strong></span>
          </div>

          {/* Interactive Live Preview */}
          <div class="banner-live-preview-box prefooter-preview-box">
            <img id="prefooter-live-preview-img" src="/campagna-prefooter.jpeg" alt="Prefooter Preview" class="banner-preview-img" style="object-position: center 50%;" />
            <div class="banner-preview-overlay"></div>
            <div class="banner-preview-text-content">
              <h2 class="preview-title" id="prefooter-preview-title">Marque a sua Consulta</h2>
              <p class="preview-desc" id="prefooter-preview-desc">Sessões individuais de aconselhamento ótico e estético no nosso espaço na Madeira.</p>
            </div>
          </div>

          {/* Position Slider */}
          <div class="banner-position-control-box">
            <div class="pos-slider-header">
              <label for="prefooter-pos-slider">Ajustar Enquadramento / Posição Vertical:</label>
              <strong id="prefooter-pos-val">50% (Centro)</strong>
            </div>
            <input type="range" id="prefooter-pos-slider" min="0" max="100" value="50" class="banner-slider-control" />
            <div class="slider-ticks">
              <span>0% (Topo)</span>
              <span>50% (Centro)</span>
              <span>100% (Fundo)</span>
            </div>
          </div>

          <div class="banner-inputs-grid">
            <div class="admin-form-group">
              <label>Carregar Nova Imagem do PC</label>
              <button type="button" class="btn-upload-banner" id="btn-upload-prefooter">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="17 8 12 3 7 8"></polyline>
                  <line x1="12" y1="3" x2="12" y2="15"></line>
                </svg>
                <span>Escolher Ficheiro de Imagem</span>
              </button>
              <input type="file" id="prefooter-file-input" accept="image/*" style="display: none;" />
            </div>

            <div class="admin-form-group">
              <label>Ou Caminho / URL da Imagem</label>
              <input type="text" id="prefooter-img" value="/campagna-prefooter.jpeg" class="auto-save-input" />
            </div>
          </div>

          <div class="admin-form-group">
            <label>Título</label>
            <input type="text" id="prefooter-title" value="Marque a sua Consulta" class="auto-save-input" />
          </div>

          <div class="admin-form-group">
            <label>Descrição</label>
            <textarea id="prefooter-desc" rows="2" class="auto-save-input">Sessões individuais de aconselhamento ótico e estético no nosso espaço na Madeira.</textarea>
          </div>
        </div>

      </section>

      {/* TAB 4: TEXTS & CONTACTS */}
      <section id="tab-texts" class="tab-panel">
        
        <div class="panel-header-row">
          <div>
            <h1>Textos &amp; Contactos da Empresa</h1>
            <p>Gerencie telefones, moradas, horários de funcionamento e informações institucionais.</p>
          </div>
        </div>

        <div class="admin-card-section">
          <h3>Informações de Contacto &amp; Localização</h3>
          <p class="section-sub">Estas informações aparecem no rodapé global e na página de contactos.</p>
          
          <div class="form-grid-2">
            <div class="admin-form-group">
              <label>Telefone / WhatsApp</label>
              <input type="text" id="content-phone" value="+351 291 220 894" class="auto-save-input" />
            </div>
            <div class="admin-form-group">
              <label>Email de Atendimento</label>
              <input type="email" id="content-email" value="geral@atelieotico.com" class="auto-save-input" />
            </div>
          </div>

          <div class="admin-form-group">
            <label>Endereço Físico</label>
            <input type="text" id="content-address" value="Rua da Conceição, Praça do Carmo 29B, 9050-026 Funchal, Madeira" class="auto-save-input" />
          </div>

          <div class="form-grid-2">
            <div class="admin-form-group">
              <label>Horário (Segunda a Sexta)</label>
              <input type="text" id="hours-mf" value="09:30 – 19:00" class="auto-save-input" />
            </div>
            <div class="admin-form-group">
              <label>Horário (Sábado)</label>
              <input type="text" id="hours-sat" value="10:00 – 13:30" class="auto-save-input" />
            </div>
          </div>
        </div>

      </section>

      {/* TAB 5: BACKUP & SYNC */}
      <section id="tab-backup" class="tab-panel">
        
        <div class="panel-header-row">
          <div>
            <h1>Backup &amp; Sincronização</h1>
            <p>Exporte uma cópia completa de segurança em JSON ou restaure os dados padrão.</p>
          </div>
        </div>

        <div class="admin-card-section">
          <h3>Exportar &amp; Guardar Cópia de Segurança</h3>
          <p class="section-sub">Faça download do catálogo com todas as edições de preços, textos e produtos adicionados.</p>
          <button type="button" id="btn-export-json" class="btn-success-admin" style="background: #000;">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span>Descarregar Backup JSON (.json)</span>
          </button>
        </div>

        <div class="admin-card-section">
          <h3>Repor Catálogo Original</h3>
          <p class="section-sub">Repõe os valores de catálogo e imagens originais do servidor.</p>
          <button type="button" id="btn-reset-defaults" class="btn-action-delete" style="padding: 10px 20px; font-size: 13px;">
            Repor Valores de Fábrica
          </button>
        </div>

      </section>

    </main>

  </div>

  {/* =========================================================================
      MODAL: EDIT PRODUCT WITH VISUAL PHOTO REORDERING & UPLOAD (PRESS ESC TO CLOSE)
      ========================================================================= */}
  <div id="product-modal" class="admin-modal-overlay" style="display: none;">
    <div class="admin-modal-card">
      <div class="admin-modal-head">
        <h3 id="modal-product-title">Editar Modelo</h3>
        <button type="button" id="btn-close-modal" class="admin-modal-close" title="Fechar (ESC)">&times;</button>
      </div>
      <form id="product-modal-form" class="admin-modal-body">
        <input type="hidden" id="modal-product-id" />
        
        <div class="form-grid-2">
          <div class="admin-form-group">
            <label>Nome do Produto *</label>
            <input type="text" id="modal-name" required placeholder="Ex: SNOB Milano Chicca" />
          </div>
          <div class="admin-form-group">
            <label>Marca *</label>
            <select id="modal-brand" required>
              {brands.map(b => <option value={b}>{b}</option>)}
            </select>
          </div>
        </div>

        <div class="form-grid-2">
          <div class="admin-form-group">
            <label>Código / SKU *</label>
            <input type="text" id="modal-sku" required placeholder="Ex: SNV126C013Z" />
          </div>
          <div class="admin-form-group">
            <label>Preço (€) *</label>
            <input type="number" id="modal-price" required min="0" placeholder="240" />
          </div>
        </div>

        <div class="form-grid-2">
          <div class="admin-form-group">
            <label>Categoria *</label>
            <select id="modal-category">
              <option value="Armações óticas">Armações óticas</option>
              <option value="Óculos de sol">Óculos de sol</option>
            </select>
          </div>
          <div class="admin-form-group">
            <label>Formato *</label>
            <select id="modal-shape">
              <option value="Redonda">Redonda</option>
              <option value="Retangular">Retangular</option>
              <option value="Quadrada">Quadrada</option>
              <option value="Cat-eye">Cat-eye</option>
              <option value="Aviador">Aviador</option>
              <option value="Oval">Oval</option>
            </select>
          </div>
        </div>

        <div class="form-grid-2">
          <div class="admin-form-group">
            <label>Material</label>
            <select id="modal-material">
              <option value="Acetato">Acetato</option>
              <option value="Titânio">Titânio</option>
              <option value="Metal">Metal</option>
            </select>
          </div>
          <div class="admin-form-group">
            <label>Cor</label>
            <input type="text" id="modal-color" placeholder="Ex: Bordeaux / Translúcido" />
          </div>
        </div>

        {/* Visual Photos Manager with Upload & Drag / Reordering */}
        <div class="admin-form-group" style="margin-top: 10px;">
          <div class="photos-section-header">
            <label>Galeria de Fotografias (Arraste ou use as setas para ordenar &bull; A 1ª é a Principal, a 2ª é Hover)</label>
            <button type="button" id="btn-modal-add-photo" class="btn-add-photo-text">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
              <span>Carregar Foto</span>
            </button>
            <input type="file" id="modal-photo-file-input" accept="image/*" multiple style="display: none;" />
          </div>

          <div class="modal-photos-gallery" id="modal-photos-gallery-list">
            {/* Populated by JS */}
          </div>
        </div>

        <div class="admin-form-group">
          <label>Descrição do Produto</label>
          <textarea id="modal-desc" rows="2" placeholder="Detalhes técnicos, acabamento manual..."></textarea>
        </div>

        <div class="admin-modal-foot">
          <button type="button" id="btn-cancel-modal" class="btn-action-edit">Cancelar (ESC)</button>
          <button type="submit" class="btn-save-modal">Guardar Alterações</button>
        </div>
      </form>
    </div>
  </div>

  <script is:inline src="/admin.js"></script>
</body>
</html>
