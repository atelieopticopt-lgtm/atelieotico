---
import { products } from '../../data/products';
---
<!doctype html>
<html lang="pt-PT">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex,nofollow" />
  <link rel="icon" type="image/svg+xml" href="/SVG-Logo-Atelie.svg" />
  <title>Admin Dashboard & Gestão de Catálogo | Ateliê Ótico</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/admin.css?v=20260820-2" />
</head>
<body>

  {/* Admin Shell */}
  <div class="admin-shell">
    
    {/* Admin Sidebar */}
    <aside class="admin-sidebar">
      <div class="admin-brand">
        <img src="/SVG-Logo-Atelie.svg" alt="Ateliê Ótico" class="admin-logo" />
        <span class="admin-badge">ADMIN v2.6</span>
      </div>

      <nav class="admin-nav">
        <button type="button" class="nav-item active" data-tab="products">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
          <span>Produtos &amp; Preços</span>
          <span class="nav-count" id="nav-product-count">{products.length}</span>
        </button>

        <button type="button" class="nav-item" data-tab="banners">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
            <circle cx="8.5" cy="8.5" r="1.5"></circle>
            <polyline points="21 15 16 10 5 21"></polyline>
          </svg>
          <span>Banners &amp; Campanhas</span>
        </button>

        <button type="button" class="nav-item" data-tab="texts">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
          </svg>
          <span>Textos &amp; Conteúdos</span>
        </button>

        <button type="button" class="nav-item" data-tab="backup">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span>Backup &amp; Sincronização</span>
        </button>
      </nav>

      <div class="sidebar-footer">
        <a href="/" target="_blank" class="btn-live-site">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line x1="10" y1="14" x2="21" y2="3"></line>
          </svg>
          <span>Ver Loja em Direto</span>
        </a>
      </div>
    </aside>

    {/* Admin Main Content */}
    <main class="admin-main">
      
      {/* Top Header */}
      <header class="admin-topbar">
        <div class="admin-title-wrap">
          <h1 id="panel-title">Gestão de Produtos &amp; Catálogo</h1>
          <p id="panel-subtitle">Edite preços, adicione novos modelos de autor e faça a gestão em tempo real.</p>
        </div>
        <div class="admin-topbar-actions">
          <button type="button" id="btn-save-all-cms" class="btn-primary-admin">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
              <polyline points="17 21 17 13 7 13 7 21"></polyline>
              <polyline points="7 3 7 8 15 8"></polyline>
            </svg>
            <span>Guardar Alterações</span>
          </button>
        </div>
      </header>

      {/* TAB 1: PRODUCTS MANAGEMENT */}
      <section id="tab-products" class="tab-panel active">
        
        {/* Products Toolbar */}
        <div class="products-toolbar">
          <div class="toolbar-search">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input type="text" id="admin-product-search" placeholder="Pesquisar por nome, marca ou SKU..." />
          </div>

          <div class="toolbar-filters">
            <select id="admin-brand-filter">
              <option value="">Todas as Marcas</option>
            </select>
            <select id="admin-category-filter">
              <option value="">Todas as Categorias</option>
              <option value="Armações óticas">Armações óticas</option>
              <option value="Óculos de sol">Óculos de sol</option>
            </select>
          </div>

          <button type="button" id="btn-add-product" class="btn-success-admin">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            <span>Adicionar Novo Produto</span>
          </button>
        </div>

        {/* Products Table */}
        <div class="admin-table-card">
          <table class="admin-table" id="admin-products-table">
            <thead>
              <tr>
                <th style="width: 60px;">Foto</th>
                <th>Nome do Produto</th>
                <th>Marca</th>
                <th>Categoria</th>
                <th>Forma / Material</th>
                <th style="width: 110px;">Preço (€)</th>
                <th style="width: 140px; text-align: right;">Ações</th>
              </tr>
            </thead>
            <tbody id="admin-products-tbody">
              {/* Populated by Javascript */}
            </tbody>
          </table>

          {/* Pagination */}
          <div class="admin-pagination">
            <span id="admin-page-info">A mostrar 1–25 de {products.length} produtos</span>
            <div class="pagination-controls">
              <button type="button" id="btn-prev-page" class="btn-page">&laquo; Anterior</button>
              <span id="current-page-num" style="font-weight: 700; font-size: 13px;">1</span>
              <button type="button" id="btn-next-page" class="btn-page">Seguinte &raquo;</button>
            </div>
          </div>
        </div>

      </section>

      {/* TAB 2: BANNERS & CAMPAIGNS */}
      <section id="tab-banners" class="tab-panel">
        
        <div class="admin-form-grid">
          
          {/* Card 1: Hero Banner Homepage */}
          <div class="admin-card">
            <div class="card-header">
              <h3>Hero Banner Principal (Homepage)</h3>
              <p>Personalize o banner principal de boas-vindas visível no topo da página inicial.</p>
            </div>
            <div class="card-body">
              <div class="form-group">
                <label>Tag Superior (Eyebrow)</label>
                <input type="text" id="hero-tag" value="NOVA COLEÇÃO 2026" />
              </div>
              <div class="form-group">
                <label>Título Principal do Hero</label>
                <input type="text" id="hero-title" value="PRECISÃO VISUAL &amp; DESIGN CONTEMPORÂNEO" />
              </div>
              <div class="form-group">
                <label>Subtítulo / Descrição</label>
                <textarea id="hero-desc" rows="3">Curadoria independente de armações de autor, precisão ótica e lentes oftálmicas de alta definição no Funchal, Madeira.</textarea>
              </div>
              <div class="form-group">
                <label>URL Imagem de Fundo Desktop</label>
                <input type="text" id="hero-img" value="/banner_desktop_1_1787001429957.png" />
              </div>
              <div class="form-row">
                <div class="form-group">
                  <label>Texto do Botão</label>
                  <input type="text" id="hero-btn-text" value="EXPLORAR COLEÇÃO" />
                </div>
                <div class="form-group">
                  <label>Link de Destino</label>
                  <input type="text" id="hero-btn-link" value="/catalogo" />
                </div>
              </div>
            </div>
          </div>

          {/* Card 2: Banner Cinemático */}
          <div class="admin-card">
            <div class="card-header">
              <h3>Banner Cinemático Editorial</h3>
              <p>Banner intermédio da homepage com destaque de artesanato e manifesto.</p>
            </div>
            <div class="card-body">
              <div class="form-group">
                <label>Título do Cartão</label>
                <input type="text" id="cinematic-title" value="A Experiência do Ateliê" />
              </div>
              <div class="form-group">
                <label>Descrição do Cartão</label>
                <textarea id="cinematic-desc" rows="3">Cada armação é selecionada para quem recusa o comum. Do titânio japonês ao acetato biológico de autor.</textarea>
              </div>
              <div class="form-group">
                <label>URL Imagem de Fundo</label>
                <input type="text" id="cinematic-img" value="/story-butterfly.jpeg" />
              </div>
            </div>
          </div>

          {/* Card 3: Banner Pré-Footer (Marcações) */}
          <div class="admin-card">
            <div class="card-header">
              <h3>Banner de Marcações &amp; Consultório (Pré-Rodapé)</h3>
              <p>Secção de agendamento de consultas de optometria e aconselhamento ótico.</p>
            </div>
            <div class="card-body">
              <div class="form-group">
                <label>Título</label>
                <input type="text" id="prefooter-title" value="Consultas &amp; Marcações Personalizadas" />
              </div>
              <div class="form-group">
                <label>Descrição</label>
                <textarea id="prefooter-desc" rows="3">Marque o seu exame visual completo e beneficie de aconselhamento de estilo e graduação por especialistas no Funchal.</textarea>
              </div>
              <div class="form-group">
                <label>URL Imagem</label>
                <input type="text" id="prefooter-img" value="/campagna-prefooter.jpeg" />
              </div>
            </div>
          </div>

        </div>

      </section>

      {/* TAB 3: TEXTS & CONTENT */}
      <section id="tab-texts" class="tab-panel">
        <div class="admin-card">
          <div class="card-header">
            <h3>Informações de Contacto &amp; Horários da Loja</h3>
            <p>Estes dados são sincronizados no cabeçalho, rodapé e nos popovers de horários.</p>
          </div>
          <div class="card-body">
            <div class="form-row">
              <div class="form-group">
                <label>Telefone / WhatsApp</label>
                <input type="text" id="content-phone" value="+351 964 993 767" />
              </div>
              <div class="form-group">
                <label>Email de Suporte</label>
                <input type="email" id="content-email" value="geral@atelieotico.com" />
              </div>
            </div>
            <div class="form-group">
              <label>Morada Física da Loja</label>
              <input type="text" id="content-address" value="Rua da Conceição, Praça do Carmo 29B, 9050-026 Funchal, Madeira" />
            </div>
            <div class="form-row">
              <div class="form-group">
                <label>Horário Seg-Sex</label>
                <input type="text" id="hours-mf" value="09:00 – 19:00" />
              </div>
              <div class="form-group">
                <label>Horário Sábado</label>
                <input type="text" id="hours-sat" value="09:00 – 13:00" />
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* TAB 4: BACKUP & SYNC */}
      <section id="tab-backup" class="tab-panel">
        <div class="admin-card">
          <div class="card-header">
            <h3>Exportação &amp; Restauração de Dados</h3>
            <p>Faça o download do ficheiro JSON de configuração completa ou restaure cópias de segurança.</p>
          </div>
          <div class="card-body">
            <div style="display: flex; gap: 14px; flex-wrap: wrap; margin-bottom: 24px;">
              <button type="button" id="btn-export-json" class="btn-primary-admin">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="7 10 12 15 17 10"></polyline>
                  <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
                <span>Descarregar Backup JSON</span>
              </button>
              <button type="button" id="btn-reset-defaults" class="btn-danger-admin">
                <span>Repor Valores Originais</span>
              </button>
            </div>
            <div id="sync-status-msg" class="sync-status-msg" style="display: none;"></div>
          </div>
        </div>
      </section>

    </main>

  </div>

  {/* MODAL: EDIT / ADD PRODUCT */}
  <div id="product-modal" class="admin-modal" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-header">
        <h3 id="modal-product-title">Editar Produto</h3>
        <button type="button" id="btn-close-modal" class="modal-close-btn">&times;</button>
      </div>
      <div class="modal-body">
        <form id="product-form">
          <input type="hidden" id="modal-product-id" />
          <input type="hidden" id="modal-product-slug" />

          <div class="form-group">
            <label>Nome Completo do Modelo</label>
            <input type="text" id="modal-name" required />
          </div>

          <div class="form-row">
            <div class="form-group">
              <label>Marca</label>
              <input type="text" id="modal-brand" required />
            </div>
            <div class="form-group">
              <label>Código SKU / Referência</label>
              <input type="text" id="modal-sku" />
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label>Preço (€)</label>
              <input type="number" id="modal-price" min="0" step="1" required />
            </div>
            <div class="form-group">
              <label>Categoria</label>
              <select id="modal-category">
                <option value="Armações óticas">Armações óticas</option>
                <option value="Óculos de sol">Óculos de sol</option>
              </select>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label>Formato (Shape)</label>
              <select id="modal-shape">
                <option value="Redonda">Redonda</option>
                <option value="Retangular">Retangular</option>
                <option value="Quadrada">Quadrada</option>
                <option value="Aviador">Aviador</option>
                <option value="Cat-eye">Cat-eye</option>
                <option value="Oval">Oval</option>
              </select>
            </div>
            <div class="form-group">
              <label>Material</label>
              <select id="modal-material">
                <option value="Acetato">Acetato</option>
                <option value="Titânio">Titânio</option>
                <option value="Metal">Metal</option>
              </select>
            </div>
          </div>

          <div class="form-group">
            <label>Cor do Modelo</label>
            <input type="text" id="modal-color" />
          </div>

          <div class="form-group">
            <label>URL da Imagem Principal</label>
            <input type="text" id="modal-image" required />
          </div>

          <div class="form-group">
            <label>URL da Imagem Secundária (Hover)</label>
            <input type="text" id="modal-hover" />
          </div>

          <div class="form-group">
            <label>Descrição Editorial</label>
            <textarea id="modal-desc" rows="3"></textarea>
          </div>

          <div class="modal-footer">
            <button type="button" id="btn-cancel-modal" class="btn-secondary-admin">Cancelar</button>
            <button type="submit" class="btn-primary-admin">Guardar Produto</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  {/* Client-side Initial Data Injection */}
  <script is:inline define:vars={{ initialProducts: products }}>
    window.INITIAL_PRODUCTS = initialProducts;
  </script>

  <script is:inline src="/admin.js?v=20260820-2"></script>
</body>
</html>
