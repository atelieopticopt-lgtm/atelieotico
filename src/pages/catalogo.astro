---
import StoreLayout from '../layouts/StoreLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import { products } from '../data/products';

// Extract facets & counts dynamically
const brandCounts: Record<string, number> = {};
const categoryCounts: Record<string, number> = {};
const shapeCounts: Record<string, number> = {};
const materialCounts: Record<string, number> = {};

products.forEach(p => {
  if (p.brand) brandCounts[p.brand] = (brandCounts[p.brand] || 0) + 1;
  if (p.category) categoryCounts[p.category] = (categoryCounts[p.category] || 0) + 1;
  if (p.shape) shapeCounts[p.shape] = (shapeCounts[p.shape] || 0) + 1;
  if (p.material) materialCounts[p.material] = (materialCounts[p.material] || 0) + 1;
});

const sortedBrands = Object.keys(brandCounts).sort((a, b) => brandCounts[b] - brandCounts[a]);
const sortedCategories = Object.keys(categoryCounts).sort((a, b) => categoryCounts[b] - categoryCounts[a]);
const sortedShapes = Object.keys(shapeCounts).sort((a, b) => shapeCounts[b] - shapeCounts[a]);
const sortedMaterials = Object.keys(materialCounts).sort((a, b) => materialCounts[b] - materialCounts[a]);
---

<StoreLayout
  title="Catálogo Geral de Armações & Óculos de Sol | Ateliê Ótico"
  description="Consulte a totalidade do catálogo do Ateliê Ótico no Funchal. Filtre por marca de autor, formato, material e gama de preços com disponibilidade imediata."
>
  <div class="catalog-page-wrapper">
    
    {/* Clean Editorial Page Header */}
    <header class="catalog-hero-header">
      <div class="ll-container">
        <span class="catalog-eyebrow" data-i18n-pt="COLEÇÕES &amp; CATÁLOGO" data-i18n-en="COLLECTIONS &amp; CATALOGUE">COLEÇÕES &amp; CATÁLOGO</span>
        <h1 class="catalog-main-title" data-i18n-pt="Armações & Óculos de Sol" data-i18n-en="Frames & Sunglasses">Armações &amp; Óculos de Sol</h1>
        <p class="catalog-lead-text" data-i18n-pt="Explore a nossa curadoria ótica independente com mais de 370 armações selecionadas com rigor e lentes de alta precisão." data-i18n-en="Explore our independent optical curation of over 370 handpicked designer frames and precision lenses.">
          Explore a nossa curadoria ótica independente com mais de 370 armações selecionadas com rigor e lentes de alta precisão.
        </p>
      </div>
    </header>

    <div class="ll-container">

      {/* Main Catalog Layout: Sidebar + Grid */}
      <div class="catalog-main-layout">
        
        {/* Sidebar Filters — Pure Static (No sticky, No scrollbars, All visible) */}
        <aside id="catalog-sidebar" class="catalog-sidebar">
          
          <div class="sidebar-header-mobile">
            <h3 data-i18n-pt="Filtros do Catálogo" data-i18n-en="Catalog Filters">Filtros do Catálogo</h3>
            <button type="button" id="btn-close-filters-mobile" class="close-mobile-filter">&times;</button>
          </div>

          {/* Sidebar Search Input */}
          <div class="catalog-filter-group sidebar-search-group">
            <div class="sidebar-search-wrap">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
              <input
                type="text"
                id="catalog-search-input"
                class="sidebar-search-input"
                placeholder="Pesquisar por marca, modelo, SKU..."
                data-i18n-placeholder-pt="Pesquisar por marca, modelo, SKU..."
                data-i18n-placeholder-en="Search by brand, model, SKU..."
                aria-label="Pesquisar catálogo"
              />
            </div>
          </div>

          {/* Filter Group: Marcas (Brand) */}
          <div class="catalog-filter-group">
            <div class="filter-group-header">
              <h4 data-i18n-pt="Marcas de Autor" data-i18n-en="Designer Brands">Marcas de Autor</h4>
            </div>
            <div class="filter-options-list">
              {sortedBrands.map(brand => (
                <label class="filter-checkbox-label">
                  <input type="checkbox" data-filter="brand" value={brand} />
                  <span class="filter-label-text">{brand}</span>
                  <span class="filter-count-badge">{brandCounts[brand]}</span>
                </label>
              ))}
            </div>
          </div>

          {/* Filter Group: Tipo de Óculos (Category) */}
          <div class="catalog-filter-group">
            <div class="filter-group-header">
              <h4 data-i18n-pt="Tipo de Óculos" data-i18n-en="Eyewear Type">Tipo de Óculos</h4>
            </div>
            <div class="filter-options-list">
              {sortedCategories.map(cat => (
                <label class="filter-checkbox-label">
                  <input type="checkbox" data-filter="category" value={cat} />
                  <span class="filter-label-text">{cat}</span>
                  <span class="filter-count-badge">{categoryCounts[cat]}</span>
                </label>
              ))}
            </div>
          </div>

          {/* Filter Group: Preço — Barra Horizontal Visual (Dual Range Slider) */}
          <div class="catalog-filter-group">
            <div class="filter-group-header">
              <h4 data-i18n-pt="Intervalo de Preço" data-i18n-en="Price Range">Intervalo de Preço</h4>
            </div>
            <div class="price-range-slider-wrapper">
              <div class="price-slider-values">
                <span id="price-slider-min-val">0 €</span>
                <span class="price-slider-sep">—</span>
                <span id="price-slider-max-val">600 €</span>
              </div>
              <div class="dual-range-container">
                <div class="range-track-bg"></div>
                <div class="range-track-fill" id="range-track-fill"></div>
                <input type="range" id="price-slider-min" min="0" max="600" value="0" step="5" aria-label="Preço Mínimo" />
                <input type="range" id="price-slider-max" min="0" max="600" value="600" step="5" aria-label="Preço Máximo" />
              </div>
            </div>
          </div>

          {/* Filter Group: Formato (Shape) */}
          <div class="catalog-filter-group">
            <div class="filter-group-header">
              <h4 data-i18n-pt="Forma da Armação" data-i18n-en="Frame Shape">Forma da Armação</h4>
            </div>
            <div class="filter-options-list">
              {sortedShapes.map(shape => (
                <label class="filter-checkbox-label">
                  <input type="checkbox" data-filter="shape" value={shape} />
                  <span class="filter-label-text">{shape}</span>
                  <span class="filter-count-badge">{shapeCounts[shape]}</span>
                </label>
              ))}
            </div>
          </div>

          {/* Filter Group: Matéria (Material) */}
          <div class="catalog-filter-group">
            <div class="filter-group-header">
              <h4 data-i18n-pt="Material" data-i18n-en="Material">Material</h4>
            </div>
            <div class="filter-options-list">
              {sortedMaterials.map(mat => (
                <label class="filter-checkbox-label">
                  <input type="checkbox" data-filter="material" value={mat} />
                  <span class="filter-label-text">{mat}</span>
                  <span class="filter-count-badge">{materialCounts[mat]}</span>
                </label>
              ))}
            </div>
          </div>

          {/* Reset Filters Button in Sidebar */}
          <div class="sidebar-reset-box">
            <button type="button" id="btn-sidebar-reset" class="btn-sidebar-reset" data-i18n-pt="Repor Todos os Filtros" data-i18n-en="Reset All Filters">
              Repor Todos os Filtros
            </button>
          </div>

        </aside>

        {/* Product Grid Area */}
        <section class="catalog-content-area">
          
          {/* Header Row above Grid with Model Counter, Mobile Button & Sorter */}
          <div class="catalog-grid-header">
            <div class="catalog-count-badge">
              <span data-i18n-pt="A mostrar" data-i18n-en="Showing">A mostrar</span>
              <strong id="catalog-result-count">{products.length}</strong>
              <span data-i18n-pt="modelos" data-i18n-en="models">modelos</span>
            </div>

            <div style="display: flex; align-items: center; gap: 12px;">
              <button type="button" id="btn-toggle-filters-mobile" class="mobile-filter-toggle-btn">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <line x1="4" y1="21" x2="4" y2="14"></line>
                  <line x1="4" y1="10" x2="4" y2="3"></line>
                  <line x1="12" y1="21" x2="12" y2="12"></line>
                  <line x1="12" y1="8" x2="12" y2="3"></line>
                  <line x1="20" y1="21" x2="20" y2="16"></line>
                  <line x1="20" y1="12" x2="20" y2="3"></line>
                </svg>
                <span data-i18n-pt="Filtros" data-i18n-en="Filters">Filtros</span>
              </button>

              <div class="catalog-sort-wrap">
                <select id="catalog-sort-select" class="catalog-sort-select" aria-label="Ordenar produtos">
                  <option value="default" data-i18n-pt="ORDENAÇÃO: RECOMENDADOS" data-i18n-en="SORT: RECOMMENDED">ORDENAÇÃO: RECOMENDADOS</option>
                  <option value="price-asc" data-i18n-pt="PREÇO: MENOR AO MAIOR" data-i18n-en="PRICE: LOW TO HIGH">PREÇO: MENOR AO MAIOR</option>
                  <option value="price-desc" data-i18n-pt="PREÇO: MAIOR AO MENOR" data-i18n-en="PRICE: HIGH TO LOW">PREÇO: MAIOR AO MENOR</option>
                  <option value="name-asc" data-i18n-pt="NOME: A — Z" data-i18n-en="NAME: A — Z">NOME: A — Z</option>
                  <option value="name-desc" data-i18n-pt="NOME: Z — A" data-i18n-en="NAME: Z — A">NOME: Z — A</option>
                </select>
              </div>
            </div>
          </div>

          {/* Product Grid */}
          <div class="catalog-product-grid" data-product-grid>
            {products.map(product => (
              <ProductCard product={product} />
            ))}
          </div>

          {/* Empty State */}
          <div id="catalog-empty-state" class="catalog-empty-state" style="display: none;">
            <div class="empty-state-card">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
              </svg>
              <h3 data-i18n-pt="Nenhum modelo encontrado" data-i18n-en="No models found">Nenhum modelo encontrado</h3>
              <p data-i18n-pt="Experimente ajustar os filtros de marca, formato ou intervalo de preços para descobrir outros modelos da nossa coleção." data-i18n-en="Try adjusting your brand, shape, or price range filters to discover other models in our collection.">
                Experimente ajustar os filtros de marca, formato ou intervalo de preços para descobrir outros modelos da nossa coleção.
              </p>
              <button type="button" id="btn-empty-reset" class="rect black" data-i18n-pt="VER TODO O CATÁLOGO" data-i18n-en="VIEW ALL CATALOGUE">
                VER TODO O CATÁLOGO
              </button>
            </div>
          </div>

        </section>

      </div>

    </div>
  </div>

  <style>
    .catalog-page-wrapper {
      background: #faf9f5;
      min-height: 100vh;
      padding-bottom: 90px;
    }

    .catalog-hero-header {
      padding: clamp(48px, 6vw, 72px) 0 clamp(24px, 3vw, 36px);
      text-align: center;
      background: #ffffff;
      border-bottom: 1px solid rgba(0, 0, 0, 0.08);
      margin-bottom: 36px;
    }

    .catalog-eyebrow {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: #666666;
      display: block;
      margin-bottom: 8px;
    }

    .catalog-main-title {
      font-size: clamp(32px, 4.5vw, 56px);
      font-weight: 400;
      letter-spacing: -0.03em;
      line-height: 1.08;
      color: #0a0a0a;
      margin: 0 0 16px;
    }

    .catalog-lead-text {
      font-size: clamp(14px, 1.4vw, 16px);
      color: #555555;
      max-width: 640px;
      margin: 0 auto;
      line-height: 1.6;
    }

    .catalog-main-layout {
      display: grid;
      grid-template-columns: 280px 1fr;
      gap: 36px;
      align-items: start;
    }

    /* Pure Static Sidebar */
    .catalog-sidebar {
      background: #ffffff;
      border: 1px solid rgba(0, 0, 0, 0.12);
      padding: 24px 20px;
      position: static !important;
      max-height: none !important;
      overflow: visible !important;
      box-sizing: border-box;
    }

    .sidebar-header-mobile {
      display: none;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid #eee;
      padding-bottom: 12px;
      margin-bottom: 16px;
    }

    .sidebar-search-group {
      padding-top: 0 !important;
      padding-bottom: 18px !important;
    }

    .sidebar-search-wrap {
      display: flex;
      align-items: center;
      gap: 8px;
      background: #f7f6f2;
      border: 1px solid rgba(0, 0, 0, 0.12);
      padding: 8px 12px;
      box-sizing: border-box;
    }

    .sidebar-search-wrap svg {
      color: #777777;
      flex-shrink: 0;
    }

    .sidebar-search-input {
      border: none;
      background: transparent;
      outline: none;
      font-size: 12px;
      font-family: inherit;
      width: 100%;
      color: #111111;
    }

    .catalog-filter-group {
      border-bottom: 1px solid rgba(0, 0, 0, 0.08);
      padding: 18px 0;
    }

    .catalog-filter-group:last-of-type {
      border-bottom: none;
    }

    .filter-group-header h4 {
      font-size: 11.5px;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #0a0a0a;
      margin: 0 0 14px;
    }

    .filter-options-list {
      display: flex;
      flex-direction: column;
      gap: 9px;
      max-height: none !important;
      overflow: visible !important;
    }

    .filter-checkbox-label {
      display: flex;
      align-items: center;
      font-size: 13px;
      color: #333333;
      cursor: pointer;
      user-select: none;
      transition: color 0.15s ease;
    }

    .filter-checkbox-label:hover {
      color: #000000;
    }

    .filter-checkbox-label input {
      margin-right: 10px;
      accent-color: #000000;
      cursor: pointer;
      width: 15px;
      height: 15px;
    }

    .filter-label-text {
      flex: 1;
    }

    .filter-count-badge {
      font-size: 11px;
      color: #888888;
      background: #f4f3ee;
      padding: 1px 7px;
      border-radius: 10px;
    }

    /* Dual Range Price Slider (Visual Horizontal Bar) */
    .price-range-slider-wrapper {
      padding: 6px 0 4px;
    }

    .price-slider-values {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 13px;
      font-weight: 700;
      color: #111111;
      margin-bottom: 14px;
    }

    .price-slider-sep {
      color: #888888;
      font-weight: 400;
    }

    .dual-range-container {
      position: relative;
      width: 100%;
      height: 24px;
      display: flex;
      align-items: center;
    }

    .range-track-bg {
      position: absolute;
      width: 100%;
      height: 4px;
      background: #e2e0d8;
      border-radius: 2px;
      z-index: 1;
    }

    .range-track-fill {
      position: absolute;
      height: 4px;
      background: #000000;
      border-radius: 2px;
      z-index: 2;
      left: 0%;
      right: 0%;
    }

    .dual-range-container input[type="range"] {
      position: absolute;
      width: 100%;
      height: 4px;
      background: none;
      pointer-events: none;
      -webkit-appearance: none;
      appearance: none;
      z-index: 3;
      margin: 0;
      outline: none;
    }

    .dual-range-container input[type="range"]::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      width: 18px;
      height: 18px;
      border-radius: 50%;
      background: #000000;
      border: 2px solid #ffffff;
      box-shadow: 0 1px 5px rgba(0, 0, 0, 0.35);
      cursor: pointer;
      pointer-events: auto;
      transition: transform 0.15s ease;
    }

    .dual-range-container input[type="range"]::-moz-range-thumb {
      width: 18px;
      height: 18px;
      border-radius: 50%;
      background: #000000;
      border: 2px solid #ffffff;
      box-shadow: 0 1px 5px rgba(0, 0, 0, 0.35);
      cursor: pointer;
      pointer-events: auto;
      transition: transform 0.15s ease;
    }

    .dual-range-container input[type="range"]::-webkit-slider-thumb:hover {
      transform: scale(1.25);
    }

    .dual-range-container input[type="range"]::-moz-range-thumb:hover {
      transform: scale(1.25);
    }

    .sidebar-reset-box {
      margin-top: 20px;
      padding-top: 16px;
      border-top: 1px solid rgba(0, 0, 0, 0.08);
    }

    .btn-sidebar-reset {
      width: 100%;
      height: 38px;
      background: #f7f6f2;
      border: 1px solid rgba(0, 0, 0, 0.12);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      cursor: pointer;
      transition: background 0.2s ease, color 0.2s ease;
    }

    .btn-sidebar-reset:hover {
      background: #000000;
      color: #ffffff;
    }

    /* Grid Area */
    .catalog-content-area {
      min-width: 0;
    }

    .catalog-grid-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-bottom: 16px;
      margin-bottom: 24px;
      border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    }

    .catalog-count-badge {
      font-size: 13px;
      color: #444444;
    }

    .catalog-count-badge strong {
      color: #000000;
      font-weight: 700;
    }

    .mobile-filter-toggle-btn {
      display: none;
      align-items: center;
      gap: 6px;
      height: 38px;
      padding: 0 14px;
      background: #ffffff;
      border: 1px solid rgba(0, 0, 0, 0.15);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      cursor: pointer;
    }

    .catalog-sort-wrap select {
      height: 38px;
      padding: 0 12px;
      background: #ffffff;
      border: 1px solid rgba(0, 0, 0, 0.15);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      outline: none;
      cursor: pointer;
    }

    .catalog-product-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }

    .catalog-empty-state {
      background: #ffffff;
      border: 1px solid rgba(0, 0, 0, 0.12);
      padding: 64px 32px;
      text-align: center;
      max-width: 540px;
      margin: 40px auto;
    }

    .catalog-empty-state svg {
      color: #999999;
      margin-bottom: 16px;
    }

    .catalog-empty-state h3 {
      font-size: 18px;
      font-weight: 700;
      margin: 0 0 10px;
      color: #0a0a0a;
    }

    .catalog-empty-state p {
      font-size: 13.5px;
      line-height: 1.6;
      color: #666666;
      margin: 0 0 24px;
    }

    @media (max-width: 1200px) {
      .catalog-product-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 860px) {
      .catalog-main-layout {
        grid-template-columns: 1fr;
      }

      .mobile-filter-toggle-btn {
        display: inline-flex;
      }

      .catalog-sidebar {
        position: fixed !important;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 99999;
        max-height: 100vh !important;
        overflow-y: auto !important;
        display: none;
        box-shadow: 0 0 40px rgba(0, 0, 0, 0.3);
      }

      .catalog-sidebar.open {
        display: block;
      }

      .sidebar-header-mobile {
        display: flex;
      }

      .close-mobile-filter {
        background: none;
        border: none;
        font-size: 28px;
        line-height: 1;
        cursor: pointer;
      }

      .catalog-product-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <script is:inline src="/catalog.js"></script>
</StoreLayout>
