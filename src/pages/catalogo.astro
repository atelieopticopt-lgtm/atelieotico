---
import StoreLayout from '../layouts/StoreLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import { products } from '../data/products';

// Calculate groups with counters
const brandCounts: Record<string, number> = {};
const categoryCounts: Record<string, number> = {};
const shapeCounts: Record<string, number> = {};
const materialCounts: Record<string, number> = {};

products.forEach(p => {
  const b = p.brand || 'Ateliê Ótico';
  brandCounts[b] = (brandCounts[b] || 0) + 1;

  if (p.category) {
    const cleanCat = p.category.replace('ÓÓ', 'Ó');
    categoryCounts[cleanCat] = (categoryCounts[cleanCat] || 0) + 1;
  }
  if (p.shape) shapeCounts[p.shape] = (shapeCounts[p.shape] || 0) + 1;
  if (p.material) materialCounts[p.material] = (materialCounts[p.material] || 0) + 1;
});

const sortedBrands = Object.keys(brandCounts).sort((a, b) => brandCounts[b] - brandCounts[a]);
const sortedCategories = Object.keys(categoryCounts).sort();
const sortedShapes = Object.keys(shapeCounts).sort();
const sortedMaterials = Object.keys(materialCounts).sort();
---

<StoreLayout
  title="Catálogo de Óculos & Armações de Autor | Ateliê Ótico — Madeira"
  description="Catálogo completo de armações óticas e óculos de sol de autor no Ateliê Ótico, Funchal, Madeira. Descubra marcas independentes, precisão ótica e lentes ZEISS."
>
  <div class="catalog-page-wrapper">
    
    {/* Page Header */}
    <header class="catalog-hero-header">
      <div class="ll-container">
        <span class="catalog-eyebrow" data-i18n-pt="CATÁLOGO & COLEÇÕES DE AUTOR" data-i18n-en="CATALOG & DESIGNER COLLECTIONS">CATÁLOGO &amp; COLEÇÕES DE AUTOR</span>
        <h1 class="catalog-main-title" data-i18n-pt="Armações & Óculos de Sol" data-i18n-en="Frames & Sunglasses">Armações &amp; Óculos de Sol</h1>
        <p class="catalog-lead-text" data-i18n-pt="Explore a nossa curadoria ótica independente com mais de 370 armações selecionadas com rigor e lentes de alta precisão." data-i18n-en="Explore our independent optical curation of over 370 handpicked designer frames and precision lenses.">
          Explore a nossa curadoria ótica independente com mais de 370 armações selecionadas com rigor e lentes de alta precisão.
        </p>
      </div>
    </header>

    <div class="ll-container">
      
      {/* Top Filter Bar & Search */}
      <div class="catalog-top-toolbar">
        
        {/* Search input */}
        <div class="catalog-search-wrap">
          <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input
            type="text"
            id="catalog-search-input"
            class="catalog-search-input"
            placeholder="Pesquisar por marca, modelo, SKU ou cor..."
            data-i18n-placeholder-pt="Pesquisar por marca, modelo, SKU ou cor..."
            data-i18n-placeholder-en="Search by brand, model, SKU or color..."
            aria-label="Pesquisar catálogo"
          />
          <button type="button" id="catalog-search-clear" class="search-clear-btn" aria-label="Limpar pesquisa">&times;</button>
        </div>

        {/* Results Counter & Actions */}
        <div class="catalog-toolbar-right">
          <div class="catalog-count-badge">
            <span data-i18n-pt="A mostrar" data-i18n-en="Showing">A mostrar</span>
            <strong id="catalog-result-count">{products.length}</strong>
            <span data-i18n-pt="modelos" data-i18n-en="models">modelos</span>
          </div>

          <button type="button" id="btn-toggle-filters-mobile" class="mobile-filter-toggle-btn">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="4" y1="21" x2="4" y2="14"></line>
              <line x1="4" y1="10" x2="4" y2="3"></line>
              <line x1="12" y1="21" x2="12" y2="12"></line>
              <line x1="12" y1="8" x2="12" y2="3"></line>
              <line x1="20" y1="21" x2="20" y2="16"></line>
              <line x1="20" y1="12" x2="20" y2="3"></line>
              <line x1="1" y1="14" x2="7" y2="14"></line>
              <line x1="9" y1="8" x2="15" y2="8"></line>
              <line x1="17" y1="16" x2="23" y2="16"></line>
            </svg>
            <span data-i18n-pt="Filtros" data-i18n-en="Filters">Filtros</span>
          </button>

          {/* Sort Selector */}
          <div class="catalog-sort-wrap">
            <select id="catalog-sort-select" class="catalog-sort-select" aria-label="Ordenar produtos">
              <option value="default" data-i18n-pt="ORDENAÇÃO: RECOMENDADOS" data-i18n-en="SORT: RECOMMENDED">ORDENAÇÃO: RECOMENDADOS</option>
              <option value="price-asc" data-i18n-pt="PREÇO: MENOR AO MAIOR" data-i18n-en="PRICE: LOW TO HIGH">PREÇO: MENOR AO MAIOR</option>
              <option value="price-desc" data-i18n-pt="PREÇO: MAIOR AO MENOR" data-i18n-en="PRICE: HIGH TO LOW">PREÇO: MAIOR AO MENOR</option>
              <option value="name-asc" data-i18n-pt="NOME: A — Z" data-i18n-en="NAME: A — Z">NOME: A — Z</option>
              <option value="name-desc" data-i18n-pt="NOME: Z — A" data-i18n-en="NAME: Z — A">NOME: Z — A</option>
            </select>
          </div>
        </div>

      </div>

      {/* Main Catalog Layout: Sidebar + Grid */}
      <div class="catalog-main-layout">
        
        {/* Sidebar Filters — Pure Static (No sticky, No scrollbars, All visible) */}
        <aside id="catalog-sidebar" class="catalog-sidebar">
          
          <div class="sidebar-header-mobile">
            <h3 data-i18n-pt="Filtros do Catálogo" data-i18n-en="Catalog Filters">Filtros do Catálogo</h3>
            <button type="button" id="btn-close-filters-mobile" class="close-mobile-filter">&times;</button>
          </div>

          {/* Filter Group: Marcas (Brand) */}
          <div class="catalog-filter-group">
            <div class="filter-group-header">
              <h4 data-i18n-pt="Marcas de Autor" data-i18n-en="Designer Brands">Marcas de Autor</h4>
            </div>
            <div class="filter-options-list">
              {sortedBrands.map(brand => (
                <label class="filter-checkbox-label">
                  <input type="checkbox" data-filter="brand" value={brand} />
                  <span class="filter-label-text">{brand}</span>
                  <span class="filter-count-badge">{brandCounts[brand]}</span>
                </label>
              ))}
            </div>
          </div>

          {/* Filter Group: Tipo / Categoria */}
          <div class="catalog-filter-group">
            <div class="filter-group-header">
              <h4 data-i18n-pt="Tipo de Óculos" data-i18n-en="Eyewear Type">Tipo de Óculos</h4>
            </div>
            <div class="filter-options-list">
              {sortedCategories.map(cat => (
                <label class="filter-checkbox-label">
                  <input type="checkbox" data-filter="category" value={cat} />
                  <span class="filter-label-text">{cat}</span>
                  <span class="filter-count-badge">{categoryCounts[cat]}</span>
                </label>
              ))}
            </div>
          </div>

          {/* Filter Group: Preço (Price Range) */}
          <div class="catalog-filter-group">
            <div class="filter-group-header">
              <h4 data-i18n-pt="Intervalo de Preço" data-i18n-en="Price Range">Intervalo de Preço</h4>
            </div>
            <div class="price-filter-wrapper">
              <div class="price-quick-tags">
                <button type="button" class="price-tag-btn" data-min="0" data-max="150">&lt; 150 €</button>
                <button type="button" class="price-tag-btn" data-min="150" data-max="250">150 – 250 €</button>
                <button type="button" class="price-tag-btn" data-min="250" data-max="350">250 – 350 €</button>
                <button type="button" class="price-tag-btn" data-min="350" data-max="1000">&gt; 350 €</button>
              </div>
              <div class="price-inputs-row">
                <div class="price-input-field">
                  <span>Min</span>
                  <input type="number" id="price-min" placeholder="0" min="0" max="1000" />
                  <em>€</em>
                </div>
                <span class="price-divider">—</span>
                <div class="price-input-field">
                  <span>Max</span>
                  <input type="number" id="price-max" placeholder="600" min="0" max="1000" />
                  <em>€</em>
                </div>
              </div>
            </div>
          </div>

          {/* Filter Group: Formato (Shape) */}
          <div class="catalog-filter-group">
            <div class="filter-group-header">
              <h4 data-i18n-pt="Forma da Armação" data-i18n-en="Frame Shape">Forma da Armação</h4>
            </div>
            <div class="filter-options-list">
              {sortedShapes.map(shape => (
                <label class="filter-checkbox-label">
                  <input type="checkbox" data-filter="shape" value={shape} />
                  <span class="filter-label-text">{shape}</span>
                  <span class="filter-count-badge">{shapeCounts[shape]}</span>
                </label>
              ))}
            </div>
          </div>

          {/* Filter Group: Material */}
          <div class="catalog-filter-group">
            <div class="filter-group-header">
              <h4 data-i18n-pt="Material" data-i18n-en="Material">Material</h4>
            </div>
            <div class="filter-options-list">
              {sortedMaterials.map(mat => (
                <label class="filter-checkbox-label">
                  <input type="checkbox" data-filter="material" value={mat} />
                  <span class="filter-label-text">{mat}</span>
                  <span class="filter-count-badge">{materialCounts[mat]}</span>
                </label>
              ))}
            </div>
          </div>

          {/* Clear button in sidebar */}
          <div class="sidebar-footer-action">
            <button type="button" id="btn-sidebar-reset" class="btn-sidebar-reset" data-i18n-pt="Limpar Filtros" data-i18n-en="Clear Filters">Limpar Filtros</button>
          </div>

        </aside>

        {/* Product Grid Area */}
        <section class="catalog-grid-section">
          
          <div class="product-grid" data-product-grid>
            {products.map(product => (
              <ProductCard product={product} />
            ))}
          </div>

          {/* Empty Results Placeholder */}
          <div id="catalog-empty-state" class="catalog-empty-state" style="display: none;">
            <div class="empty-icon-wrap">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                <line x1="8" y1="11" x2="14" y2="11"></line>
              </svg>
            </div>
            <h3 data-i18n-pt="Nenhum modelo encontrado" data-i18n-en="No models found">Nenhum modelo encontrado</h3>
            <p data-i18n-pt="Não encontramos armações correspondentes à combinação de filtros selecionada. Tente ajustar os critérios de pesquisa ou limpar os filtros." data-i18n-en="We couldn't find frames matching your selected criteria. Try adjusting your search or clearing the filters.">
              Não encontramos armações correspondentes à combinação de filtros selecionada. Tente ajustar os critérios de pesquisa ou limpar os filtros.
            </p>
            <button type="button" id="btn-empty-reset" class="btn-empty-reset" data-i18n-pt="Repor todos os filtros" data-i18n-en="Reset all filters">Repor todos os filtros</button>
          </div>

        </section>

      </div>

    </div>
  </div>

  <script is:inline src="/catalog.js"></script>
</StoreLayout>

<style>
  .catalog-page-wrapper {
    background-color: #faf9f6;
    padding-bottom: 96px;
    min-height: 100vh;
  }

  /* Catalog Hero Header */
  .catalog-hero-header {
    background-color: #ffffff;
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
    padding: clamp(48px, 6vw, 72px) 0 clamp(32px, 4vw, 48px);
    margin-bottom: 32px;
  }

  .catalog-eyebrow {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #666666;
    display: block;
    margin-bottom: 12px;
  }

  .catalog-main-title {
    font-size: clamp(32px, 4.5vw, 56px);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.1;
    color: #0a0a0a;
    margin: 0 0 16px;
  }

  .catalog-lead-text {
    font-size: clamp(14.5px, 1.15vw, 17px);
    line-height: 1.65;
    color: #555555;
    max-width: 680px;
    margin: 0;
  }

  /* Top Toolbar */
  .catalog-top-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 18px;
    background: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.12);
    padding: 14px 20px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }

  .catalog-search-wrap {
    position: relative;
    flex: 1 1 320px;
    display: flex;
    align-items: center;
  }

  .catalog-search-wrap .search-icon {
    position: absolute;
    left: 14px;
    color: #888888;
    pointer-events: none;
  }

  .catalog-search-input {
    width: 100%;
    height: 44px;
    padding: 0 36px 0 40px;
    background: #f7f6f2;
    border: 1px solid rgba(0, 0, 0, 0.08);
    font-size: 13px;
    font-family: inherit;
    color: #111111;
    outline: none;
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .catalog-search-input:focus {
    background: #ffffff;
    border-color: #000000;
  }

  .search-clear-btn {
    position: absolute;
    right: 12px;
    background: none;
    border: none;
    font-size: 18px;
    color: #888;
    cursor: pointer;
    display: none;
  }

  .catalog-toolbar-right {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .catalog-count-badge {
    font-size: 12.5px;
    color: #666666;
    letter-spacing: 0.02em;
  }

  .catalog-count-badge strong {
    color: #000000;
    font-size: 14px;
    margin: 0 2px;
  }

  .catalog-sort-select {
    height: 44px;
    padding: 0 32px 0 14px;
    background: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.14);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #0a0a0a;
    font-family: inherit;
    cursor: pointer;
    outline: none;
  }

  .mobile-filter-toggle-btn {
    display: none;
    align-items: center;
    gap: 6px;
    height: 44px;
    padding: 0 18px;
    background: #000000;
    color: #ffffff;
    border: none;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
  }

  /* Active Chips Bar */
  .catalog-active-chips {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    background: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.08);
    padding: 10px 16px;
    margin-bottom: 24px;
  }

  .active-chips-label {
    font-size: 11.5px;
    font-weight: 700;
    color: #555555;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .chips-container {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }

  .filter-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #0a0a0a;
    color: #ffffff;
    font-size: 11px;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 2px;
  }

  .filter-chip button {
    background: none;
    border: none;
    color: #ffffff;
    font-size: 13px;
    line-height: 1;
    cursor: pointer;
    padding: 0;
  }

  .btn-clear-all {
    background: none;
    border: none;
    font-size: 11px;
    font-weight: 700;
    text-decoration: underline;
    color: #000000;
    cursor: pointer;
    margin-left: 6px;
  }

  /* Main Layout */
  .catalog-main-layout {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 32px;
    align-items: start;
  }

  /* Pure Static Sidebar — NO STICKY, NO SCROLLBARS, SHOWS ALL */
  .catalog-sidebar {
    background: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.12);
    padding: 24px 20px;
    position: static !important;
    max-height: none !important;
    overflow: visible !important;
  }

  .sidebar-header-mobile {
    display: none;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #eee;
    padding-bottom: 12px;
    margin-bottom: 16px;
  }

  .catalog-filter-group {
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    padding: 18px 0;
  }

  .catalog-filter-group:first-child {
    padding-top: 0;
  }

  .catalog-filter-group:last-of-type {
    border-bottom: none;
  }

  .filter-group-header h4 {
    font-size: 11.5px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #0a0a0a;
    margin: 0 0 14px;
  }

  .filter-options-list {
    display: flex;
    flex-direction: column;
    gap: 9px;
    max-height: none !important;
    overflow: visible !important;
    padding-right: 0 !important;
  }

  .filter-checkbox-label {
    display: flex;
    align-items: center;
    font-size: 13px;
    color: #333333;
    cursor: pointer;
    user-select: none;
    transition: color 0.15s ease;
  }

  .filter-checkbox-label:hover {
    color: #000000;
  }

  .filter-checkbox-label input {
    margin-right: 10px;
    accent-color: #000000;
    cursor: pointer;
    width: 15px;
    height: 15px;
  }

  .filter-label-text {
    flex: 1;
  }

  .filter-count-badge {
    font-size: 11px;
    color: #888888;
    background: #f4f3ee;
    padding: 1px 7px;
    border-radius: 10px;
  }

  /* Price Filter */
  .price-quick-tags {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
    margin-bottom: 12px;
  }

  .price-tag-btn {
    background: #f7f6f2;
    border: 1px solid rgba(0, 0, 0, 0.08);
    font-size: 11px;
    font-weight: 600;
    padding: 6px 8px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .price-tag-btn.active,
  .price-tag-btn:hover {
    background: #000000;
    color: #ffffff;
    border-color: #000000;
  }

  .price-inputs-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .price-input-field {
    flex: 1;
    display: flex;
    align-items: center;
    background: #f7f6f2;
    border: 1px solid rgba(0, 0, 0, 0.1);
    padding: 0 8px;
    height: 36px;
  }

  .price-input-field span {
    font-size: 10px;
    color: #777;
    text-transform: uppercase;
    margin-right: 4px;
  }

  .price-input-field input {
    width: 100%;
    background: none;
    border: none;
    outline: none;
    font-size: 12px;
    font-weight: 600;
    font-family: inherit;
    text-align: right;
  }

  .price-input-field em {
    font-size: 11px;
    font-style: normal;
    color: #555;
    margin-left: 2px;
  }

  .price-divider {
    color: #888;
    font-size: 12px;
  }

  .sidebar-footer-action {
    margin-top: 18px;
    padding-top: 14px;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
  }

  .btn-sidebar-reset {
    width: 100%;
    height: 38px;
    background: #f7f6f2;
    border: 1px solid rgba(0, 0, 0, 0.12);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .btn-sidebar-reset:hover {
    background: #000000;
    color: #ffffff;
  }

  /* Grid Layout */
  .catalog-grid-section {
    min-width: 0;
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  /* Empty State */
  .catalog-empty-state {
    background: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.12);
    padding: 64px 32px;
    text-align: center;
    max-width: 600px;
    margin: 40px auto;
  }

  .empty-icon-wrap {
    color: #999999;
    margin-bottom: 16px;
  }

  .catalog-empty-state h3 {
    font-size: 20px;
    font-weight: 700;
    margin: 0 0 10px;
    color: #0a0a0a;
  }

  .catalog-empty-state p {
    font-size: 14px;
    line-height: 1.6;
    color: #666666;
    margin: 0 0 24px;
  }

  .btn-empty-reset {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 44px;
    padding: 0 28px;
    background: #000000;
    color: #ffffff;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border: none;
    cursor: pointer;
  }

  @media (max-width: 1200px) {
    .product-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 860px) {
    .catalog-main-layout {
      grid-template-columns: 1fr;
    }

    .mobile-filter-toggle-btn {
      display: inline-flex;
    }

    .catalog-sidebar {
      position: fixed !important;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 99999;
      max-height: 100vh !important;
      overflow-y: auto !important;
      display: none;
      box-shadow: 0 0 40px rgba(0, 0, 0, 0.3);
    }

    .catalog-sidebar.open {
      display: block;
    }

    .sidebar-header-mobile {
      display: flex;
    }

    .close-mobile-filter {
      background: none;
      border: none;
      font-size: 28px;
      line-height: 1;
      cursor: pointer;
    }

    .product-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
