---
import StoreLayout from '../layouts/StoreLayout.astro';
---
<StoreLayout title="Conta | Ateliê Ótico">
  <section class="account-page">
    <header><p>CONTA DE CLIENTE</p><h1>Entrar ou criar conta</h1></header>
    <div class="account-grid">
      <form data-login><h2>Entrar</h2><input type="email" name="email" placeholder="Email" required/><input type="password" name="password" placeholder="Palavra-passe" required/><button>ENTRAR</button><p data-login-status></p></form>
      <form data-register><h2>Criar conta</h2><input type="text" name="name" placeholder="Nome" required/><input type="email" name="email" placeholder="Email" required/><input type="password" name="password" placeholder="Palavra-passe (mín. 6 caracteres)" minlength="6" required/><button>CRIAR CONTA</button><p data-register-status></p></form>
    </div>
  </section>
  <script>
    import { supabase } from '../lib/supabase';
    const login=document.querySelector('[data-login]');const register=document.querySelector('[data-register]');
    login?.addEventListener('submit',async(e)=>{e.preventDefault();const f=new FormData(login);const s=document.querySelector('[data-login-status]');const {error}=await supabase.auth.signInWithPassword({email:String(f.get('email')),password:String(f.get('password'))});s.textContent=error?error.message:'Sessão iniciada com sucesso.'});
    register?.addEventListener('submit',async(e)=>{e.preventDefault();const f=new FormData(register);const s=document.querySelector('[data-register-status]');const {error}=await supabase.auth.signUp({email:String(f.get('email')),password:String(f.get('password')),options:{data:{name:String(f.get('name'))}}});s.textContent=error?error.message:'Conta criada. Verifique o seu email para confirmar.'});
  </script>
</StoreLayout>
<style>.account-page{max-width:1280px;margin:auto;padding:80px 5vw 120px}.account-page header{text-align:center;margin-bottom:60px}.account-page h1{font-size:clamp(38px,5vw,64px);margin:8px 0}.account-grid{display:grid;grid-template-columns:1fr 1fr;gap:8vw}.account-grid form{display:grid;gap:18px}.account-grid input{height:52px;border:0;border-bottom:1px solid #999;padding:0 4px}.account-grid button{height:50px;background:#000;color:#fff;border:0;font-weight:700}@media(max-width:700px){.account-grid{grid-template-columns:1fr}}</style>
