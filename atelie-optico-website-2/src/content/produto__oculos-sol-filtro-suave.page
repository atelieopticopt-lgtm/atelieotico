<script id="atelie-exit-intent-js">
(function(){
  var KEY='atelie-sp-seen';
  var modal=document.getElementById('atelie-subscribe-popup-modal');
  // Defuse any scroll-lock the theme may still have applied on load.
  function unlock(){
    document.body.classList.remove('qodef-sp-opened');
    document.documentElement.style.overflow='';
    document.body.style.overflow='';
    document.body.style.position='';
  }
  unlock();
  [100,400,1200].forEach(function(t){ setTimeout(unlock,t); });
  if(!modal) return;
  try{ if(localStorage.getItem(KEY)==='1') return; }catch(e){}
  var shown=false;
  function close(){ modal.classList.remove('atelie-sp-show'); try{localStorage.setItem(KEY,'1');}catch(e){} }
  function open(){ if(shown) return; shown=true; modal.classList.add('atelie-sp-show'); }
  // exit intent: pointer leaves through the top edge of the window
  document.addEventListener('mouseout',function(e){
    if(shown) return;
    if(!e.relatedTarget && !e.toElement && e.clientY<=0){ open(); }
  });
  document.addEventListener('click',function(e){
    var t=e.target;
    if(t.closest('.qodef-sp-close') ||
       t.id==='atelie-subscribe-popup-modal' ||
       (t.className && String(t.className).indexOf('qodef-sp-overlay')>-1)){ close(); }
  });
  document.addEventListener('keyup',function(e){ if(e.key==='Escape'&&shown) close(); });
})();
