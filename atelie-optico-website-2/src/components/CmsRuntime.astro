---
import '../styles/design-system.css'
---

<script>
  import { supabase } from '../lib/supabase'

  async function applyManagedContent() {
    const path = location.pathname.endsWith('/') ? location.pathname : `${location.pathname}/`
    const { data, error } = await supabase
      .from('page_content')
      .select('selector,property,value')
      .eq('page_path', path)
      .eq('is_active', true)
    if (error || !data) return
    for (const item of data) {
      let nodes
      try { nodes = document.querySelectorAll(item.selector) } catch { continue }
      nodes.forEach((node) => {
        if (item.property === 'text') node.textContent = item.value
        else if (item.property === 'html') node.innerHTML = item.value
        else if (item.property === 'src' && node instanceof HTMLImageElement) node.src = item.value
        else if (item.property === 'href' && node instanceof HTMLAnchorElement) node.href = item.value
      })
    }
  }

  function installBrandMarquee() {
    const list = document.querySelector('.qodef-clients-list')
    const track = list?.querySelector('.qodef-grid-inner')
    if (!list || !track || track.classList.contains('atelie-brand-track')) return
    list.classList.add('atelie-brand-marquee')
    track.classList.add('atelie-brand-track')
    const seen = new Set<string>()
    const originals = [...track.children].filter((item) => {
      const image = item.querySelector('.qodef-e-logo img') as HTMLImageElement | null
      const key = image?.getAttribute('src')?.replace(/brand-5\.png(?:\?.*)?$/i, 'brand-1.png') || item.textContent?.trim() || ''
      if (seen.has(key)) { item.remove(); return false }
      seen.add(key); return true
    })
    originals.forEach((item) => track.append(item.cloneNode(true)))
    const style = document.createElement('style')
    style.textContent = `
      .atelie-brand-marquee{width:100%!important;overflow:hidden!important;padding:34px 0;background:transparent!important}
      .atelie-brand-track{display:flex!important;align-items:center!important;width:max-content!important;gap:64px!important;background:transparent!important;animation:atelie-marquee 28s linear infinite;will-change:transform}
      .atelie-brand-track>.qodef-grid-item{display:flex!important;flex:0 0 230px!important;width:230px!important;align-items:center;justify-content:center;margin:0!important;padding:0 24px!important;border:0!important;background:transparent!important;box-shadow:none!important}
      .atelie-brand-track .qodef-e-image,.atelie-brand-track .qodef-e-inner,.atelie-brand-track a,.atelie-brand-track picture{display:flex!important;align-items:center;justify-content:center;width:100%;border:0!important;background:transparent!important;box-shadow:none!important}
      .atelie-brand-track img{display:block!important;width:auto!important;max-width:190px!important;height:76px!important;object-fit:contain!important;background:transparent!important;mix-blend-mode:multiply;filter:contrast(1.12)}
      .atelie-brand-track .qodef-e-hover-logo{display:none!important}
      .atelie-brand-marquee:hover .atelie-brand-track{animation-play-state:paused}
      @keyframes atelie-marquee{from{transform:translateX(0)}to{transform:translateX(calc(-50% - 32px))}}
      @media(prefers-reduced-motion:reduce){.atelie-brand-track{animation-play-state:paused}}
    `
    document.head.append(style)
  }

  function response(form, text, error = false) {
    const output = form.querySelector('.qodef-m-response,.wpcf7-response-output') || document.createElement('div')
    if (!output.parentNode) form.append(output)
    output.textContent = text
    output.style.cssText = `display:block;margin-top:16px;padding:12px 14px;border:1px solid ${error?'#d75b55':'#4f9b73'};color:${error?'#a12620':'#246b49'};background:${error?'#fff0ef':'#effaf4'}`
  }

  async function submitContact(form) {
    const fields = Object.fromEntries(new FormData(form).entries())
    const button = form.querySelector('[type="submit"]')
    if (button) button.disabled = true
    try {
      const { data: { session } } = await supabase.auth.getSession()
      const { data, error } = await supabase.functions.invoke('submit-contact', {
        headers: session ? { Authorization: `Bearer ${session.access_token}` } : {},
        body: { page: location.pathname, fields }
      })
      if (error || data?.error) throw new Error(data?.error || error?.message)
      form.reset()
      response(form, 'Obrigado. O seu pedido foi recebido e será respondido brevemente.')
    } catch (error) { response(form, error instanceof Error ? error.message : 'Não foi possível enviar o pedido.', true) }
    finally { if (button) button.disabled = false }
  }

  async function submitAuth(form) {
    const isLogin = form.id === 'qodef-membership-login-modal-part'
    const isRegister = form.id === 'qodef-membership-register-modal-part'
    const email = (form.querySelector('[name="user_email"],[name="user_name"],[name="user_login"]') as HTMLInputElement)?.value.trim()
    const password = (form.querySelector('[name="user_password"]') as HTMLInputElement)?.value || ''
    try {
      if (isLogin) {
        const { error } = await supabase.auth.signInWithPassword({ email, password })
        if (error) throw error
        response(form, 'Sessão iniciada com sucesso.')
        setTimeout(() => location.reload(), 500)
      } else if (isRegister) {
        const confirm = (form.querySelector('[name="user_confirm_password"]') as HTMLInputElement)?.value
        if (password !== confirm) throw new Error('As palavras-passe não coincidem.')
        const username = (form.querySelector('[name="user_name"]') as HTMLInputElement)?.value.trim()
        const { error } = await supabase.auth.signUp({ email, password, options: { data: { username } } })
        if (error) throw error
        response(form, 'Conta criada. Confirme o endereço através do email enviado.')
      } else {
        const { error } = await supabase.auth.resetPasswordForEmail(email, { redirectTo: `${location.origin}/minha-conta/recuperar-palavra-passe/` })
        if (error) throw error
        response(form, 'Enviámos as instruções para redefinir a palavra-passe.')
      }
    } catch (error) { response(form, error instanceof Error ? error.message : 'Não foi possível concluir o pedido.', true) }
  }

  function installFormsAndAuth() {
    document.querySelectorAll('#qodef-membership-login-modal-part [name="user_name"]').forEach((input) => {
      input.setAttribute('type','email'); input.setAttribute('placeholder','Email *')
    })
    document.addEventListener('submit', (event) => {
      const form = event.target as HTMLFormElement
      if (!(form instanceof HTMLFormElement)) return
      if (form.matches('#qodef-membership-login-modal-part,#qodef-membership-register-modal-part,#qodef-membership-reset-password-modal-part')) {
        event.preventDefault(); event.stopImmediatePropagation(); submitAuth(form)
      } else if (form.matches('.wpcf7-form')) {
        event.preventDefault(); event.stopImmediatePropagation(); submitContact(form)
      }
    }, true)
  }

  type StoreProduct = { id:string; sku:string|null; slug:string; name:string; pvp:number|null; currency:string; description:string|null; display_order?:number; product_images?:Array<{id:string;image_url:string;alt_text:string|null;position:number}> }
  const store = { products: [] as StoreProduct[], bySku: new Map<string,StoreProduct>(), wishlist: [] as string[], cart: [] as Array<{slug:string;quantity:number}>, saved: {} as Record<string,StoreProduct> }
  const readJson = (key:string, fallback:any) => { try { return JSON.parse(localStorage.getItem(key) || '') } catch { return fallback } }
  const saveStore = () => { localStorage.setItem('atelie-wishlist',JSON.stringify(store.wishlist)); localStorage.setItem('atelie-cart',JSON.stringify(store.cart)); localStorage.setItem('atelie-saved-products',JSON.stringify(store.saved)); updateStoreCounts(); renderCartDrawer() }
  const productCard = (node:Element) => node.closest('li.product,.qodef-e,.product') as HTMLElement | null
  function productFor(node:Element) {
    const card=productCard(node), sku=(node.closest('[data-product_sku]') as HTMLElement)?.dataset.product_sku || (card?.querySelector('[data-product_sku]') as HTMLElement)?.dataset.product_sku
    if(sku && store.bySku.has(sku)) return store.bySku.get(sku)!
    const href=(card?.querySelector('a[href*="/produto/"]') as HTMLAnchorElement)?.href || location.href
    const slug=href.match(/\/produto\/([^/?#]+)/)?.[1]
    const known=store.products.find(p=>p.slug===slug);if(known)return known
    const priceText=(card?.querySelector('.price ins .amount,.price ins,.price .amount,.price')?.textContent||'').replace(/[^\d,.]/g,'').replace(/\.(?=\d{3}(?:\D|$))/g,'').replace(',','.')
    const image=card?.querySelector('img') as HTMLImageElement|null
    return {id:'',sku:sku||null,slug:slug||String((node as HTMLElement).dataset.itemId||''),name:(card?.querySelector('.woocommerce-loop-product__title,.qodef-e-title')?.textContent||'Produto').trim(),pvp:Number.isFinite(Number(priceText))?Number(priceText):null,currency:'EUR',description:null,product_images:image?[{id:'local',image_url:image.currentSrc||image.src,alt_text:image.alt||null,position:0}]:[]} as StoreProduct
  }
  function updateStoreCounts(){document.querySelectorAll('.qodef-wishlist-count').forEach(n=>n.textContent=String(store.wishlist.length));document.querySelectorAll('.qodef-m-opener-count,.qodef-cart-count').forEach(n=>n.textContent=String(store.cart.reduce((s,i)=>s+i.quantity,0)))}
  function toast(text:string){let el=document.querySelector('.atelie-store-toast') as HTMLElement|null;if(!el){el=document.createElement('div');el.className='atelie-store-toast';document.body.append(el)}el.textContent=text;el.classList.add('show');setTimeout(()=>el?.classList.remove('show'),2200)}
  function quickView(product:StoreProduct){
    document.querySelector('.atelie-quickview')?.remove(); const images=[...(product.product_images||[])].sort((a,b)=>a.position-b.position); const modal=document.createElement('div');modal.className='atelie-quickview';modal.innerHTML=`<div class="atelie-quickview-card" role="dialog" aria-modal="true"><button class="atelie-qv-close" aria-label="Fechar">×</button><div class="atelie-qv-gallery"></div><div><small>${product.sku||''}</small><h2></h2><p class="atelie-qv-price"></p><p class="atelie-qv-desc"></p><div class="atelie-qv-actions"><a class="atelie-qv-link">Ver produto</a><button class="atelie-qv-cart">Adicionar ao carrinho</button></div></div></div>`;modal.querySelector('h2')!.textContent=product.name;modal.querySelector('.atelie-qv-price')!.textContent=product.pvp==null?'Preço sob consulta':new Intl.NumberFormat('pt-PT',{style:'currency',currency:product.currency||'EUR'}).format(product.pvp);modal.querySelector('.atelie-qv-desc')!.textContent=product.description||'';(modal.querySelector('.atelie-qv-link') as HTMLAnchorElement).href=`/produto/${product.slug}/`;const gallery=modal.querySelector('.atelie-qv-gallery')!;images.forEach((im,i)=>{const img=document.createElement('img');img.src=im.image_url;img.alt=im.alt_text||product.name;if(i)img.hidden=true;gallery.append(img)});if(!images.length){const img=document.createElement('img');img.src=(document.querySelector(`a[href*="/produto/${product.slug}/"] img`) as HTMLImageElement)?.src||'';img.alt=product.name;gallery.append(img)};modal.addEventListener('click',e=>{if(e.target===modal||(e.target as Element).closest('.atelie-qv-close'))modal.remove();if((e.target as Element).closest('.atelie-qv-cart')){addCart(product);modal.remove()}});document.body.append(modal)
  }
  const rememberProduct = (product:StoreProduct) => { if(product.slug) store.saved[product.slug]={...product,product_images:[...(product.product_images||[])]} }
  const savedProduct = (slug:string) => store.products.find(p=>p.slug===slug) || store.saved[slug]
  const productImage = (product:StoreProduct) => [...(product.product_images||[])].sort((a,b)=>a.position-b.position)[0]?.image_url || (document.querySelector(`a[href*="/produto/${product.slug}/"] img`) as HTMLImageElement|null)?.src || ''
  const productPrice = (product:StoreProduct) => product.pvp==null?'Preço sob consulta':new Intl.NumberFormat('pt-PT',{style:'currency',currency:product.currency||'EUR'}).format(product.pvp)
  function renderCatalogueProducts(){
    if(!/^\/loja(?:\/|$)/.test(location.pathname) && location.pathname!=='/categoria/nova-colecao/')return
    const list=document.querySelector('ul.products') as HTMLElement|null;if(!list)return
    const products=store.products.filter(product=>product.product_images?.length).sort((a,b)=>(a.display_order??999999)-(b.display_order??999999)||a.name.localeCompare(b.name,'pt'))
    list.replaceChildren(...products.map(product=>{const card=document.createElement('li');card.className='product type-product atelie-catalogue-product';card.dataset.sku=product.sku||'';card.innerHTML=`<div class="qodef-e-inner"><button class="atelie-product-photo" type="button" aria-label="Ver produto"><img loading="lazy" decoding="async"></button><div class="qodef-woo-product-content"><h6 class="qodef-woo-product-title woocommerce-loop-product__title"></h6><div class="qodef-woo-product-categories qodef-e-info"></div><span class="price"></span><div class="atelie-card-actions"><button class="atelie-card-wish" type="button" aria-label="Adicionar aos favoritos">♡</button><button class="atelie-card-cart" type="button">Adicionar ao carrinho</button><button class="atelie-card-view" type="button" aria-label="Vista rápida">⌕</button></div></div></div>`;const image=card.querySelector('img') as HTMLImageElement;image.src=productImage(product);image.alt=product.product_images?.[0]?.alt_text||product.name;card.querySelector('.woocommerce-loop-product__title')!.textContent=product.name;card.querySelector('.qodef-woo-product-categories')!.textContent=product.sku||'Ateliê Ótico';card.querySelector('.price')!.textContent=productPrice(product);(card.querySelector('.atelie-product-photo') as HTMLButtonElement).onclick=()=>quickView(product);(card.querySelector('.atelie-card-view') as HTMLButtonElement).onclick=()=>quickView(product);(card.querySelector('.atelie-card-cart') as HTMLButtonElement).onclick=()=>addCart(product);const wish=card.querySelector('.atelie-card-wish') as HTMLButtonElement;wish.classList.toggle('selected',store.wishlist.includes(product.slug));wish.onclick=()=>{const index=store.wishlist.indexOf(product.slug);if(index>=0)store.wishlist.splice(index,1);else{store.wishlist.push(product.slug);rememberProduct(product)}wish.classList.toggle('selected',index<0);saveStore();toast(index<0?'Adicionado aos favoritos.':'Removido dos favoritos.')};return card}))
    document.querySelectorAll('.woocommerce-result-count').forEach(node=>node.textContent=`A mostrar todos os ${products.length} produtos`)
  }
  function closeCartDrawer(){document.querySelector('.atelie-cart-drawer')?.classList.remove('open');document.documentElement.classList.remove('atelie-cart-locked');document.body.classList.remove('atelie-cart-locked')}
  function renderCartDrawer(){const drawer=document.querySelector('.atelie-cart-drawer') as HTMLElement|null;if(!drawer)return;const list=drawer.querySelector('.atelie-cart-list')!;list.replaceChildren();const products=store.cart.map(item=>({item,product:savedProduct(item.slug)})).filter(entry=>entry.product) as Array<{item:{slug:string;quantity:number};product:StoreProduct}>;drawer.querySelector('.atelie-cart-empty')?.toggleAttribute('hidden',products.length>0);drawer.querySelector('.atelie-cart-footer')?.toggleAttribute('hidden',products.length===0);products.forEach(({item,product})=>{const row=document.createElement('article');row.className='atelie-cart-item';row.innerHTML='<a><img alt=""></a><div><a class="atelie-cart-name"></a><p></p><label>Quantidade <input type="number" min="1"></label></div><button type="button" aria-label="Remover">×</button>';const links=row.querySelectorAll('a');links.forEach(link=>(link as HTMLAnchorElement).href=`/produto/${product.slug}/`);const image=row.querySelector('img') as HTMLImageElement;image.src=productImage(product);image.alt=product.name;row.querySelector('.atelie-cart-name')!.textContent=product.name;row.querySelector('p')!.textContent=productPrice(product);const input=row.querySelector('input') as HTMLInputElement;input.value=String(item.quantity);input.onchange=()=>{item.quantity=Math.max(1,Number(input.value)||1);saveStore()};row.querySelector('button')!.onclick=()=>{store.cart=store.cart.filter(entry=>entry.slug!==item.slug);saveStore()};list.append(row)})}
  function openCartDrawer(){let drawer=document.querySelector('.atelie-cart-drawer') as HTMLElement|null;if(!drawer){drawer=document.createElement('div');drawer.className='atelie-cart-drawer';drawer.innerHTML='<button class="atelie-cart-backdrop" type="button" aria-label="Fechar carrinho"></button><aside role="dialog" aria-modal="true" aria-label="Carrinho"><header><h2>Carrinho</h2><button class="atelie-cart-close" type="button" aria-label="Fechar">×</button></header><div class="atelie-cart-list"></div><div class="atelie-cart-empty"><p>Sem produtos no carrinho.</p><button class="atelie-cart-continue" type="button">Continuar a comprar</button></div><footer class="atelie-cart-footer"><a href="/carrinho/">Ver carrinho</a><a href="/finalizar-compra/">Finalizar compra</a></footer></aside>';drawer.addEventListener('click',event=>{if((event.target as Element).closest('.atelie-cart-backdrop,.atelie-cart-close,.atelie-cart-continue'))closeCartDrawer()});document.body.append(drawer)}renderCartDrawer();requestAnimationFrame(()=>drawer?.classList.add('open'));document.documentElement.classList.add('atelie-cart-locked');document.body.classList.add('atelie-cart-locked')}
  function addCart(product:StoreProduct){if(!product.slug)return;rememberProduct(product);const item=store.cart.find(i=>i.slug===product.slug);if(item)item.quantity++;else store.cart.push({slug:product.slug,quantity:1});saveStore();toast(`${product.name} foi adicionado ao carrinho.`);openCartDrawer()}
  function renderSavedPage(){const type=location.pathname.startsWith('/favoritos')?'wishlist':location.pathname.startsWith('/carrinho')?'cart':null;if(!type)return;const slugs=type==='wishlist'?store.wishlist:store.cart.map(i=>i.slug),items=slugs.map(savedProduct).filter(Boolean) as StoreProduct[];const main=document.querySelector('#qodef-page-inner,main,.qodef-content-grid') as HTMLElement|null;if(!main)return;main.querySelector('.atelie-saved-page')?.remove();const section=document.createElement('section');section.className='atelie-saved-page';section.innerHTML=`<h1>${type==='wishlist'?'Favoritos':'Carrinho'}</h1><div class="atelie-saved-grid"></div>${items.length?'':`<p>${type==='wishlist'?'Ainda não adicionou produtos aos favoritos.':'O carrinho está vazio.'}</p>`}`;const grid=section.querySelector('.atelie-saved-grid')!;items.forEach(p=>{const qty=store.cart.find(i=>i.slug===p.slug)?.quantity||1,img=productImage(p);const card=document.createElement('article');card.className='atelie-saved-card';card.innerHTML=`<a><img alt=""><h2></h2></a><p></p>${type==='cart'?'<label>Quantidade <input type="number" min="1"></label>':''}<button>Remover</button>`;(card.querySelector('a') as HTMLAnchorElement).href=`/produto/${p.slug}/`;const image=card.querySelector('img') as HTMLImageElement;image.src=img;image.alt=p.name;card.querySelector('h2')!.textContent=p.name;card.querySelector('p')!.textContent=productPrice(p);const input=card.querySelector('input') as HTMLInputElement|null;if(input){input.value=String(qty);input.onchange=()=>{const item=store.cart.find(i=>i.slug===p.slug);if(item)item.quantity=Math.max(1,Number(input.value)||1);saveStore()}}card.querySelector('button')!.onclick=()=>{if(type==='wishlist')store.wishlist=store.wishlist.filter(s=>s!==p.slug);else store.cart=store.cart.filter(i=>i.slug!==p.slug);saveStore();renderSavedPage()};grid.append(card)});main.prepend(section)}
  function applyProductImages(){
    document.querySelectorAll('li.product,.qodef-e').forEach(card=>{const link=card.querySelector('a[href*="/produto/"]') as HTMLAnchorElement|null,slug=link?.href.match(/\/produto\/([^/?#]+)/)?.[1],p=store.products.find(x=>x.slug===slug)||store.bySku.get((card.querySelector('[data-product_sku]') as HTMLElement)?.dataset.product_sku||'');const first=[...(p?.product_images||[])].sort((a,b)=>a.position-b.position)[0];const img=card.querySelector('img') as HTMLImageElement|null;if(first&&img){img.src=first.image_url;img.srcset='';img.alt=first.alt_text||p!.name;img.loading='lazy'}})
    document.querySelectorAll('ul.products').forEach(list=>{const nodes=[...list.children];nodes.sort((a,b)=>{const pa=productFor(a),pb=productFor(b);return (pa.display_order??999999)-(pb.display_order??999999)}).forEach(n=>list.append(n))});renderCatalogueProducts();const detailSlug=location.pathname.match(/\/produto\/([^/]+)/)?.[1],detail=store.products.find(p=>p.slug===detailSlug);if(detail?.product_images?.length){const imgs=[...detail.product_images].sort((a,b)=>a.position-b.position),gallery=document.querySelector('.woocommerce-product-gallery,.qodef-woo-single-image') as HTMLElement|null;if(gallery){const main=gallery.querySelector('img') as HTMLImageElement|null;if(main){main.src=imgs[0].image_url;main.srcset='';main.alt=imgs[0].alt_text||detail.name}let thumbs=gallery.querySelector('.atelie-product-thumbs');if(!thumbs){thumbs=document.createElement('div');thumbs.className='atelie-product-thumbs';gallery.append(thumbs)}thumbs.replaceChildren(...imgs.map(im=>{const b=document.createElement('button');b.type='button';b.innerHTML=`<img src="${im.image_url}" alt="${im.alt_text||detail.name}">`;b.onclick=()=>{if(main)main.src=im.image_url};return b}))}}renderSavedPage()
  }
  async function loadStoreProducts(){const[{data},manifestResponse]=await Promise.all([supabase.from('products').select('id,sku,slug,name,pvp,currency,description,display_order,product_images(id,image_url,alt_text,position)').eq('is_active',true).order('display_order').order('name'),fetch('/data/amevista-products.json').catch(()=>null)]);const database=(data||[]) as StoreProduct[],manifest=manifestResponse?.ok?await manifestResponse.json() as StoreProduct[]:[],bySku=new Map(database.filter(p=>p.sku).map(p=>[p.sku!,p]));manifest.forEach(scraped=>{const current=scraped.sku?bySku.get(scraped.sku):undefined;if(current){if(!current.product_images?.length)current.product_images=scraped.product_images;if(current.pvp==null)current.pvp=scraped.pvp;if(!current.name)current.name=scraped.name}else database.push(scraped)});store.products=database;store.bySku=new Map(store.products.filter(p=>p.sku).map(p=>[p.sku!,p]));applyProductImages()}
  function installStore(){
    store.wishlist=readJson('atelie-wishlist',[]);store.cart=readJson('atelie-cart',[]);store.saved=readJson('atelie-saved-products',{});document.querySelectorAll('.qodef-wishlist-widget-link').forEach(link=>(link as HTMLAnchorElement).href='/favoritos/');document.querySelectorAll('.widget_neoocular_core_woo_side_area_cart .qodef-m-opener').forEach(link=>(link as HTMLAnchorElement).href='/carrinho/');updateStoreCounts();renderSavedPage();loadStoreProducts();
    document.addEventListener('click',e=>{const target=e.target as Element;const wishlistPage=target.closest('.qodef-wishlist-widget-link'),cartOpener=target.closest('.widget_neoocular_core_woo_side_area_cart .qodef-m-opener'),wish=target.closest('.qwfw-add-to-wishlist'),cart=target.closest('.add_to_cart_button'),quick=target.closest('.qqvfw-quick-view-button');if(wishlistPage){e.preventDefault();e.stopImmediatePropagation();location.assign('/favoritos/');return}if(cartOpener){e.preventDefault();e.stopImmediatePropagation();openCartDrawer();return}if(!wish&&!cart&&!quick)return;e.preventDefault();e.stopImmediatePropagation();const p=productFor((wish||cart||quick)!);rememberProduct(p);if(wish){const i=store.wishlist.indexOf(p.slug);i>=0?store.wishlist.splice(i,1):store.wishlist.push(p.slug);wish.classList.toggle('atelie-selected',i<0);saveStore();toast(i<0?'Adicionado aos favoritos.':'Removido dos favoritos.')}else if(cart)addCart(p);else quickView(p)},true)
    supabase.channel('store-products-live').on('postgres_changes',{event:'*',schema:'public',table:'product_images'},loadStoreProducts).on('postgres_changes',{event:'UPDATE',schema:'public',table:'products'},loadStoreProducts).subscribe()
