---
import CmsRuntime from '~/components/CmsRuntime.astro'
const posts = [
  { href:'/21-formas-tendencia/', title:'21 formas e tendências em óculos', excerpt:'Um guia para descobrir formatos, estilos e armações que valorizam cada rosto.' },
  { href:'/armacoes-que-combinam-consigo/', title:'Armações que combinam consigo', excerpt:'Como escolher proporções, cores e materiais adequados ao seu rosto e estilo.' },
  { href:'/conselhos-saude-visual/', title:'Conselhos de saúde visual', excerpt:'Cuidados práticos para proteger a visão e reconhecer quando deve marcar uma consulta.' },
  { href:'/o-que-e-a-luz-azul/', title:'O que é a luz azul?', excerpt:'O que precisa de saber sobre exposição digital, conforto visual e proteção.' },
  { href:'/tecnologia-lentes/', title:'Tecnologia em lentes', excerpt:'Tratamentos, materiais e soluções óticas para diferentes necessidades visuais.' },
  { href:'/tendencias-verao/', title:'Tendências de óculos para o verão', excerpt:'Cores, formatos e detalhes que definem a estação.' },
  { href:'/ultimas-tendencias-oculos/', title:'Últimas tendências em óculos', excerpt:'Uma seleção editorial das novidades que estão a transformar o olhar.' },
  { href:'/personalize-os-seus-oculos/', title:'Personalize os seus óculos', excerpt:'Ideias para tornar a sua armação verdadeiramente pessoal.' },
]
---
<!doctype html>
<html lang="pt-PT">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Blog de Ótica e Saúde Visual | Ateliê Ótico Funchal</title>
  <meta name="description" content="Artigos do Ateliê Ótico sobre saúde visual, optometria, armações, lentes e tendências de óculos no Funchal, Madeira." />
  <link rel="canonical" href="https://atelieotico.pt/blog/" />
  <meta property="og:title" content="Blog — Ateliê Ótico" /><meta property="og:description" content="Guias de saúde visual, lentes, armações e estilo pelo Ateliê Ótico no Funchal." /><meta property="og:url" content="https://atelieotico.pt/blog/" /><meta property="og:type" content="website" /><meta property="og:locale" content="pt_PT" /><meta property="og:site_name" content="Ateliê Ótico" />
  <script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'Blog',name:'Blog Ateliê Ótico',url:'https://atelieotico.pt/blog/',publisher:{'@type':'Organization',name:'Ateliê Ótico'}})} />
  <style>body{margin:0;color:#1d1917;background:#f8f5f1;font-family:Arial,sans-serif}header{padding:28px 6%;border-top:4px solid #3a2938;background:#fff}header img{width:170px}main{max-width:1240px;margin:auto;padding:80px 28px}h1{margin:0;font-size:clamp(38px,6vw,72px)}.intro{max-width:720px;margin:18px 0 46px;color:#6f635b;font-size:19px;line-height:1.7}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}.card{display:flex;min-height:260px;flex-direction:column;padding:30px;border:1px solid #e6ddd3;border-radius:14px;background:#fff;color:inherit;text-decoration:none;box-shadow:0 12px 30px #553d2010;transition:.2s}.card:hover{transform:translateY(-4px);border-color:#bd8843}.card small{color:#bd8843;font-weight:800;text-transform:uppercase;letter-spacing:.08em}.card h2{margin:30px 0 12px;font-size:24px}.card p{margin:0;color:#746a63;line-height:1.6}.card span{margin-top:auto;padding-top:25px;font-weight:800}@media(max-width:850px){.grid{grid-template-columns:1fr 1fr}}@media(max-width:560px){.grid{grid-template-columns:1fr}}</style>
</head>
<body><header><a href="/"><img src="/img/atelie/logo-atelie-gold.jpeg" alt="Ateliê Ótico" /></a></header><main id="main"><h1>Olhar, saúde e estilo</h1><p class="intro">Conteúdo do Ateliê Ótico sobre optometria, cuidados com a visão, tecnologia de lentes e escolhas de armações no Funchal.</p><div class="grid">{posts.map(post=><a class="card" href={post.href}><small>Ateliê editorial</small><h2>{post.title}</h2><p>{post.excerpt}</p><span>Ler artigo →</span></a>)}</div></main><CmsRuntime /></body>
</html>
