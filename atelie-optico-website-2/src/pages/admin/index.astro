    .modal-head>div small{display:block;margin-top:4px;color:var(--muted)}.upload-zone{position:relative;display:grid;place-items:center;gap:6px;padding:24px;border:2px dashed #c89552;border-radius:12px;background:#fffaf2;text-align:center;cursor:pointer}.upload-zone:hover{background:#fff5e5}.upload-zone span{color:var(--muted);font-size:13px}.upload-zone input,.replace-file input{position:absolute;width:1px;height:1px;opacity:0}.gallery-help{display:flex;align-items:end;justify-content:space-between;gap:15px;margin:22px 0 10px}.gallery-help span{color:var(--muted);font-size:13px}.image-list{display:grid!important;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:14px!important;margin:0 0 22px!important}.image-list:empty:after{content:'Ainda não existem imagens. Carregue fotografias para criar o carrossel.';grid-column:1/-1;padding:34px;border:1px solid #eadfd3;border-radius:11px;color:var(--muted);text-align:center;background:#faf8f5}.image-row{position:relative!important;display:flex!important;min-width:0;flex-direction:column;overflow:hidden;padding:0!important;border:1px solid #e4d8ca;border-radius:11px;background:#fff}.image-row>.drag-handle{position:absolute!important;right:9px;top:9px;align-self:auto!important;padding:5px 9px!important}.image-row img{display:block;width:100%!important;height:150px!important;object-fit:contain;background:#f7f4ef}.image-meta{display:flex;min-width:0;flex:1;flex-direction:column;gap:5px;padding:12px}.image-meta strong,.image-meta small{display:block;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.image-position{position:absolute;left:9px;top:9px;z-index:2;padding:5px 9px;border-radius:20px;background:#fff;color:#6a481f;font-size:11px;font-weight:800;box-shadow:0 2px 8px #0002}.image-actions{display:grid;grid-template-columns:1fr auto;gap:8px;padding:0 12px 12px}.replace-file{display:flex;align-items:center;justify-content:center;min-height:38px;border:1px solid #d8c7b4;border-radius:8px;font-weight:800;cursor:pointer}.image-actions .danger{padding:8px 10px}.form-section-title{font-weight:800}.affix-input{position:relative}.affix-input input{padding-right:48px}.affix-input span{position:absolute;right:1px;top:1px;bottom:1px;display:grid;min-width:44px;place-items:center;border-left:1px solid #e0d5c9;border-radius:0 7px 7px 0;background:#faf4eb;color:#7b5222;font-weight:900}#media-dialog{width:min(1040px,96vw)}
    #media-dialog[open]{display:flex;height:min(92vh,900px);max-height:92vh;flex-direction:column;overflow:hidden}#media-dialog .modal-head,#media-dialog .modal-actions{flex:0 0 auto}#media-dialog .modal-body{min-height:0;flex:1 1 auto;padding-bottom:44px;overflow-y:auto;overscroll-behavior:contain}#media-dialog .modal-actions{position:relative;z-index:4;background:#fff}.image-row{min-height:330px}.image-row img{flex:0 0 150px}.image-actions{margin-top:auto}.product-catalog{display:grid;grid-template-columns:repeat(auto-fill,minmax(245px,1fr));gap:18px;padding:22px;background:#fbf9f6}.catalog-card{position:relative;display:flex;min-width:0;flex-direction:column;overflow:hidden;border:1px solid #e5d9cb;border-radius:13px;background:#fff;box-shadow:0 4px 15px #523a2010}.catalog-card:hover{border-color:#d5b98f}.catalog-select{position:absolute;left:12px;top:12px;z-index:3;display:grid;width:30px;height:30px;place-items:center;border-radius:50%;background:#fff;box-shadow:0 2px 10px #0002}.catalog-select input{width:16px;min-height:auto;height:16px}.catalog-photo{position:relative;display:block;width:100%;height:190px;padding:0;border:0;border-bottom:1px solid #eee5db;border-radius:0;background:linear-gradient(180deg,#fff,#f5f1eb);cursor:pointer}.catalog-photo img{display:block;width:100%;height:100%;padding:15px;object-fit:contain}.catalog-photo .photo-count{position:absolute;right:10px;bottom:10px;padding:5px 8px;border-radius:20px;background:#211c21dd;color:#fff;font-size:11px;font-weight:800}.catalog-content{display:flex;min-height:140px;flex:1;flex-direction:column;padding:15px}.catalog-content h3{display:-webkit-box;min-height:42px;margin:0 0 6px;overflow:hidden;color:#201b18;font-size:16px;line-height:1.35;-webkit-box-orient:vertical;-webkit-line-clamp:2}.catalog-reference{overflow:hidden;margin-bottom:11px;color:#8b8179;font-size:12px;text-overflow:ellipsis;white-space:nowrap}.catalog-facts{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-top:auto}.catalog-fact{padding:8px;border-radius:8px;background:#faf7f3}.catalog-fact span{display:block;color:#907f70;font-size:10px;text-transform:uppercase;letter-spacing:.05em}.catalog-fact strong{display:block;margin-top:3px;overflow:hidden;color:#513b27;font-size:13px;text-overflow:ellipsis;white-space:nowrap}.catalog-status{position:absolute;right:10px;top:10px;z-index:3}.catalog-actions{display:grid;grid-template-columns:1fr 1fr;gap:8px;padding:0 15px 15px}.catalog-actions button{width:100%;min-width:0}.catalog-actions [data-edit]{border-color:#b47c37;background:#fff8ee;color:#6e471c;font-weight:800}@media(max-width:680px){.product-catalog{grid-template-columns:1fr;padding:14px}.catalog-photo{height:220px}.gallery-help{align-items:flex-start;flex-direction:column}.image-list{grid-template-columns:1fr!important}}
    .upload-zone.is-dropping{border-color:#7d511e;background:#f8e5c6;box-shadow:0 0 0 4px #bd884322}
    #products-panel{overflow:visible}#products-panel .panel-head{border-radius:11px 11px 0 0;background:#fff}#products-panel .bulk-bar{position:sticky;top:91px;z-index:8;border-top:1px solid #ead8bd;border-bottom:1px solid #ead8bd;box-shadow:0 7px 18px #3f2d1718}.catalog-card:has(.badge.off){border-style:dashed}.catalog-actions [data-secondary]{font-weight:800}
  </style>
</head>
<body data-configured={configured ? 'true' : 'false'}>
  <section id="login-shell">
    <div class="login-card">
      <img class="login-logo" src="/img/atelie/logo-atelie-gold.jpeg" alt="Ateliê Ótico" />
      <h1>Painel de Administração</h1>
      <form id="login-form" class="login-form">
        <label>Utilizador<input id="email" type="email" autocomplete="username" required /></label>
        <label>Palavra-passe<span class="control"><input id="password" type="password" autocomplete="current-password" required /><button id="toggle-password" class="icon-button" type="button" aria-label="Mostrar palavra-passe"><svg class="eye" viewBox="0 0 24 24"><path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"/><circle cx="12" cy="12" r="2.8"/></svg><svg class="eye-off" viewBox="0 0 24 24"><path d="M3 3l18 18"/><path d="M10.6 6.2A9.8 9.8 0 0 1 12 6c6 0 9.5 6 9.5 6a15 15 0 0 1-2.5 3.2M6.2 6.3C3.8 8 2.5 12 2.5 12s3.5 6 9.5 6a9.5 9.5 0 0 0 3-.5"/></svg></button></span></label>
        <button class="primary" type="submit">Entrar</button>
      </form>
      <p id="login-message" class="message" role="alert"></p>
    </div>
  </section>

  <div id="app" hidden>
    <aside id="sidebar" class="sidebar">
      <div class="brand"><img src="/img/atelie/atelie-logo-light.png" alt="Ateliê Ótico" /><small>Painel de gestão · Administrador</small></div>
      <nav>
        <div class="nav-group"><div class="nav-title">Visão geral</div><button class="nav-link active" data-view="dashboard"><svg viewBox="0 0 24 24"><path d="M4 13h6V4H4v9Zm10 7h6V11h-6v9ZM4 20h6v-3H4v3Zm10-13h6V4h-6v3Z"/></svg>Dashboard</button></div>
        <div class="nav-group"><div class="nav-title">Catálogo</div><button class="nav-link" data-view="all">Todos os produtos</button><button class="nav-link" data-view="categories">Categorias</button><button class="nav-link" data-view="inactive">Produtos inativos</button><button class="nav-link" data-view="trash">Lixo e recuperação</button></div>
        <div class="nav-group"><div class="nav-title">Inventário</div><button class="nav-link" data-view="stock">Gestão de stock</button><button class="nav-link" data-view="low">Stock reduzido</button><button class="nav-link" data-view="out">Sem stock</button></div>
        <div class="nav-group"><div class="nav-title">Loja e conteúdo</div><button class="nav-link" data-view="media">Imagens e ordem</button><button class="nav-link" data-view="discounts">Descontos</button><button class="nav-link" data-view="content">Conteúdo das páginas</button></div>
        <div id="users-group" class="nav-group" hidden><div class="nav-title">Administração</div><button id="users-nav" class="nav-link" data-view="users">Utilizadores e acessos</button></div>
      </nav>
      <div class="sidebar-footer"><button id="logout" class="secondary">Terminar sessão</button></div>
    </aside>
    <main class="workspace">
      <header class="topbar"><button id="mobile-menu" class="icon-button mobile-menu" aria-label="Abrir menu">☰</button><div><h1 id="workspace-title">Painel de administração</h1><div id="identity" class="identity"></div></div><div class="top-actions"><div class="search"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg><input id="search" type="search" placeholder="Pesquisar SKU, produto ou categoria…" /></div></div></header>
      <div class="content">
        <section class="stats"><article class="stat"><span>Total de produtos</span><strong id="stat-total">0</strong></article><article class="stat"><span>Valor do inventário (PVP)</span><strong id="stat-value">€0,00</strong></article><article class="stat low"><span>Stock reduzido</span><strong id="stat-low">0</strong></article><article class="stat out"><span>Sem stock</span><strong id="stat-out">0</strong></article></section>
        <section id="products-panel" class="panel"><div class="panel-head"><div><h2 id="view-title">Todos os produtos</h2><small id="result-count"></small><small class="panel-guidance">Clique numa fotografia ou em <strong>Editar produto</strong> para gerir tudo num único local.</small></div><div class="toolbar"><select id="category-filter"><option value="">Todas as categorias</option></select><button id="bulk-delete" class="danger" hidden>Eliminar selecionados</button><button id="export" class="secondary">↓ Exportar CSV</button><button id="reload" class="secondary">Atualizar</button><button id="add-product" class="primary">+ Novo produto</button></div></div><div id="bulk-bar" class="bulk-bar" hidden><span id="selected-count">0 selecionados</span><button id="clear-selection" class="secondary">Limpar seleção</button></div><div id="products" class="product-catalog"></div><div id="empty" class="empty" hidden>Nenhum produto encontrado.</div><div class="pagination"><span id="page-info"></span><div class="pagination-buttons"><button id="prev-page" class="secondary">← Anterior</button><button id="next-page" class="secondary">Seguinte →</button></div></div></section>
        <section id="media-panel" class="panel" hidden><div class="panel-head"><div><h2>Imagens e ordem dos produtos</h2><small>Arraste os produtos para ordenar a loja. Abra um produto para gerir o carrossel.</small></div><button id="save-product-order" class="primary">Guardar ordem</button></div><div id="media-products" class="media-products"></div></section>
        <section id="users-panel" class="panel users-panel" hidden><div class="panel-head"><div><h2>Utilizadores administrativos</h2><small>Super admins e admins com acesso ao painel</small></div><button id="add-user" class="primary">+ Novo utilizador</button></div><div id="users-grid" class="users-grid"></div><p class="permission-note">Apenas super admins podem criar, alterar funções, redefinir palavras-passe ou eliminar outros utilizadores. Os admins podem gerir produtos, stock, preços e descrições.</p></section>
        <section id="discounts-panel" class="panel" hidden><div class="panel-head"><div><h2>Descontos e promoções</h2><small>Crie códigos, campanhas e períodos promocionais</small></div><button id="add-discount" class="primary">+ Novo desconto</button></div><div class="table-wrap"><table class="management-table"><thead><tr><th>Campanha</th><th>Código</th><th>Desconto</th><th>Período</th><th>Estado</th><th>Ações</th></tr></thead><tbody id="discounts-list"></tbody></table><div id="discounts-empty" class="empty" hidden>Nenhum desconto criado.</div></div></section>
        <section id="content-panel" class="panel" hidden><div class="panel-head"><div><h2>Conteúdo das páginas</h2><small>Edite textos, ligações e imagens sem alterar os ficheiros Astro</small></div><button id="add-content" class="primary">+ Novo conteúdo</button></div><div class="table-wrap"><table class="management-table"><thead><tr><th>Página e secção</th><th>Seletor</th><th>Tipo</th><th>Conteúdo</th><th>Estado</th><th>Ações</th></tr></thead><tbody id="content-list"></tbody></table><div id="content-empty" class="empty" hidden>Nenhum conteúdo dinâmico configurado.</div></div></section>
      </div>
    </main>
  </div>

  <dialog id="product-dialog" class="product-editor"><form id="product-form" method="dialog"><div class="modal-head"><div><h2 id="modal-title">Editar produto</h2><small>Todos os dados deste produto num único local</small></div><button id="close-modal" class="icon-button" type="button" aria-label="Fechar">×</button></div><div class="modal-body"><input id="product-id" type="hidden" /><div class="editor-sections"><section class="editor-card"><div class="editor-card-head"><span>1</span><div><h3>Informação do produto</h3><small>Nome, referência, categoria e descrição apresentada na loja</small></div></div><div class="form-grid"><label class="field wide">Nome do produto<input id="edit-name" required /></label><label class="field">SKU / referência<input id="edit-sku" /></label><label class="field advanced">Categoria<input id="edit-category" /></label><label class="field wide">Endereço da página (slug)<input id="edit-slug" required /><small>Exemplo: calvin-klein-ck19119-717</small></label><label class="field wide advanced">Descrição<textarea id="edit-description" rows="5" placeholder="Descreva o modelo, material, cor e características..."></textarea></label></div></section><section class="editor-card"><div class="editor-card-head"><span>2</span><div><h3>Preço e inventário</h3><small>Valores comerciais e disponibilidade atual</small></div></div><div class="form-grid"><label class="field">Preço de venda — PVP (€)<input id="edit-pvp" type="number" min="0" step="0.01" /></label><label class="field advanced">Preço de custo (€)<input id="edit-cost" type="number" min="0" step="0.01" /></label><label class="field advanced">Unidades em stock<input id="edit-stock" type="number" min="0" step="1" /></label><label class="field advanced">Avisar quando restarem<input id="edit-threshold" type="number" min="0" step="1" /></label></div><label class="switch-field advanced product-visibility"><input id="edit-active" type="checkbox" checked /><span><strong>Produto ativo e visível</strong><small>Desative para esconder o produto da loja sem o eliminar.</small></span></label></section><section id="editor-media-card" class="editor-card editor-media"><div class="editor-card-head"><span>3</span><div><h3>Fotografias e carrossel</h3><small>Adicione, elimine e arraste imagens para mudar a ordem</small></div></div><div class="editor-media-action"><div><strong id="editor-image-count">0 imagens</strong><small>A primeira imagem será a capa do produto.</small></div><button id="edit-product-images" class="secondary" type="button">Gerir imagens →</button></div></section></div></div><div class="modal-actions"><button id="delete-product" class="danger" type="button">Eliminar produto</button><span class="modal-spacer"></span><button id="cancel-modal" class="secondary" type="button">Cancelar</button><button id="save-product" class="primary" type="submit">Guardar produto</button></div></form></dialog>
  <dialog id="media-dialog"><div class="modal-head"><div><h2 id="media-title">Imagens do produto</h2><small>A ordem abaixo é exatamente a ordem publicada na loja.</small></div><button id="close-media" class="icon-button" type="button">×</button></div><div class="modal-body"><label class="upload-zone" for="image-files"><strong>Carregar fotografias</strong><span>Arraste ficheiros para aqui ou clique para escolher. JPG, PNG ou WebP, até 5 MB.</span><input id="image-files" type="file" accept="image/jpeg,image/png,image/webp" multiple /></label><div class="gallery-help"><strong>Pré-visualização do carrossel</strong><span>Arraste apenas pelo puxador. A posição 1 é a capa do produto.</span></div><div id="image-list" class="image-list"></div><form id="image-form" class="image-add"><div class="form-section-title wide">Ou adicionar através de um endereço web</div><label class="field">URL da imagem<input id="image-url" type="url" placeholder="https://..." /></label><label class="field">Texto alternativo<input id="image-alt" placeholder="Descrição acessível da imagem" /></label><label class="field wide">Página de origem<input id="image-source" type="url" placeholder="https://www.amevista.com/..." /></label><button class="secondary" type="submit">+ Adicionar por URL</button></form></div><div class="modal-actions"><button id="save-image-order" class="primary">Guardar ordem e publicar</button></div></dialog>
  <dialog id="user-dialog"><form id="user-form"><div class="modal-head"><h2 id="user-modal-title">Novo utilizador</h2><button id="close-user-modal" class="icon-button" type="button" aria-label="Fechar">×</button></div><div class="modal-body"><input id="user-id" type="hidden" /><div class="form-grid"><label class="field">Nome completo<input id="user-name" required autocomplete="name" /></label><label class="field">Nome de utilizador<input id="user-username" required autocomplete="username" /></label><label class="field wide">Email<input id="user-email" type="email" required autocomplete="email" /></label><label class="field">Função<select id="user-role"><option value="admin">Admin</option><option value="super_admin">Super admin</option></select></label><label class="field">Palavra-passe<span class="control"><input id="user-password" type="password" minlength="8" autocomplete="new-password" /><button id="toggle-user-password" class="icon-button" type="button" aria-label="Mostrar palavra-passe" aria-pressed="false"><svg class="eye" viewBox="0 0 24 24"><path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"/><circle cx="12" cy="12" r="2.8"/></svg><svg class="eye-off" viewBox="0 0 24 24"><path d="M3 3l18 18"/><path d="M10.6 6.2A9.8 9.8 0 0 1 12 6c6 0 9.5 6 9.5 6a15 15 0 0 1-2.5 3.2M6.2 6.3C3.8 8 2.5 12 2.5 12s3.5 6 9.5 6a9.5 9.5 0 0 0 3-.5"/></svg></button></span></label><span class="password-help wide">Mínimo de 8 caracteres. Ao editar, deixe vazio para manter a palavra-passe atual.</span></div></div><div class="modal-actions"><button id="delete-user" class="danger" type="button">Eliminar utilizador</button><button id="cancel-user" class="secondary" type="button">Cancelar</button><button id="save-user" class="primary" type="submit">Guardar utilizador</button></div></form></dialog>
  <dialog id="discount-dialog"><form id="discount-form"><div class="modal-head"><div><h2 id="discount-modal-title">Novo desconto</h2><small>Defina a regra e confirme o período antes de publicar.</small></div><button id="close-discount" class="icon-button" type="button">×</button></div><div class="modal-body"><input id="discount-id" type="hidden" /><div class="form-grid"><label class="field">Nome da campanha<input id="discount-name" required /></label><label class="field">Código<input id="discount-code" required autocomplete="off" /></label><label class="field">Tipo<select id="discount-type"><option value="percentage">Percentagem (%)</option><option value="fixed">Valor fixo (€)</option></select></label><label class="field">Valor do desconto<div class="affix-input"><input id="discount-value" type="number" min="0.01" step="0.01" required inputmode="decimal" /><span id="discount-value-symbol">%</span></div><small id="discount-value-help">Entre 0,01% e 100%.</small></label><label class="field">Início<input id="discount-start" type="datetime-local" required /><small>Por defeito, primeiro dia do mês atual.</small></label><label class="field">Fim<input id="discount-end" type="datetime-local" required /><small>Por defeito, último dia do mês atual.</small></label><label class="field wide">Descrição<textarea id="discount-description"></textarea></label><label class="switch-field wide"><input id="discount-active" type="checkbox" checked /> Campanha ativa</label></div></div><div class="modal-actions"><button id="delete-discount" class="danger" type="button">Eliminar</button><button id="cancel-discount" class="secondary" type="button">Cancelar</button><button class="primary" type="submit">Guardar desconto</button></div></form></dialog>
  <dialog id="content-dialog"><form id="content-form"><div class="modal-head"><h2 id="content-modal-title">Novo conteúdo</h2><button id="close-content" class="icon-button" type="button">×</button></div><div class="modal-body"><input id="content-id" type="hidden" /><div class="form-grid"><label class="field">Caminho da página<input id="content-path" placeholder="/ ou /precos/" required /></label><label class="field">Nome da secção<input id="content-key" placeholder="hero-titulo" required /></label><label class="field wide">Seletor CSS<input id="content-selector" placeholder=".qodef-m-title" required /></label><label class="field">Tipo de alteração<select id="content-property"><option value="text">Texto</option><option value="html">HTML</option><option value="src">Imagem (src)</option><option value="href">Ligação (href)</option></select></label><label class="switch-field"><input id="content-active" type="checkbox" checked /> Conteúdo ativo</label><label class="field wide">Valor<textarea id="content-value" required></textarea></label></div></div><div class="modal-actions"><button id="delete-content" class="danger" type="button">Eliminar</button><button id="cancel-content" class="secondary" type="button">Cancelar</button><button class="primary" type="submit">Guardar conteúdo</button></div></form></dialog>
  <div id="toast" class="toast" hidden></div>

  <script>
    import { supabase } from '../../lib/supabase'
    const $ = (selector) => document.querySelector(selector)
    const state = { products: [], filtered: [], selected: new Set(), users:[], discounts:[], content:[], images:[], view:'all', page:1, pageSize:50, schemaReady:true, editing:null, editingMedia:null, editingUser:null, editingDiscount:null, editingContent:null, role:'admin' }
    const workspaceTitles={dashboard:'Painel de administração',all:'Catálogo de produtos',categories:'Categorias',inactive:'Produtos inativos',trash:'Lixo e recuperação',stock:'Gestão de stock',low:'Stock reduzido',out:'Produtos sem stock',media:'Imagens e ordem',discounts:'Descontos e promoções',content:'Conteúdo das páginas',users:'Utilizadores e acessos'}
    document.addEventListener('click',event=>{const button=event.target.closest?.('.nav-link');if(button)$('#workspace-title').textContent=workspaceTitles[button.dataset.view]||button.textContent.trim()},true)
    const money = new Intl.NumberFormat('pt-PT',{style:'currency',currency:'EUR'})
    const loginShell=$('#login-shell'), app=$('#app'), loginForm=$('#login-form'), loginMessage=$('#login-message'), tbody=$('#products')
    function notify(text,error=false){const toast=$('#toast');toast.textContent=text;toast.classList.toggle('error',error);toast.hidden=false;clearTimeout(notify.timer);notify.timer=setTimeout(()=>toast.hidden=true,3500)}
    async function requireAdmin(session){if(!session?.user)return false;let{data,error}=await supabase.from('profiles').select('is_admin,role').eq('id',session.user.id).single();if(error&&/role/i.test(error.message)){({data,error}=await supabase.from('profiles').select('is_admin').eq('id',session.user.id).single())}if(error||!data?.is_admin){await supabase.auth.signOut();loginMessage.textContent='Esta conta não tem acesso administrativo.';return false}const bootstrapOwner=session.user.email?.toLowerCase()==='admin@atelieotico.pt';state.role=data.role==='super_admin'||bootstrapOwner?'super_admin':'admin';$('#users-group').hidden=state.role!=='super_admin';$('#identity').textContent=`${session.user.email||''} · ${state.role==='super_admin'?'Super admin':'Admin'}`;return true}
    async function showSession(session){const allowed=await requireAdmin(session);loginShell.hidden=allowed;app.hidden=!allowed;if(allowed)await loadProducts()}
