    function exportCsv(){const headers=['SKU','Nome','Slug','Categoria','Descrição','Stock','Limite stock','Custo','PVP','Ativo'];const rows=state.filtered.map(p=>[p.sku,p.name,p.slug,p.category,p.description,p.stock_quantity,p.low_stock_threshold,p.cost_price,p.pvp,p.is_active]);const csv=[headers,...rows].map(row=>row.map(v=>`"${String(v??'').replaceAll('"','""')}"`).join(';')).join('\n');const blob=new Blob(['\ufeff'+csv],{type:'text/csv;charset=utf-8'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download=`stock-atelie-${new Date().toISOString().slice(0,10)}.csv`;a.click();URL.revokeObjectURL(url)}
