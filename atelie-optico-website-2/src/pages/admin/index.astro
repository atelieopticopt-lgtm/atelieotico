    $('#user-form').addEventListener('submit',async e=>{e.preventDefault();const button=$('#save-user');button.disabled=true;try{const payload={id:$('#user-id').value||undefined,email:$('#user-email').value.trim(),username:$('#user-username').value.trim(),full_name:$('#user-name').value.trim(),role:$('#user-role').value,password:$('#user-password').value||undefined};await manageUsers(state.editingUser?'update':'create',payload);$('#user-dialog').close();await loadUsers();notify('Utilizador guardado com sucesso.')}catch(error){notify(error.message,true)}finally{button.disabled=false}})
    $('#delete-user').addEventListener('click',async()=>{if(!state.editingUser||!confirm('Eliminar este utilizador e revogar imediatamente o seu acesso?'))return;try{await manageUsers('delete',{id:state.editingUser.id});$('#user-dialog').close();await loadUsers();notify('Utilizador eliminado.')}catch(error){notify(error.message,true)}})
    $('#toggle-user-password').addEventListener('click',e=>{const input=$('#user-password'),visible=input.type==='text';input.type=visible?'password':'text';e.currentTarget.classList.toggle('is-visible',!visible);e.currentTarget.setAttribute('aria-pressed',String(!visible));e.currentTarget.setAttribute('aria-label',visible?'Mostrar palavra-passe':'Ocultar palavra-passe')})
    async function loadDiscounts(){const{data,error}=await supabase.from('discounts').select('*').order('created_at',{ascending:false});if(error){notify(error.message,true);return}state.discounts=data||[];const body=$('#discounts-list');body.replaceChildren(...state.discounts.map(item=>{const row=document.createElement('tr'),period=[item.starts_at&&new Date(item.starts_at).toLocaleDateString('pt-PT'),item.ends_at&&new Date(item.ends_at).toLocaleDateString('pt-PT')].filter(Boolean).join(' — ')||'Sem limite';row.innerHTML='<td></td><td></td><td class="money"></td><td></td><td><span class="badge"></span></td><td><div class="row-actions"><button class="secondary">Editar</button></div></td>';row.children[0].textContent=item.name;row.children[1].textContent=item.code;row.children[2].textContent=item.discount_type==='percentage'?`${item.value}%`:money.format(item.value);row.children[3].textContent=period;const badge=row.querySelector('.badge');badge.textContent=item.is_active?'Ativo':'Inativo';badge.classList.add(item.is_active?'ok':'off');row.querySelector('button').addEventListener('click',()=>openDiscount(item));return row}));$('#discounts-empty').hidden=state.discounts.length>0}
    function localDate(value){if(!value)return'';const date=new Date(value),offset=date.getTimezoneOffset();return new Date(date.getTime()-offset*60000).toISOString().slice(0,16)}
    function currentMonthRange(){const now=new Date(),start=new Date(now.getFullYear(),now.getMonth(),1,0,0),end=new Date(now.getFullYear(),now.getMonth()+1,0,23,59);return{start:localDate(start),end:localDate(end)}}
    function syncDiscountType(){const percentage=$('#discount-type').value==='percentage',input=$('#discount-value');$('#discount-value-symbol').textContent=percentage?'%':'€';$('#discount-value-help').textContent=percentage?'Entre 0,01% e 100%.':'Valor em euros; nunca pode ser negativo.';if(percentage)input.max='100';else input.removeAttribute('max')}
    function openDiscount(item=null){const month=currentMonthRange();state.editingDiscount=item;$('#discount-modal-title').textContent=item?'Editar desconto':'Novo desconto';$('#discount-id').value=item?.id||'';$('#discount-name').value=item?.name||'';$('#discount-code').value=item?.code||'';$('#discount-type').value=item?.discount_type||'percentage';$('#discount-value').value=item?.value??'';$('#discount-start').value=item?.starts_at?localDate(item.starts_at):month.start;$('#discount-end').value=item?.ends_at?localDate(item.ends_at):month.end;$('#discount-description').value=item?.description||'';$('#discount-active').checked=item?.is_active!==false;$('#delete-discount').hidden=!item;syncDiscountType();$('#discount-dialog').showModal()}
    $('#discount-type').addEventListener('change',syncDiscountType)
    $('#discount-form').addEventListener('submit',async e=>{e.preventDefault();const type=$('#discount-type').value,value=Number($('#discount-value').value),start=new Date($('#discount-start').value),end=new Date($('#discount-end').value);if(!Number.isFinite(value)||value<=0)return notify('O valor do desconto tem de ser superior a zero.',true);if(type==='percentage'&&value>100)return notify('Uma percentagem de desconto não pode ultrapassar 100%.',true);if(Number.isNaN(start.getTime())||Number.isNaN(end.getTime()))return notify('Indique as datas de início e fim.',true);if(end<start)return notify('A data de fim tem de ser posterior à data de início.',true);const record={name:$('#discount-name').value.trim(),code:$('#discount-code').value.trim().toUpperCase(),discount_type:type,value,starts_at:start.toISOString(),ends_at:end.toISOString(),description:$('#discount-description').value.trim()||null,is_active:$('#discount-active').checked};const query=state.editingDiscount?supabase.from('discounts').update(record).eq('id',state.editingDiscount.id):supabase.from('discounts').insert(record);const{error}=await query;if(error){notify(error.message,true);return}$('#discount-dialog').close();await loadDiscounts();notify(`Desconto de ${type==='percentage'?`${value}%`:`${value.toLocaleString('pt-PT',{style:'currency',currency:'EUR'})}`} guardado com sucesso.`)})
    $('#delete-discount').addEventListener('click',async()=>{if(!state.editingDiscount||!confirm('Eliminar este desconto?'))return;const{error}=await supabase.from('discounts').delete().eq('id',state.editingDiscount.id);if(error){notify(error.message,true);return}$('#discount-dialog').close();await loadDiscounts();notify('Desconto eliminado.')})
    async function loadContent(){const{data,error}=await supabase.from('page_content').select('*').order('page_path').order('section_key');if(error){notify(error.message,true);return}state.content=data||[];const body=$('#content-list');body.replaceChildren(...state.content.map(item=>{const row=document.createElement('tr');row.innerHTML='<td><strong></strong><small class="product-desc"></small></td><td></td><td></td><td><span class="content-preview"></span></td><td><span class="badge"></span></td><td><div class="row-actions"><button class="secondary">Editar</button></div></td>';row.querySelector('strong').textContent=item.section_key;row.querySelector('small').textContent=item.page_path;row.children[1].textContent=item.selector;row.children[2].textContent={text:'Texto',html:'HTML',src:'Imagem',href:'Ligação'}[item.property]||item.property;row.querySelector('.content-preview').textContent=item.value;const badge=row.querySelector('.badge');badge.textContent=item.is_active?'Ativo':'Inativo';badge.classList.add(item.is_active?'ok':'off');row.querySelector('button').addEventListener('click',()=>openContent(item));return row}));$('#content-empty').hidden=state.content.length>0}
    function openContent(item=null){state.editingContent=item;$('#content-modal-title').textContent=item?'Editar conteúdo':'Novo conteúdo';$('#content-id').value=item?.id||'';$('#content-path').value=item?.page_path||'/';$('#content-key').value=item?.section_key||'';$('#content-selector').value=item?.selector||'';$('#content-property').value=item?.property||'text';$('#content-value').value=item?.value||'';$('#content-active').checked=item?.is_active!==false;$('#delete-content').hidden=!item;$('#content-dialog').showModal()}
    $('#content-form').addEventListener('submit',async e=>{e.preventDefault();let path=$('#content-path').value.trim();if(!path.startsWith('/'))path='/'+path;if(path!=='/'&&!path.endsWith('/'))path+='/';const record={page_path:path,section_key:$('#content-key').value.trim(),selector:$('#content-selector').value.trim(),property:$('#content-property').value,value:$('#content-value').value,is_active:$('#content-active').checked};const query=state.editingContent?supabase.from('page_content').update(record).eq('id',state.editingContent.id):supabase.from('page_content').insert(record);const{error}=await query;if(error){notify(error.message,true);return}$('#content-dialog').close();await loadContent();notify('Conteúdo guardado e publicado.')})
    $('#delete-content').addEventListener('click',async()=>{if(!state.editingContent||!confirm('Eliminar este conteúdo?'))return;const{error}=await supabase.from('page_content').delete().eq('id',state.editingContent.id);if(error){notify(error.message,true);return}$('#content-dialog').close();await loadContent();notify('Conteúdo eliminado.')})
    document.querySelectorAll('.nav-link').forEach(button=>button.addEventListener('click',async()=>{document.querySelectorAll('.nav-link').forEach(b=>b.classList.remove('active'));button.classList.add('active');state.view=button.dataset.view;const special=['users','media','discounts','content'].includes(state.view);$('#products-panel').hidden=special;$('#media-panel').hidden=state.view!=='media';$('#users-panel').hidden=state.view!=='users';$('#discounts-panel').hidden=state.view!=='discounts';$('#content-panel').hidden=state.view!=='content';$('.stats').hidden=special;if(state.view==='users')await loadUsers();else if(state.view==='media')await loadMediaProducts();else if(state.view==='discounts')await loadDiscounts();else if(state.view==='content')await loadContent();else{$('#view-title').textContent=button.textContent.trim();state.page=1;applyFilters()}$('#sidebar').classList.remove('open')}));$('#search').addEventListener('input',applyFilters);$('#category-filter').addEventListener('change',applyFilters);$('#reload').addEventListener('click',loadProducts);$('#add-product').addEventListener('click',()=>openEditor());$('#export').addEventListener('click',exportCsv);$('#prev-page').addEventListener('click',()=>{state.page--;render()});$('#next-page').addEventListener('click',()=>{state.page++;render()});$('#close-modal').addEventListener('click',()=>$('#product-dialog').close());$('#cancel-modal').addEventListener('click',()=>$('#product-dialog').close());$('#edit-product-images').addEventListener('click',()=>{const product=state.editing;$('#product-dialog').close();if(product)openMedia(product)});$('#close-media').addEventListener('click',()=>$('#media-dialog').close());$('#save-image-order').addEventListener('click',saveImageOrder);$('#save-product-order').addEventListener('click',saveProductOrder);$('#add-user').addEventListener('click',()=>openUserEditor());$('#close-user-modal').addEventListener('click',()=>$('#user-dialog').close());$('#cancel-user').addEventListener('click',()=>$('#user-dialog').close());$('#add-discount').addEventListener('click',()=>openDiscount());$('#close-discount').addEventListener('click',()=>$('#discount-dialog').close());$('#cancel-discount').addEventListener('click',()=>$('#discount-dialog').close());$('#add-content').addEventListener('click',()=>openContent());$('#close-content').addEventListener('click',()=>$('#content-dialog').close());$('#cancel-content').addEventListener('click',()=>$('#content-dialog').close());$('#mobile-menu').addEventListener('click',()=>$('#sidebar').classList.toggle('open'))
    const{data:{session}}=await supabase.auth.getSession();await showSession(session)
  </script>
</body>
</html>
