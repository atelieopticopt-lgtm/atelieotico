    async function uploadProductImage(file,replacing=null){if(!state.editingMedia)return;if(!['image/jpeg','image/png','image/webp'].includes(file.type))throw new Error('Use uma imagem JPG, PNG ou WebP.');if(file.size>5*1024*1024)throw new Error('Cada imagem pode ter no máximo 5 MB.');const extension=(file.name.split('.').pop()||'jpg').toLowerCase().replace(/[^a-z0-9]/g,'');const path=`${state.editingMedia.id}/${crypto.randomUUID()}.${extension}`;const{error:uploadError}=await supabase.storage.from('product-images').upload(path,file,{cacheControl:'3600',contentType:file.type,upsert:false});if(uploadError)throw uploadError;const{data}=supabase.storage.from('product-images').getPublicUrl(path);if(replacing){const{error}=await supabase.from('product_images').update({image_url:data.publicUrl,alt_text:replacing.alt_text||state.editingMedia.name,source_url:null}).eq('id',replacing.id);if(error){await supabase.storage.from('product-images').remove([path]);throw error}await removeStoredImage(replacing.image_url)}else{const position=state.images.filter(i=>i.product_id===state.editingMedia.id).length;const{error}=await supabase.from('product_images').insert({product_id:state.editingMedia.id,image_url:data.publicUrl,alt_text:state.editingMedia.name,source_url:null,position});if(error){await supabase.storage.from('product-images').remove([path]);throw error}}}
