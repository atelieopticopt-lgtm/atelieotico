    function renderImageList(){const list=$('#image-list'),images=state.images.filter(i=>i.product_id===state.editingMedia.id).sort((a,b)=>a.position-b.position);list.replaceChildren(...images.map((im,index)=>{const row=document.createElement('div');row.className='image-row';row.dataset.id=im.id;row.innerHTML=`<span class="image-position"></span><button class="drag-handle" type="button" draggable="true" aria-label="Arrastar imagem">⋮⋮</button><img alt=""><div class="image-meta"><strong></strong><small></small></div><div class="image-actions"><label class="replace-file">Substituir<input type="file" accept="image/jpeg,image/png,image/webp"></label><button class="danger" type="button">Eliminar</button></div>`;const handle=row.querySelector('.drag-handle'),replacement=row.querySelector('input[type=file]');row.querySelector('.image-position').textContent=index===0?'1 · Capa':String(index+1);row.querySelector('img').src=im.image_url;row.querySelector('img').alt=im.alt_text||state.editingMedia.name;row.querySelector('strong').textContent=index===0?'Imagem principal':`Imagem ${index+1}`;row.querySelector('small').textContent=im.alt_text||state.editingMedia.name;replacement.addEventListener('change',async()=>{const file=replacement.files?.[0];if(!file)return;try{notify('A substituir imagem…');await uploadProductImage(file,im);await refreshImages();notify('Imagem substituída e publicada.')}catch(error){notify(error.message||'Não foi possível substituir a imagem.',true)}replacement.value=''});row.querySelector('.danger').onclick=async()=>{if(!confirm('Eliminar esta imagem do carrossel?'))return;const{error}=await supabase.from('product_images').delete().eq('id',im.id);if(error)return notify(error.message,true);await removeStoredImage(im.image_url);state.images=state.images.filter(x=>x.id!==im.id);await saveImageOrder();notify('Imagem eliminada.')};handle.addEventListener('dragstart',()=>row.classList.add('dragging'));handle.addEventListener('dragend',()=>row.classList.remove('