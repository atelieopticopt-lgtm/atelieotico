    .users-panel{display:grid;gap:0}.users-grid{padding:20px}.users-table{width:100%;min-width:850px;table-layout:auto;border:1px solid #e3e7ed;border-radius:10px;border-collapse:separate;border-spacing:0;overflow:hidden}.users-table th{background:#f8f9fb;color:#718096}.users-table th:nth-child(n),.management-table th:nth-child(n){width:auto}.users-table td{height:70px}.users-table tr:last-child td{border-bottom:0}.users-table .you{color:#3488e8;font-size:12px;font-weight:700}.avatar{display:grid;place-items:center;width:38px;height:38px;border-radius:50%;background:linear-gradient(135deg,var(--gold),var(--gold-dark));color:#fff;font-weight:800}.user-identity{display:flex;align-items:center;gap:12px}.user-identity strong{display:block}.user-identity small{display:block;margin-top:3px;color:var(--muted)}.role-pill{display:inline-flex;padding:6px 11px;border-radius:99px;background:#fff4b8;color:#77530d;font-size:12px;font-weight:800}.role-pill.admin{background:#e9edf3;color:#536174}.user-actions{display:flex;gap:8px}.user-actions .danger{min-height:36px;padding:7px 11px}.management-table{min-width:980px;table-layout:auto}.management-table td{height:66px}.management-table td:nth-last-child(1){overflow:visible}.content-preview{display:block;max-width:330px;overflow:hidden;color:var(--muted);text-overflow:ellipsis;white-space:nowrap}.permission-note{margin:0 20px 20px;padding:13px 15px;border-radius:9px;background:#f8f3ec;color:#735b42;font-size:13px}.password-help{font-size:12px;color:var(--muted)}
