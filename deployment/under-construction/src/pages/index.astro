<!doctype html>
<html lang="pt-PT">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Ateliê Ótico — Em desenvolvimento</title>
    <style>
      * { box-sizing: border-box; }
      html, body { width: 100%; min-height: 100%; margin: 0; }
      body {
        min-height: 100svh;
        display: grid;
        place-items: center;
        padding: 32px;
        background: #fff;
        color: #0a0a0a;
        font-family: Arial, Helvetica, sans-serif;
      }
      main {
        width: min(680px, 88vw);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
      }
      .logo {
        display: block;
        position: relative;
        width: min(560px, 86vw);
        aspect-ratio: 1881 / 836;
        background: linear-gradient(to right, #000 0 84%, #bd854c 84% 100%);
        -webkit-mask: url("/logo.png") center / contain no-repeat;
        mask: url("/logo.png") center / contain no-repeat;
      }
      .logo::after {
        content: "";
        position: absolute;
        inset: 72% 0 0;
        background: #bd854c;
      }
      p {
        margin: 30px 0 0;
        font-size: clamp(18px, 2vw, 25px);
        font-weight: 400;
        letter-spacing: .04em;
      }
      @media (max-width: 520px) {
        body { padding: 22px; }
        .logo { width: min(390px, 90vw); }
        p { margin-top: 24px; }
      }
    </style>
  </head>
  <body>
    <main>
      <div class="logo" role="img" aria-label="Ateliê Ótico"></div>
      <p>Em desenvolvimento...</p>
    </main>
  </body>
</html>
